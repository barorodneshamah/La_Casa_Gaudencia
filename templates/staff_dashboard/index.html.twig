{% block javascripts %}
{{ parent() }}
<script>
window.noGlobalBell = true;
document.addEventListener('DOMContentLoaded', function() {
    function updateDateTime() {
        const now = new Date();
        document.getElementById('currentTime').textContent = now.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', hour12: true });
        document.getElementById('currentDate').textContent = now.toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric' });
        document.getElementById('welcomeDay').textContent = now.getDate().toString().padStart(2, '0');
        document.getElementById('welcomeMonthYear').textContent = now.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
    }
    updateDateTime();
    setInterval(updateDateTime, 1000);

    document.getElementById('profileForm').addEventListener('submit', function(e) {
        e.preventDefault();
        saveProfile();
    });

    document.getElementById('passwordForm').addEventListener('submit', function(e) {
        e.preventDefault();
        changePassword();
    });

    document.getElementById('profileModal').addEventListener('click', function(e) {
        if (e.target === this) closeProfileModal();
    });

    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
            closeProfileModal();
            closeSidebar();
        }
    });

    // close mobile sidebar after clicking a link
    document.querySelectorAll('.sidebar a').forEach(a => {
        a.addEventListener('click', () => closeSidebar());
    });

    initReveal();
    initCountUp();
});

function toggleSidebar(){
  const sidebar = document.querySelector('.sidebar');
  const accent = document.querySelector('.sidebar-accent');
  const overlay = document.getElementById('mobileOverlay');

  sidebar.classList.toggle('open');
  accent.classList.toggle('open');
  overlay.classList.toggle('show');
}

function closeSidebar(){
  const sidebar = document.querySelector('.sidebar');
  const accent = document.querySelector('.sidebar-accent');
  const overlay = document.getElementById('mobileOverlay');

  sidebar.classList.remove('open');
  accent.classList.remove('open');
  overlay.classList.remove('show');
}

function openProfileModal() {
    document.getElementById('profileModal').classList.add('active');
    document.body.style.overflow = 'hidden';
}

function closeProfileModal() {
    document.getElementById('profileModal').classList.remove('active');
    document.body.style.overflow = '';
    document.getElementById('passwordForm').reset();
}

function switchTab(tab, btn) {
    document.querySelectorAll('.modal-tab').forEach(t => t.classList.remove('active'));
    btn.classList.add('active');
    document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
    document.getElementById('tab-' + tab).classList.add('active');
}

function togglePassword(id) {
    const input = document.getElementById(id);
    const icon = input.nextElementSibling.querySelector('i');
    if (input.type === 'password') {
        input.type = 'text';
        icon.classList.replace('fa-eye', 'fa-eye-slash');
    } else {
        input.type = 'password';
        icon.classList.replace('fa-eye-slash', 'fa-eye');
    }
}

function saveProfile() {
    const btn = document.getElementById('saveProfileBtn');
    const fullName = document.getElementById('fullName').value.trim();
    const username = document.getElementById('username').value.trim();
    const email = document.getElementById('email').value.trim();

    if (!fullName || !username || !email) {
        showToast('error', 'All fields are required');
        return;
    }

    btn.classList.add('loading');
    btn.disabled = true;

    fetch('{{ path("app_staff_profile_update") }}', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ fullName, username, email })
    })
    .then(response => response.json())
    .then(result => {
        btn.classList.remove('loading');
        btn.disabled = false;

        if (result.success) {
            document.getElementById('topbarAvatar').textContent = result.user.initials;
            document.getElementById('topbarName').textContent = result.user.fullName;
            document.getElementById('modalAvatar').textContent = result.user.initials;
            document.getElementById('modalName').textContent = result.user.fullName;
            document.getElementById('welcomeText').textContent = 'Welcome back, ' + result.user.fullName.split(' ')[0] + '!';

            showToast('success', result.message);
            closeProfileModal();
        } else {
            showToast('error', result.message);
        }
    })
    .catch(() => {
        btn.classList.remove('loading');
        btn.disabled = false;
        showToast('error', 'An error occurred');
    });
}

function changePassword() {
    const btn = document.getElementById('changePasswordBtn');
    const currentPassword = document.getElementById('currentPassword').value;
    const newPassword = document.getElementById('newPassword').value;
    const confirmPassword = document.getElementById('confirmPassword').value;

    if (!currentPassword || !newPassword || !confirmPassword) {
        showToast('error', 'All fields are required');
        return;
    }
    if (newPassword.length < 6) {
        showToast('error', 'Password must be at least 6 characters');
        return;
    }
    if (newPassword !== confirmPassword) {
        showToast('error', 'Passwords do not match');
        return;
    }

    btn.classList.add('loading');
    btn.disabled = true;

    // NOTE: Make sure this route exists in your Symfony app:
    fetch('{{ path("app_staff_change_password") }}', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ currentPassword, newPassword })
    })
    .then(response => response.json())
    .then(result => {
        btn.classList.remove('loading');
        btn.disabled = false;

        if (result.success) {
            showToast('success', result.message);
            document.getElementById('passwordForm').reset();
            closeProfileModal();
        } else {
            showToast('error', result.message);
        }
    })
    .catch(() => {
        btn.classList.remove('loading');
        btn.disabled = false;
        showToast('error', 'An error occurred');
    });
}

function showToast(type, message) {
    const toast = document.getElementById('toast');

    toast.classList.remove('show');
    void toast.offsetWidth;

    toast.className = 'toast ' + type;
    toast.querySelector('i').className = type === 'success'
        ? 'fas fa-check-circle'
        : 'fas fa-exclamation-circle';
    toast.querySelector('.toast-message').textContent = message;

    toast.classList.add('show');
    setTimeout(() => toast.classList.remove('show'), 4000);
}

function initReveal() {
    const targets = document.querySelectorAll(
        '.welcome-section, .section-header, .sales-card, .stat-card, .action-btn'
    );

    targets.forEach((el, i) => {
        el.classList.add('reveal');
        el.style.setProperty('--d', `${Math.min(i * 55, 420)}ms`);
    });

    const io = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
            if (entry.isIntersecting) {
                entry.target.classList.add('in-view');
                io.unobserve(entry.target);
            }
        });
    }, { threshold: 0.12 });

    targets.forEach(el => io.observe(el));
}

function initCountUp() {
    const els = document.querySelectorAll('.count[data-count]');
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReduced) return;

    function animate(el) {
        const to = Number(el.dataset.count || 0);
        const decimals = Number(el.dataset.decimals || 0);

        const duration = 900;
        const start = performance.now();
        const from = 0;

        function tick(now) {
            const t = Math.min(1, (now - start) / duration);
            const eased = 1 - Math.pow(1 - t, 3);
            const value = from + (to - from) * eased;

            el.textContent = value.toLocaleString('en-US', {
                minimumFractionDigits: decimals,
                maximumFractionDigits: decimals
            });

            if (t < 1) requestAnimationFrame(tick);
        }

        requestAnimationFrame(tick);
    }

    const io = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
            if (entry.isIntersecting) {
                animate(entry.target);
                io.unobserve(entry.target);
            }
        });
    }, { threshold: 0.35 });

    els.forEach(el => io.observe(el));
}

// ── Notification bell ─────────────────────────────────────────────
function refreshBell() {
    fetch('/dashboard/api/unread-count', { credentials: 'same-origin' })
        .then(r => r.ok ? r.json() : null)
        .then(data => {
            if (!data) return;
            const btn   = document.querySelector('.bell-btn');
            let   badge = document.querySelector('.bell-badge');
            if (data.count > 0) {
                const label = data.count > 9 ? '9+' : data.count;
                if (badge) { badge.textContent = label; }
                else if (btn) {
                    badge = document.createElement('span');
                    badge.className = 'bell-badge';
                    badge.textContent = label;
                    btn.appendChild(badge);
                }
            } else if (badge) {
                badge.remove();
            }
        })
        .catch(() => {});
}
refreshBell();
setInterval(refreshBell, 8000); // keep the message badge live

// ── Dashboard notification polling (always-on fallback) ───────────
(function () {
    const KEY_TS   = 'adminNotifLastChecked';
    const KEY_SEEN = 'adminNotifSeenIds';
    let lastTs = parseInt(localStorage.getItem(KEY_TS) || '0', 10) || Math.floor(Date.now() / 1000);
    let seen   = new Set(JSON.parse(localStorage.getItem(KEY_SEEN) || '[]'));

    const COLORS = { reservation: '#7b1fa2', payment: '#2e7d32', message: '#1565c0' };
    const ICONS  = { reservation: 'fa-calendar-check', payment: 'fa-money-bill-wave', message: 'fa-envelope' };

    let newEventCount = 0;

    function updateDashBadge() {
        const btn = document.querySelector('.bell-btn');
        if (!btn) return;
        let badge = btn.querySelector('.bell-badge');
        if (newEventCount > 0) {
            if (!badge) { badge = document.createElement('span'); badge.className = 'bell-badge'; btn.appendChild(badge); }
            badge.textContent = newEventCount > 9 ? '9+' : String(newEventCount);
        } else if (badge) { badge.remove(); }
    }

    window.staffDashToast = function(title, body, url, type) {
        const color = COLORS[type] || '#c24a16';
        const icon  = ICONS[type]  || 'fa-bell';
        const t = document.createElement('div');
        t.style.cssText = 'position:fixed;bottom:24px;right:24px;z-index:99999;background:#1a1a1a;color:#fff;padding:14px 18px;border-radius:10px;box-shadow:0 4px 18px rgba(0,0,0,.35);max-width:320px;border-left:4px solid ' + color + ';transition:opacity .4s;';
        t.innerHTML = '<strong style="display:block;margin-bottom:4px;font-size:.95em;"><i class="fas ' + icon + '" style="margin-right:6px;color:' + color + ';"></i>' + title + '</strong><span style="font-size:.88em;opacity:.85;">' + body + '</span>';
        const a = document.createElement('a'); a.href = url; a.textContent = 'View';
        a.style.cssText = 'display:inline-block;margin-top:8px;background:' + color + ';color:#fff;padding:3px 12px;border-radius:6px;text-decoration:none;font-size:.82em;font-weight:700;';
        t.appendChild(a);
        const x = document.createElement('span'); x.textContent = '×'; x.onclick = () => t.remove();
        x.style.cssText = 'position:absolute;top:6px;right:10px;cursor:pointer;font-size:1.2em;opacity:.6;';
        t.appendChild(x); document.body.appendChild(t);
        newEventCount++; updateDashBadge();
        setTimeout(() => { t.style.opacity = '0'; setTimeout(() => t.remove(), 400); }, 12000);
    };

    async function poll() {
        try {
            const r = await fetch('/admin/notifications/pending?since=' + lastTs, { credentials: 'same-origin' });
            if (!r.ok) return;
            const d = await r.json();
            const fresh = (d.notifications || []).filter(n => !seen.has(n.type + ':' + n.id));
            if (fresh.length) {
                fresh.forEach(n => { window.staffDashToast(n.message, n.detail, n.url, n.type); seen.add(n.type + ':' + n.id); });
                let arr = [...seen]; if (arr.length > 300) arr = arr.slice(arr.length - 300);
                seen = new Set(arr); localStorage.setItem(KEY_SEEN, JSON.stringify(arr));
            }
            lastTs = d.checkedAt; localStorage.setItem(KEY_TS, String(lastTs));
        } catch {}
    }
    poll(); setInterval(poll, 8000);
})();

// ── Live Mercure updates (bonus real-time when hub is available) ───
(function () {
    fetch('/api/mercure/token')
        .then(r => r.ok ? r.json() : null)
        .then(data => {
            if (!data) return;
            const url = new URL(data.hubUrl);
            ['/topic/contact-messages', '/topic/reservations', '/topic/payments'].forEach(t => url.searchParams.append('topic', t));
            const es = new EventSource(url.toString(), { headers: { Authorization: 'Bearer ' + data.token } });
            es.onmessage = function (e) {
                try {
                    const payload = JSON.parse(e.data);
                    if (payload.event === 'new_inquiry') {
                        refreshBell();
                        if (window.staffDashToast) window.staffDashToast('New Inquiry', (payload.fullName || 'Guest') + ': ' + payload.subject, '/dashboard/messages', 'message');
                    } else if (payload.reservationCode) {
                        if (window.staffDashToast) window.staffDashToast('New Reservation', 'Reservation #' + payload.reservationCode + ' — ' + payload.serviceType, '/dashboard/reservations', 'reservation');
                    } else if (payload.transactionRef && payload.status === 'PENDING') {
                        if (window.staffDashToast) window.staffDashToast('New Payment', 'Transaction: ' + payload.transactionRef + ' — ₱' + Number(payload.amount).toLocaleString(), '/payments/pending', 'payment');
                    }
                } catch {}
            };
        })
        .catch(() => {});

    function showAdminToast(title, body, link) {
        const t = document.createElement('div');
        t.style.cssText = 'position:fixed;top:20px;right:20px;z-index:9999;background:#1a1a1a;color:#fff;padding:14px 18px;border-radius:10px;box-shadow:0 4px 18px rgba(0,0,0,.25);max-width:320px;font-family:Roboto,sans-serif;border-left:4px solid #c24a16;';
        t.innerHTML = '<strong style="display:block;margin-bottom:4px">' + title + '</strong><span style="font-size:.9em;opacity:.85">' + body + '</span>';
        const btn = document.createElement('a');
        btn.href = link; btn.textContent = 'View';
        btn.style.cssText = 'display:inline-block;margin-top:8px;background:#c24a16;color:#fff;padding:4px 14px;border-radius:6px;text-decoration:none;font-size:.85em;font-weight:600;';
        t.appendChild(btn);
        const close = document.createElement('span');
        close.textContent = '×';
        close.style.cssText = 'position:absolute;top:8px;right:12px;cursor:pointer;font-size:1.2em;opacity:.7;';
        close.onclick = () => t.remove();
        t.style.position = 'fixed'; t.appendChild(close);
        document.body.appendChild(t);
        setTimeout(() => t.remove(), 15000);
    }
})();

</script>
