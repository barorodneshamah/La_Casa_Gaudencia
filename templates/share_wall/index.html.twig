    </ul>

    <div class="sidebar-logout">
        <a href="{{ path('app_logout') }}" class="logout-btn">Log Out</a>
    </div>
</div>

<!-- TOPBAR -->
<div class="topbar">
    <div class="topbar-left">Share Wall</div>
    <div class="topbar-right">
        {% block global_notifications %}
        {% include 'components/_admin_notifications.html.twig' %}
        {% include 'components/_customer_notifications.html.twig' %}
        {% endblock %}
        <div class="datetime-display">
            <div class="time" id="currentTime">00:00 AM</div>
            <div class="date" id="currentDate">Loading...</div>
        </div>
    </div>
</div>

<!-- MAIN CONTENT -->
<div class="main-content">

    {% for msg in app.flashes('success') %}
        <div class="alert alert-success"><i class="fas fa-check-circle"></i> {{ msg }}</div>
    {% endfor %}
    {% for msg in app.flashes('error') %}
        <div class="alert alert-danger"><i class="fas fa-exclamation-circle"></i> {{ msg }}</div>
    {% endfor %}

    <!-- WELCOME -->
    <div class="welcome-section">
        <div class="welcome-text">
            <h2>Share Wall Management</h2>
            <p>Moderate community posts from guests and travelers. Pin highlights, hide inappropriate content, and keep the wall fresh.</p>
        </div>
        <div class="welcome-stats">
            {% set published = posts|filter(p => p.status == 'published')|length %}
            {% set hidden = posts|filter(p => p.status == 'hidden')|length %}
            {% set pinned = posts|filter(p => p.isPinned)|length %}
            <div class="welcome-stat">
                <div class="number">{{ published }}</div>
                <div class="label">Published</div>
            </div>
            <div class="welcome-stat" style="background: linear-gradient(135deg,#6c757d,#495057)">
                <div class="number">{{ hidden }}</div>
                <div class="label">Hidden</div>
            </div>
            <div class="welcome-stat" style="background: linear-gradient(135deg,#f57f17,#ffb300)">
                <div class="number">{{ pinned }}</div>
                <div class="label">Pinned</div>
            </div>
        </div>
    </div>

    <!-- SECTION HEADER + FILTERS -->
    <div class="section-header">
        <h3 class="section-title"><i class="fas fa-stream"></i> Community Posts</h3>
        <span style="font-size:14px; color: var(--brand-text-muted);">{{ posts|length }} total post{{ posts|length != 1 ? 's' : '' }}</span>
    </div>

    <div class="filter-tabs">
        <button class="filter-tab active" data-filter="all">All</button>
        <button class="filter-tab" data-filter="published"><i class="fas fa-eye"></i> Published</button>
        <button class="filter-tab" data-filter="hidden"><i class="fas fa-eye-slash"></i> Hidden</button>
        <button class="filter-tab" data-filter="pinned"><i class="fas fa-thumbtack"></i> Pinned</button>
        <button class="filter-tab" data-filter="room">Rooms</button>
        <button class="filter-tab" data-filter="tour">Tours</button>
        <button class="filter-tab" data-filter="spa">Spa</button>
        <button class="filter-tab" data-filter="dining">Dining</button>
        <button class="filter-tab" data-filter="package">Packages</button>
    </div>

    <!-- POSTS GRID -->
    <div class="posts-grid" id="postsGrid">

        {% if posts is empty %}
        <div class="empty-state">
            <i class="fas fa-stream"></i>
            <h3>No posts yet</h3>
            <p>Community posts from the mobile app will appear here.</p>
        </div>
        {% endif %}

        {% for post in posts %}
        <div class="post-card {{ post.isPinned ? 'pinned' : '' }} {{ post.status == 'hidden' ? 'hidden-post' : '' }}"
             data-status="{{ post.status }}"
             data-pinned="{{ post.isPinned ? 'true' : 'false' }}"
             data-tag="{{ post.serviceTag ?? '' }}"
             id="post-{{ post.id }}">

            {% if post.imageUri %}
                <img class="post-image" src="{{ post.imageUri }}" alt="Post image" loading="lazy">
            {% else %}
                <div class="post-image-placeholder">
                    <i class="fas fa-image"></i>
                </div>
            {% endif %}

            <div class="post-body">
                <div class="post-author-row">
                    <div class="post-avatar">{{ post.author.fullName ? post.author.fullName|first|upper : post.author.username|first|upper }}</div>
                    <div>
                        <div class="post-author-name">{{ post.author.fullName ?: post.author.username }}</div>
                        <div class="post-author-time">{{ post.createdAt|date('M d, Y · H:i') }}</div>
                    </div>
                    <div class="post-badges">
                        {% if post.isPinned %}<span class="badge-pin"><i class="fas fa-thumbtack"></i> Pinned</span>{% endif %}
                        {% if post.status == 'hidden' %}<span class="badge-hidden"><i class="fas fa-eye-slash"></i> Hidden</span>{% endif %}
                    </div>
                </div>

                {% if post.serviceTag %}
                    <span class="service-tag">{{ post.serviceTag }}</span>
                {% endif %}

                <p class="post-caption">{{ post.caption }}</p>

                <div class="post-stats">
                    <span><i class="fas fa-heart"></i> {{ post.likedByIds|length }} like{{ post.likedByIds|length != 1 ? 's' : '' }}</span>
                    <span><i class="fas fa-comment"></i> {{ post.comments|length }} comment{{ post.comments|length != 1 ? 's' : '' }}</span>
                </div>

                <div class="post-actions">
                    <button class="btn-action btn-pin"
                            onclick="togglePin({{ post.id }}, this)">
                        <i class="fas fa-thumbtack"></i>
                        {{ post.isPinned ? 'Unpin' : 'Pin' }}
                    </button>
                    <button class="btn-action {{ post.status == 'published' ? 'btn-hide' : 'btn-show' }}"
                            onclick="toggleStatus({{ post.id }}, this)">
                        <i class="fas {{ post.status == 'published' ? 'fa-eye-slash' : 'fa-eye' }}"></i>
                        {{ post.status == 'published' ? 'Hide' : 'Show' }}
                    </button>
                    <button class="btn-action btn-delete"
                            onclick="confirmDelete({{ post.id }}, '{{ csrf_token('delete_wall_post_' ~ post.id) }}')">
                        <i class="fas fa-trash"></i> Delete
                    </button>
                </div>
            </div>
        </div>
        {% endfor %}

    </div>
</div>

<!-- DELETE MODAL -->
<div class="modal-overlay" id="deleteModal">
    <div class="modal-box">
        <h3><i class="fas fa-trash" style="color:#dc3545;margin-right:10px;"></i>Delete Post?</h3>
        <p>This will permanently remove the post and all its comments. This action cannot be undone.</p>
        <div class="modal-actions">
            <button class="btn-cancel" onclick="closeDeleteModal()">Cancel</button>
            <form id="deleteForm" method="POST">
                <input type="hidden" name="_token" id="deleteToken">
                <button type="submit" class="btn-confirm-delete"><i class="fas fa-trash"></i> Delete Post</button>
            </form>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
// Clock
function updateClock() {
    const now = new Date();
    const t = now.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' });
    const d = now.toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric' });
    const el = document.getElementById('currentTime');
    const dl = document.getElementById('currentDate');
    if (el) el.textContent = t;
    if (dl) dl.textContent = d;
}
updateClock();
setInterval(updateClock, 1000);

// Filter tabs
document.querySelectorAll('.filter-tab').forEach(btn => {
    btn.addEventListener('click', () => {
        document.querySelectorAll('.filter-tab').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        const filter = btn.dataset.filter;
        document.querySelectorAll('.post-card').forEach(card => {
            let show = true;
            if      (filter === 'published') show = card.dataset.status === 'published';
            else if (filter === 'hidden')    show = card.dataset.status === 'hidden';
            else if (filter === 'pinned')    show = card.dataset.pinned === 'true';
            else if (filter !== 'all')       show = card.dataset.tag === filter;
            card.style.display = show ? '' : 'none';
        });
    });
});

// Toggle pin
async function togglePin(id, btn) {
    const res = await fetch(`/dashboard/share-wall/${id}/toggle-pin`, { method: 'POST', headers: { 'X-Requested-With': 'XMLHttpRequest' } });
    if (!res.ok) return;
    const data = await res.json();
    const card = document.getElementById('post-' + id);
    card.dataset.pinned = data.isPinned ? 'true' : 'false';
    card.classList.toggle('pinned', data.isPinned);
    btn.innerHTML = `<i class="fas fa-thumbtack"></i> ${data.isPinned ? 'Unpin' : 'Pin'}`;
    const badges = card.querySelector('.post-badges');
    const pinBadge = badges.querySelector('.badge-pin');
    if (data.isPinned && !pinBadge) {
        badges.insertAdjacentHTML('afterbegin', '<span class="badge-pin"><i class="fas fa-thumbtack"></i> Pinned</span>');
    } else if (!data.isPinned && pinBadge) {
        pinBadge.remove();
    }
}

// Toggle hide/show
async function toggleStatus(id, btn) {
    const res = await fetch(`/dashboard/share-wall/${id}/toggle-status`, { method: 'POST', headers: { 'X-Requested-With': 'XMLHttpRequest' } });
    if (!res.ok) return;
    const data = await res.json();
    const card = document.getElementById('post-' + id);
    card.dataset.status = data.status;
    card.classList.toggle('hidden-post', data.status === 'hidden');
    if (data.status === 'published') {
        btn.className = 'btn-action btn-hide';
        btn.innerHTML = '<i class="fas fa-eye-slash"></i> Hide';
    } else {
        btn.className = 'btn-action btn-show';
        btn.innerHTML = '<i class="fas fa-eye"></i> Show';
    }
    const badges = card.querySelector('.post-badges');
    const hBadge = badges.querySelector('.badge-hidden');
    if (data.status === 'hidden' && !hBadge) {
        badges.insertAdjacentHTML('beforeend', '<span class="badge-hidden"><i class="fas fa-eye-slash"></i> Hidden</span>');
    } else if (data.status === 'published' && hBadge) {
        hBadge.remove();
    }
}

// Delete modal
function confirmDelete(id, token) {
    document.getElementById('deleteForm').action = `/dashboard/share-wall/${id}/delete`;
    document.getElementById('deleteToken').value = token;
    document.getElementById('deleteModal').classList.add('open');
}
function closeDeleteModal() {
    document.getElementById('deleteModal').classList.remove('open');
}
document.getElementById('deleteModal').addEventListener('click', e => {
    if (e.target === e.currentTarget) closeDeleteModal();
});
</script>
{% endblock %}
