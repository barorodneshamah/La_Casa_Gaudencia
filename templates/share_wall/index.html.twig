{% extends 'base.html.twig' %}

{% block title %}Share Wall Management{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&family=Roboto:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<style>
:root {
    --brand-primary: #c24a16;
    --brand-primary-light: #e85d04;
    --brand-text: #2f2f2f;
    --brand-text-muted: #888888;
}

* { margin: 0; padding: 0; box-sizing: border-box; }

body {
    font-family: 'Roboto', sans-serif;
    color: #2f2f2f;
    background-image:
        linear-gradient(rgba(255, 252, 236, 0.78), rgba(242, 236, 208, 0.78)),
        url('{{ asset("images/ground.jpeg") }}');
    background-repeat: no-repeat;
    background-position: center;
    background-size: cover;
    background-attachment: fixed;
}

/* ===== SIDEBAR ===== */
.sidebar-accent {
    position: fixed;
    top: 0; left: 0;
    width: 8px; height: 100vh;
    background-color: #c24a16;
    border-radius: 0 6px 6px 0;
    z-index: 30;
}

.sidebar {
    position: fixed;
    top: 0; left: 8px;
    width: 260px; height: 100vh;
    background: white;
    box-shadow: 0 8px 28px rgba(0,0,0,0.08);
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 28px;
    border-radius: 0 12px 12px 0;
    z-index: 20;
}

.brand { text-align: center; margin-bottom: 30px; }
.brand img { width: 75px; height: 75px; margin-bottom: 8px; }
.brand h1 { font-family: 'Playfair Display', serif; color: #c24a16; font-size: 22px; margin: 0; }
.brand small { color: #777; font-size: 12px; }

.sidebar-separator {
    width: 75%;
    height: 1.5px;
    background: linear-gradient(to right, transparent, #d1d1d1, transparent);
    margin: 10px 0 15px 0;
}

.sidebar ul { list-style: none; width: 100%; padding: 0; }
.sidebar ul li a {
    display: flex;
    gap: 14px;
    align-items: center;
    padding: 14px 35px;
    font-size: 15px;
    font-weight: 500;
    color: #2f2f2f;
    text-decoration: none;
    transition: all .25s ease;
}
.sidebar ul li svg { width: 20px; height: 20px; fill: #888; transition: .25s; }
.sidebar ul li a:hover,
.sidebar ul li.active a {
    background-color: #c24a16;
    color: white;
    margin-left: -12px;
    border-radius: 0 30px 30px 0;
    padding-left: 48px;
}
.sidebar ul li a:hover svg,
.sidebar ul li.active a svg { fill: white !important; }

.sidebar-logout {
    width: 100%;
    padding: 20px 30px;
    margin-top: auto;
    display: flex;
    justify-content: center;
    border-top: 1px solid #eee;
}
.logout-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 80%;
    padding: 14px 24px;
    background: linear-gradient(135deg, #c24a16 0%, #e85d04 100%);
    color: white;
    text-decoration: none;
    border-radius: 12px;
    font-size: 15px;
    font-weight: 600;
    transition: all 0.3s ease;
}
.logout-btn:hover { transform: translateY(-2px); }

/* ===== TOPBAR ===== */
@keyframes topbarShift {
  0%   { background-position: 0% 50%; }
  50%  { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}

.topbar {
    margin-left: 268px;
    height: 70px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 35px;
    color: white;
    position: sticky;
    top: 0;
    z-index: 10;
    background: linear-gradient(120deg, #c24a16 0%, #e85d04 45%, #c24a16 100%);
    background-size: 200% 200%;
    animation: topbarShift 10s cubic-bezier(.2,.8,.2,1) infinite;
}

.topbar-left { font-family: 'Playfair Display', serif; font-size: 24px; font-weight: 600; }
.topbar-right { display: flex; align-items: center; gap: 20px; }

.datetime-display {
    text-align: right;
    padding: 6px 14px;
    background: rgba(255,255,255,0.15);
    border-radius: 8px;
}
.datetime-display .time { font-size: 14px; font-weight: 600; }
.datetime-display .date { font-size: 10px; color: rgba(255,255,255,0.8); }

/* ===== MOBILE ===== */
.mobile-overlay { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 15; }
.mobile-overlay.active { display: block; }

/* ===== MAIN CONTENT ===== */
.main-content {
    margin-left: 268px;
    padding: 32px;
    min-height: calc(100vh - 70px);
}

/* ===== WELCOME SECTION ===== */
.welcome-section {
    background: linear-gradient(135deg, #fff 0%, #faf9f5 100%);
    border-radius: 16px;
    padding: 28px 32px;
    margin-bottom: 32px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border: 1px solid rgba(194,74,22,0.1);
}
.welcome-text h2 { font-family: 'Playfair Display', serif; font-size: 28px; color: var(--brand-text); margin-bottom: 8px; }
.welcome-text p { color: var(--brand-text-muted); font-size: 15px; margin: 0; }
.welcome-stats {
    display: flex;
    gap: 20px;
}
.welcome-stat {
    text-align: center;
    padding: 12px 20px;
    background: linear-gradient(135deg, #c24a16 0%, #e85d04 100%);
    border-radius: 12px;
    color: white;
}
.welcome-stat .number { font-size: 28px; font-weight: 700; line-height: 1; }
.welcome-stat .label { font-size: 11px; opacity: 0.85; margin-top: 2px; }

/* ===== SECTION HEADER ===== */
.section-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24px; }
.section-title {
    font-family: 'Playfair Display', serif;
    font-size: 22px;
    color: var(--brand-text);
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 10px;
}
.section-title i { color: var(--brand-primary); font-size: 20px; }

/* ===== FLASH ===== */
.alert {
    padding: 14px 20px;
    border-radius: 12px;
    margin-bottom: 20px;
    font-size: 14px;
    display: flex;
    align-items: center;
    gap: 10px;
}
.alert-success { background: #d4edda; color: #155724; border: 1px solid #c3e6cb; }
.alert-danger   { background: #f8d7da; color: #721c24; border: 1px solid #f5c6cb; }

/* ===== FILTER TABS ===== */
.filter-tabs {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 24px;
}
.filter-tab {
    padding: 8px 18px;
    border-radius: 20px;
    border: 1.5px solid #e0e0e0;
    background: white;
    font-size: 13px;
    font-weight: 500;
    color: var(--brand-text-muted);
    cursor: pointer;
    font-family: 'Roboto', sans-serif;
    transition: all .2s ease;
}
.filter-tab:hover,
.filter-tab.active {
    border-color: var(--brand-primary);
    color: var(--brand-primary);
    background: rgba(194,74,22,0.06);
}

/* ===== POSTS GRID ===== */
.posts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 24px;
}

/* ===== POST CARD ===== */
.post-card {
    background: white;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0,0,0,0.05);
    transition: all 0.3s ease;
    border: 2px solid transparent;
}
.post-card:hover { transform: translateY(-4px); box-shadow: 0 10px 30px rgba(0,0,0,0.1); }
.post-card.pinned { border-color: var(--brand-primary); }
.post-card.hidden-post { opacity: .65; }

.post-image { width: 100%; height: 200px; object-fit: cover; display: block; }
.post-image-placeholder {
    width: 100%; height: 120px;
    background: linear-gradient(135deg, #fdf0e8, #fce4d6);
    display: flex; align-items: center; justify-content: center;
    color: #e0a080; font-size: 2.5rem;
}

.post-body { padding: 20px; }

.post-author-row {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
}
.post-avatar {
    width: 40px; height: 40px; border-radius: 50%;
    background: linear-gradient(135deg, #c24a16, #e85d04);
    color: white; display: flex; align-items: center; justify-content: center;
    font-size: 15px; font-weight: 700; flex-shrink: 0;
}
.post-author-name { font-weight: 700; font-size: 14px; color: var(--brand-text); }
.post-author-time { font-size: 12px; color: var(--brand-text-muted); margin-top: 1px; }

.post-badges { margin-left: auto; display: flex; gap: 6px; flex-wrap: wrap; justify-content: flex-end; }
.badge-pin {
    background: linear-gradient(135deg, #c24a16, #e85d04);
    color: white; font-size: 11px; padding: 3px 10px;
    border-radius: 20px; font-weight: 600;
}
.badge-hidden {
    background: #6c757d; color: white;
    font-size: 11px; padding: 3px 10px;
    border-radius: 20px; font-weight: 600;
}

.service-tag {
    display: inline-block;
    padding: 3px 12px;
    border-radius: 20px;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .5px;
    margin-bottom: 10px;
    background: rgba(194,74,22,0.1);
    color: var(--brand-primary);
}

.post-caption {
    font-size: 14px;
    color: var(--brand-text);
    line-height: 1.6;
    margin-bottom: 12px;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

.post-stats {
    display: flex;
    gap: 18px;
    font-size: 13px;
    color: var(--brand-text-muted);
    margin-bottom: 16px;
    padding-bottom: 16px;
    border-bottom: 1px solid #f0f0f0;
}
.post-stats i { margin-right: 4px; color: var(--brand-primary); }

.post-actions { display: flex; gap: 8px; flex-wrap: wrap; }
.btn-action {
    padding: 7px 14px;
    border-radius: 10px;
    border: none;
    cursor: pointer;
    font-size: 12px;
    font-family: 'Roboto', sans-serif;
    font-weight: 600;
    transition: all .2s ease;
    display: inline-flex;
    align-items: center;
    gap: 5px;
}
.btn-pin    { background: rgba(194,74,22,0.1); color: var(--brand-primary); }
.btn-pin:hover { background: var(--brand-primary); color: white; }
.btn-hide   { background: rgba(108,117,125,0.1); color: #6c757d; }
.btn-hide:hover { background: #6c757d; color: white; }
.btn-show   { background: rgba(40,167,69,0.1); color: #28a745; }
.btn-show:hover { background: #28a745; color: white; }
.btn-delete { background: rgba(220,53,69,0.1); color: #dc3545; }
.btn-delete:hover { background: #dc3545; color: white; }

/* ===== EMPTY STATE ===== */
.empty-state {
    grid-column: 1 / -1;
    text-align: center;
    padding: 80px 20px;
    background: white;
    border-radius: 16px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.05);
}
.empty-state i { font-size: 4rem; color: #ddd; margin-bottom: 16px; display: block; }
.empty-state h3 { font-family: 'Playfair Display', serif; font-size: 22px; color: var(--brand-text); margin-bottom: 8px; }
.empty-state p { color: var(--brand-text-muted); font-size: 14px; }

/* ===== DELETE MODAL ===== */
.modal-overlay {
    position: fixed; inset: 0;
    background: rgba(0,0,0,0.5);
    display: none; align-items: center; justify-content: center;
    z-index: 1000;
}
.modal-overlay.open { display: flex; }
.modal-box {
    background: white; border-radius: 20px; padding: 36px;
    max-width: 420px; width: 90%;
    box-shadow: 0 24px 60px rgba(0,0,0,0.2);
}
.modal-box h3 { font-family: 'Playfair Display', serif; font-size: 22px; margin-bottom: 12px; color: var(--brand-text); }
.modal-box p { color: var(--brand-text-muted); font-size: 14px; margin-bottom: 28px; line-height: 1.6; }
.modal-actions { display: flex; gap: 12px; justify-content: flex-end; }
.btn-cancel {
    padding: 11px 22px; border-radius: 10px;
    border: 1.5px solid #ddd; background: white;
    cursor: pointer; font-family: 'Roboto', sans-serif;
    font-size: 14px; font-weight: 500;
    transition: all .2s;
}
.btn-cancel:hover { border-color: #bbb; background: #f9f9f9; }
.btn-confirm-delete {
    padding: 11px 22px; border-radius: 10px; border: none;
    background: linear-gradient(135deg, #dc3545, #c82333);
    color: white; cursor: pointer;
    font-family: 'Roboto', sans-serif;
    font-size: 14px; font-weight: 700;
    transition: all .2s;
    box-shadow: 0 4px 14px rgba(220,53,69,0.3);
}
.btn-confirm-delete:hover { transform: translateY(-1px); box-shadow: 0 6px 18px rgba(220,53,69,0.4); }

/* ===== RESPONSIVE ===== */
@media (max-width: 768px) {
    .sidebar, .sidebar-accent { display: none; }
    .main-content, .topbar { margin-left: 0; }
    .welcome-section { flex-direction: column; gap: 20px; }
}
</style>
{% endblock %}

{% block body %}
<div class="sidebar-accent"></div>

<!-- SIDEBAR -->
