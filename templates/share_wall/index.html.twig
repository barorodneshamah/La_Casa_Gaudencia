                Services
            </a>
        </li>
        <li>
            <a href="{{ path('reservation_index') }}">
                <svg viewBox="0 0 24 24"><path d="M20 6h-2V4h-2v2H8V4H6v2H4a2 2 0 00-2 2v12a2 2 0 002 2h16a2 2 0 002-2V8a2 2 0 00-2-2zm0 14H4V10h16v10z"/></svg>
                Reservations
            </a>
        </li>
        <li>
            <a href="{{ path('app_payment_dashboard') }}">
                <svg viewBox="0 0 24 24"><path d="M2 6h20v2H2V6zm0 4h20v8H2v-8zm0 10h20v2H2v-2z"/></svg>
                Payments
