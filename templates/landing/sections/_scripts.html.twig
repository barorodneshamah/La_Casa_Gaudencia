<script>
document.addEventListener('DOMContentLoaded', function () {
    /* ── Element references ── */
    const navbar       = document.getElementById('navbar');
    const menuToggle   = document.getElementById('menuToggle');
    const navMenu      = document.getElementById('navMenu');

    /* ══════════════════════════════════════
       SHARE WALL INTERACTIONS
    ══════════════════════════════════════ */

    function bubbleCardToTop(card) {
        var feed = document.getElementById('reviewFeed');
        if (!feed || feed.firstChild === card) return;
        feed.insertBefore(card, feed.firstChild);
        card.classList.remove('bubbling');
        void card.offsetWidth;
        card.classList.add('bubbling');
        setTimeout(function () { card.classList.remove('bubbling'); }, 550);
    }

    document.querySelectorAll('.like-btn').forEach(function (btn) {
        btn.addEventListener('click', function (e) {
            e.stopPropagation();
            if (this.getAttribute('data-requires-auth') === 'true') {
                window.location.href = '{{ path("app_login") }}';
                return;
            }
            this.classList.toggle('liked');
            var icon      = this.querySelector('i');
            var countSpan = this.querySelector('span');
            var count     = parseInt(countSpan.textContent);
            if (this.classList.contains('liked')) {
                icon.className        = 'fas fa-heart';
                countSpan.textContent = count + 1;
                bubbleCardToTop(this.closest('.review-card'));
            } else {
                icon.className        = 'far fa-heart';
                countSpan.textContent = count - 1;
            }
        });
    });

    document.querySelectorAll('.comment-btn').forEach(function (btn) {
        btn.addEventListener('click', function (e) {
            e.stopPropagation();
            if (this.getAttribute('data-requires-auth') === 'true') {
                window.location.href = '{{ path("app_login") }}';
                return;
            }
            this.classList.toggle('active');
            var card     = this.closest('.review-card');
            var comments = card.querySelector('.review-comments');
            if (comments) {
                var opening = !comments.classList.contains('open');
                comments.classList.toggle('open');
                if (opening) bubbleCardToTop(card);
            }
        });
    });

    // FIXED: Share button - no bubbling, unique URL per card, redirects to login
document.querySelectorAll('.share-btn').forEach(function (btn) {
    btn.addEventListener('click', function (e) {
        e.stopPropagation();
        e.preventDefault();
        
        var clickedBtn = this;
        var clickedSpan = clickedBtn.querySelector('span');
        var card = clickedBtn.closest('.review-card');
        
        var authorEl = card.querySelector('.review-author-info .name');
        var authorName = authorEl ? authorEl.textContent.trim() : 'Guest';
        var category = card.getAttribute('data-category') || 'story';
        
        // Share URL redirects to login page
        var shareUrl = window.location.origin + '{{ path("app_login") }}' + '?ref=sharewall&story=' + category + '-' + authorName.replace(/\s+/g, '-').toLowerCase();
        
        if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(shareUrl)
                .then(function() {
                    clickedBtn.classList.add('shared');
                    clickedSpan.textContent = 'Copied!';
                    
                    setTimeout(function() {
                        clickedBtn.classList.remove('shared');
                        clickedSpan.textContent = 'Share';
                    }, 2000);
                })
                .catch(function() {
                    doFallbackCopy(shareUrl, clickedBtn, clickedSpan);
                });
        } else {
            doFallbackCopy(shareUrl, clickedBtn, clickedSpan);
        }
    });
});
    // Fallback copy helper
    function doFallbackCopy(text, btn, span) {
        var textArea = document.createElement('textarea');
        textArea.value = text;
        textArea.style.position = 'fixed';
        textArea.style.left = '-9999px';
        textArea.style.top = '-9999px';
        document.body.appendChild(textArea);
        textArea.focus();
        textArea.select();
        
        try {
            document.execCommand('copy');
            btn.classList.add('shared');
            span.textContent = 'Copied!';
            setTimeout(function() {
                btn.classList.remove('shared');
                span.textContent = 'Share';
            }, 2000);
        } catch (err) {
            alert('Copy this link:\n' + text);
        }
        
        document.body.removeChild(textArea);
    }

    document.querySelectorAll('.bookmark-btn').forEach(function (btn) {
        btn.addEventListener('click', function (e) {
            e.stopPropagation();
            if (this.getAttribute('data-requires-auth') === 'true') {
                window.location.href = '{{ path("app_login") }}';
                return;
            }
            this.classList.toggle('bookmarked');
            var icon = this.querySelector('i');
            icon.className = this.classList.contains('bookmarked') ? 'fas fa-bookmark' : 'far fa-bookmark';
        });
    });

    document.querySelectorAll('.send-btn[data-requires-auth="true"]').forEach(function (btn) {
        btn.addEventListener('click', function (e) {
            e.stopPropagation();
            window.location.href = '{{ path("app_login") }}';
        });
    });

    document.querySelectorAll('.comment-input-wrap input[readonly]').forEach(function (input) {
        input.addEventListener('click', function () {
            window.location.href = '{{ path("app_login") }}';
        });
    });

    var filterTabs  = document.querySelectorAll('.filter-tab');
    var reviewCards = document.querySelectorAll('.review-card[data-category]');

    filterTabs.forEach(function (tab) {
        tab.addEventListener('click', function () {
            filterTabs.forEach(function (t) { t.classList.remove('active'); });
            this.classList.add('active');
            var filter = this.getAttribute('data-filter');

            reviewCards.forEach(function (card) {
                if (filter === 'all' || card.getAttribute('data-category') === filter) {
                    card.style.display = '';
                    card.style.opacity = '0';
                    card.style.transform = 'translateY(20px)';
                    setTimeout(function () {
                        card.style.opacity = '1';
                        card.style.transform = 'translateY(0)';
                    }, 100);
                } else {
                    card.style.display = 'none';
                }
            });
        });
    });

    var lightbox        = document.getElementById('lightbox');
    var lightboxImage   = document.getElementById('lightboxImage');
    var lightboxCaption = document.getElementById('lightboxCaption');
    var lightboxClose   = document.querySelector('.lightbox-close');

    if (lightbox && lightboxImage && lightboxCaption) {
        document.querySelectorAll('.review-image-wrapper[data-lightbox]').forEach(function (wrapper) {
            wrapper.addEventListener('click', function () {
                lightboxImage.src = this.getAttribute('data-lightbox');
                lightboxCaption.textContent = this.getAttribute('data-caption') || '';
                lightbox.classList.add('show');
                document.body.style.overflow = 'hidden';
            });
        });

        var closeLightbox = function () {
            lightbox.classList.remove('show');
            document.body.style.overflow = '';
        };

        if (lightboxClose) lightboxClose.addEventListener('click', closeLightbox);
        lightbox.addEventListener('click', function (e) {
            if (e.target === this) closeLightbox();
        });

        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape' && lightbox.classList.contains('show')) {
                closeLightbox();
            }
        });
    }

    var statNumbers  = document.querySelectorAll('.stat-number[data-count]');
    var statsCounted = false;

    var countUp = function (el) {
        var target   = parseInt(el.getAttribute('data-count'));
        var duration = 2000;
        var step     = target / (duration / 16);
        var current  = 0;
        var timer = setInterval(function () {
            current += step;
            if (current >= target) {
                el.textContent = target.toLocaleString();
                clearInterval(timer);
            } else {
                el.textContent = Math.floor(current).toLocaleString();
            }
        }, 16);
    };

    if (statNumbers.length > 0) {
        var statsObserver = new IntersectionObserver(function (entries) {
            entries.forEach(function (entry) {
                if (entry.isIntersecting && !statsCounted) {
                    statsCounted = true;
                    statNumbers.forEach(function (el) { countUp(el); });
                }
            });
        }, { threshold: 0.5 });

        var statsSection = document.querySelector('.sharewall-stats');
        if (statsSection) statsObserver.observe(statsSection);
    }

    /* ══════════════════════════════════════
       SERVICE MODALS - DATABASE DATA WITH IMAGES
    ══════════════════════════════════════ */
    var serviceModals = document.querySelectorAll('.service-modal');
    var serviceModalCloseBtns = document.querySelectorAll('.service-modal-close');
    
    let loadedData = {
        accommodations: false,
        tours: false,
        dining: false,
        planning: true,
        sharewall: true
    };

    function openServiceModal(type) {
        var modal = document.getElementById('serviceModal-' + type);
        if (!modal) return;

        serviceModals.forEach(function (m) { m.classList.remove('show'); });
        modal.classList.add('show');
        document.body.style.overflow = 'hidden';

        if (!loadedData[type] && (type === 'accommodations' || type === 'tours' || type === 'dining')) {
            loadModalData(type, modal);
            loadedData[type] = true;
        }

        setTimeout(function() {
            modal.querySelectorAll('.sample-service-card').forEach(function(card, i) {
                card.style.opacity = '0';
                card.style.transform = 'translateY(30px)';
                setTimeout(function() {
                    card.style.transition = 'opacity 0.5s ease ' + (i * 0.1) + 's, transform 0.5s cubic-bezier(.34,1.56,.64,1) ' + (i * 0.1) + 's';
                    card.style.opacity = '1';
                    card.style.transform = 'translateY(0)';
                }, 50);
            });
        }, 100);
    }

    function loadModalData(type, modal) {
        let apiUrl = '';
        let gridId = '';
        
        switch(type) {
            case 'accommodations':
                apiUrl = '{{ path("api_services_rooms") }}';
                gridId = 'rooms-grid';
                break;
            case 'tours':
                apiUrl = '{{ path("api_services_tours") }}';
                gridId = 'tours-grid';
                break;
            case 'dining':
                apiUrl = '{{ path("api_services_food") }}';
                gridId = 'food-grid';
                break;
            default:
                return;
        }

        const grid = document.getElementById(gridId);
        if (!grid) {
            console.error('Grid not found:', gridId);
            return;
        }

        grid.innerHTML = '<div style="grid-column: 1/-1; text-align: center; padding: 60px 20px;">' +
            '<i class="fas fa-spinner fa-spin fa-3x" style="color: var(--primary-color); margin-bottom: 20px;"></i>' +
            '<p style="color: var(--text-light); font-size: 16px;">Loading...</p>' +
        '</div>';

        fetch(apiUrl)
            .then(function(response) {
                var contentType = response.headers.get('content-type');
                if (!contentType || !contentType.includes('application/json')) {
                    return response.text().then(function(text) {
                        console.error('Non-JSON response:', text.substring(0, 200));
                        throw new Error('Server error. Please try again.');
                    });
                }
                return response.json();
            })
            .then(function(data) {
                console.log('API Response for ' + type + ':', data);
                
                if (data.error) {
                    throw new Error(data.error);
                }
                
                var items = [];
                if (data.success && Array.isArray(data.data)) {
                    items = data.data;
                } else if (Array.isArray(data)) {
                    items = data;
                } else if (data.data && Array.isArray(data.data)) {
                    items = data.data;
                }
                
                if (items.length > 0) {
                    grid.innerHTML = items.map(function(item) { return generateCardHTML(item, type); }).join('');
                    attachCardEventListeners(grid);
                    
                    grid.querySelectorAll('.sample-service-card').forEach(function(card, i) {
                        card.style.opacity = '0';
                        card.style.transform = 'translateY(20px)';
                        setTimeout(function() {
                            card.style.transition = 'all 0.4s ease';
                            card.style.opacity = '1';
                            card.style.transform = 'translateY(0)';
                        }, i * 100);
                    });
                } else {
                    grid.innerHTML = '<div style="grid-column: 1/-1; text-align: center; padding: 60px 20px;">' +
                        '<i class="fas fa-box-open fa-3x" style="color: var(--accent-gold); margin-bottom: 20px;"></i>' +
                        '<h3 style="color: var(--primary-color); margin-bottom: 10px;">No Items Available</h3>' +
                        '<p style="color: var(--text-light); font-size: 16px;">Check back soon for new offerings!</p>' +
                    '</div>';
                }
            })
            .catch(function(err) {
                console.error('Fetch error:', err);
                grid.innerHTML = '<div style="grid-column: 1/-1; text-align: center; padding: 60px 20px;">' +
                    '<i class="fas fa-exclamation-triangle fa-3x" style="color: #e74c3c; margin-bottom: 20px;"></i>' +
                    '<h3 style="color: var(--text-dark); margin-bottom: 10px;">Error Loading Data</h3>' +
                    '<p style="color: var(--text-light); font-size: 14px;">' + err.message + '</p>' +
                '</div>';
            });
    }

    function generateCardHTML(item, type) {
        var rating = item.rating || 4.5;
        var fullStars = Math.floor(rating);
        var hasHalfStar = (rating % 1) >= 0.5;
        
        var starsHTML = '';
        for (var i = 0; i < fullStars; i++) {
            starsHTML += '<i class="fas fa-star"></i>';
        }
        if (hasHalfStar) {
            starsHTML += '<i class="fas fa-star-half-alt"></i>';
        }
        for (var i = fullStars + (hasHalfStar ? 1 : 0); i < 5; i++) {
            starsHTML += '<i class="far fa-star"></i>';
        }

        var badgeHTML = '';
        if (type === 'accommodations' && item.available && item.available <= 2) {
            badgeHTML = '<span class="card-badge" style="background: linear-gradient(135deg, #e74c3c, #c0392b);">Almost Full!</span>';
        } else if (type === 'tours' && item.reviews > 100) {
            badgeHTML = '<span class="card-badge" style="background: linear-gradient(135deg, #f39c12, #e67e22);">Popular</span>';
        } else if (type === 'dining' && item.category) {
            badgeHTML = '<span class="card-badge" style="background: linear-gradient(135deg, #27ae60, #2ecc71);">' + item.category + '</span>';
        }

        var featuresHTML = '';
        if (type === 'accommodations' && item.amenities && item.amenities.length) {
            featuresHTML = '<div class="card-features">' +
                item.amenities.slice(0, 4).map(function(a) {
                    return '<span class="feature-tag"><i class="fas fa-check"></i> ' + a + '</span>';
                }).join('') +
            '</div>';
        } else if (type === 'tours' && item.inclusions && item.inclusions.length) {
            featuresHTML = '<div class="card-features">' +
                item.inclusions.slice(0, 2).map(function(inc) {
                    return '<span class="feature-tag"><i class="fas fa-check"></i> ' + inc + '</span>';
                }).join('') +
                '<span class="feature-tag"><i class="fas fa-clock"></i> ' + (item.duration || 'Full Day') + '</span>' +
            '</div>';
        } else if (type === 'dining') {
            featuresHTML = '<div class="card-features">' +
                '<span class="feature-tag"><i class="fas fa-utensils"></i> ' + (item.category || 'Filipino') + '</span>' +
                (item.availableStock ? '<span class="feature-tag"><i class="fas fa-box"></i> ' + item.availableStock + ' in stock</span>' : '') +
            '</div>';
        }

        var extraInfo = '';
        if (type === 'accommodations' && item.available) {
            var statusColor = item.available > 3 ? '#27ae60' : '#e74c3c';
            extraInfo = '<div class="card-availability" style="display: flex; align-items: center; gap: 8px; margin-bottom: 15px; font-size: 13px;">' +
                '<i class="fas fa-calendar-check" style="color: ' + statusColor + ';"></i>' +
                '<span style="color: ' + statusColor + '; font-weight: 600;">' +
                    (item.available > 3 ? item.available + ' rooms available' : 'Only ' + item.available + ' left!') +
                '</span>' +
            '</div>';
        } else if (type === 'tours') {
            extraInfo = '<div class="tour-info" style="display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 15px; font-size: 13px; color: var(--text-light);">' +
                (item.location ? '<span><i class="fas fa-map-marker-alt" style="color: var(--primary-color); margin-right: 5px;"></i>' + item.location + '</span>' : '') +
                (item.schedule ? '<span><i class="fas fa-clock" style="color: var(--accent-gold); margin-right: 5px;"></i>' + item.schedule + '</span>' : '') +
            '</div>';
        }

        var unitLabel = type === 'accommodations' ? '/night' : type === 'tours' ? '/person' : '/serving';
        
        var imageSrc = item.image || '';
        if (!imageSrc || imageSrc === '') {
            if (type === 'accommodations') {
                imageSrc = '/images/room1.jpg';
            } else if (type === 'tours') {
                imageSrc = '/images/tour1.jpg';
            } else if (type === 'dining') {
                imageSrc = '/images/food1.jpg';
            } else {
                imageSrc = '/images/placeholder.jpg';
            }
        }

        var safeName = (item.name || '').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
        var safeDesc = (item.description || '').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
        var formattedPrice = Number(item.price || 0).toLocaleString();

        return '<div class="sample-service-card">' +
            '<div class="card-image-wrapper">' +
                '<img ' +
                    'src="' + imageSrc + '" ' +
                    'alt="' + safeName + '" ' +
                    'class="card-image" ' +
                    'loading="lazy" ' +
                    'onerror="this.onerror=null; this.src=\'/images/placeholder.jpg\';" ' +
                '/>' +
                badgeHTML +
                '<div class="card-hover-overlay">' +
                    '<button ' +
                        'class="quick-view-btn" ' +
                        'data-name="' + safeName + '" ' +
                        'data-price="' + (item.price || 0) + '" ' +
                        'data-desc="' + safeDesc + '" ' +
                        'data-image="' + imageSrc + '"' +
                    '>' +
                        '<i class="fas fa-search-plus"></i> Quick View' +
                    '</button>' +
                '</div>' +
            '</div>' +
            '<div class="card-body">' +
                '<h4>' + (item.name || 'Item') + '</h4>' +
                '<div class="card-rating">' +
                    starsHTML +
                    '<span>' + rating.toFixed(1) + ' (' + (item.reviews || 0) + ' reviews)</span>' +
                '</div>' +
                '<p>' + (item.description || 'No description available.') + '</p>' +
                featuresHTML +
                extraInfo +
                '<div class="card-footer">' +
                    '<div class="card-price">' +
                        '<span class="price-label">From</span>' +
                        '<span class="price-value">₱' + formattedPrice + ' <span class="price-unit">' + unitLabel + '</span></span>' +
                    '</div>' +
                    '<a href="{{ path('app_login') }}" class="card-book-btn">' +
                        '<i class="fas fa-lock"></i> Sign In to Book' +
                    '</a>' +
                '</div>' +
            '</div>' +
        '</div>';
    }

    function attachCardEventListeners(grid) {
        grid.querySelectorAll('.quick-view-btn').forEach(function(btn) {
            btn.addEventListener('click', function(e) {
                e.stopPropagation();
                var name = this.getAttribute('data-name');
                var price = this.getAttribute('data-price');
                var desc = this.getAttribute('data-desc');
                alert(name + '\n\nPrice: ₱' + Number(price).toLocaleString() + '\n\n' + desc + '\n\n✨ Sign in to see full details and book!');
            });
        });

        grid.querySelectorAll('.card-book-btn').forEach(function(btn) {
            btn.addEventListener('click', function(e) {
                e.preventDefault();
                window.location.href = '{{ path("app_login") }}';
            });
        });
    }

    function closeServiceModal() {
        serviceModals.forEach(function (m) { m.classList.remove('show'); });
        document.body.style.overflow = '';
    }

    document.addEventListener('click', function(e) {
        var btn = e.target.closest('[data-service-view]');
        if (btn) {
            e.stopPropagation();
            e.preventDefault();
            var serviceType = btn.getAttribute('data-service-view');
            openServiceModal(serviceType);
        }
    });

    serviceModalCloseBtns.forEach(function (btn) {
        btn.addEventListener('click', closeServiceModal);
    });

    serviceModals.forEach(function (modal) {
        modal.addEventListener('click', function (e) {
            if (e.target === this) closeServiceModal();
        });
    });

    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') closeServiceModal();
    });

    /* ══════════════════════════════════════
       SERVICE CARD ANIMATIONS 
    ══════════════════════════════════════ */
    var cardObserver = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
            if (entry.isIntersecting) {
                entry.target.style.opacity = '1';
                entry.target.style.transform = 'translateY(0)';
                cardObserver.unobserve(entry.target);
            }
        });
    }, { threshold: 0.12 });

    document.querySelectorAll('.service-card').forEach(function (card, i) {
        card.style.opacity = '0';
        card.style.transform = 'translateY(40px)';
        card.style.transition = 'opacity 0.6s ease ' + (i * 0.1) + 's, transform 0.6s ease ' + (i * 0.1) + 's, box-shadow 0.4s ease';
        cardObserver.observe(card);
    });

    /* ══════════════════════════════════════
       NAVBAR SCROLL
    ══════════════════════════════════════ */
    if (navbar) {
        window.addEventListener('scroll', function () {
            navbar.classList.toggle('scrolled', window.scrollY > 50);
        });
    }

    /* ══════════════════════════════════════
       MOBILE MENU
    ══════════════════════════════════════ */
    if (menuToggle && navMenu) {
        menuToggle.addEventListener('click', function () {
            navMenu.classList.toggle('active');
            menuToggle.classList.toggle('active');
            document.body.style.overflow = navMenu.classList.contains('active') ? 'hidden' : '';
        });

        // Close menu when clicking outside
        document.addEventListener('click', function (e) {
            if (!navbar.contains(e.target) && navMenu.classList.contains('active')) {
                navMenu.classList.remove('active');
                menuToggle.classList.remove('active');
                document.body.style.overflow = '';
            }
        });

        document.querySelectorAll('.navbar ul li a').forEach(function (link) {
            link.addEventListener('click', function () {
                navMenu.classList.remove('active');
                menuToggle.classList.remove('active');
                document.body.style.overflow = '';
            });
        });
    }

    /* ══════════════════════════════════════
       ACTIVE NAV HIGHLIGHT
    ══════════════════════════════════════ */
    var navLinks = document.querySelectorAll('.navbar ul li a:not(.signin-btn)');
    var sections = document.querySelectorAll('section[id]');

    if (navLinks.length > 0 && sections.length > 0 && navbar) {
        var clearActive = function () {
            navLinks.forEach(function (l) {
                l.classList.remove('nav-active');
                l.style.color = '';
            });
        };

        var setActive = function (id) {
            clearActive();
            navLinks.forEach(function (link) {
                var href = link.getAttribute('href') || '';
                if (href === '#' + id || href.endsWith('#' + id)) {
                    link.classList.add('nav-active');
                }
            });
        };

        window.addEventListener('scroll', function () {
            var scrollY = window.pageYOffset;
            var current = '';

            sections.forEach(function (section) {
                var top = section.offsetTop - navbar.offsetHeight - 20;
                var bottom = top + section.offsetHeight;
                if (scrollY >= top && scrollY < bottom) {
                    current = section.getAttribute('id');
                }
            });

            if (current) setActive(current);
        });

        navLinks.forEach(function (link) {
            link.addEventListener('click', function () {
                clearActive();
                this.classList.add('nav-active');
            });
        });

        var initialHash = window.location.hash ? window.location.hash.replace('#', '') : 'home';
        setActive(initialHash);
    }

    /* ══════════════════════════════════════
       SMOOTH SCROLL
    ══════════════════════════════════════ */
    document.querySelectorAll('a[href^="#"]').forEach(function (anchor) {
        anchor.addEventListener('click', function (e) {
            var href = this.getAttribute('href');
            if (href !== '#') {
                e.preventDefault();
                var target = document.querySelector(href);
                if (target && navbar) {
                    window.scrollTo({
                        top: target.offsetTop - navbar.offsetHeight,
                        behavior: 'smooth'
                    });
                } else if (target) {
                    window.scrollTo({
                        top: target.offsetTop,
                        behavior: 'smooth'
                    });
                }
            }
        });
    });

    /* ══════════════════════════════════════
       INTERSECTION OBSERVER ANIMATIONS
    ══════════════════════════════════════ */
    var observer = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry, index) {
            if (entry.isIntersecting) {
                setTimeout(function () {
                    entry.target.style.opacity = '1';
                    entry.target.style.transform = 'translateY(0)';
                }, index * 100);
            }
        });
    }, { threshold: 0.1, rootMargin: '0px 0px -50px 0px' });

    document.querySelectorAll('.about-card, .review-card, .perk-item, .contact-item, .stat-item, .about-cta-inner').forEach(function (el, index) {
        el.style.opacity = '0';
        el.style.transform = 'translateY(30px)';
        el.style.transition = 'opacity 0.6s ease ' + (index * 0.1) + 's, transform 0.6s ease ' + (index * 0.1) + 's';
        observer.observe(el);
    });

    /* ══════════════════════════════════════
       PARALLAX HERO
    ══════════════════════════════════════ */
    var hero = document.querySelector('.hero');
    if (hero) {
        window.addEventListener('scroll', function () {
            var scrolled = window.pageYOffset;
            if (scrolled < window.innerHeight) {
                hero.style.backgroundPositionY = scrolled * 0.5 + 'px';
            }
        });
    }

    /* ══════════════════════════════════════
       SCROLL INDICATOR
    ══════════════════════════════════════ */
    var scrollIndicator = document.querySelector('.scroll-indicator');
    if (scrollIndicator) {
        scrollIndicator.addEventListener('click', function () {
            var about = document.querySelector('#about');
            if (about && navbar) {
                window.scrollTo({
                    top: about.offsetTop - navbar.offsetHeight,
                    behavior: 'smooth'
                });
            } else if (about) {
                window.scrollTo({
                    top: about.offsetTop,
                    behavior: 'smooth'
                });
            }
        });
    }

    /* ══════════════════════════════════════
       RIPPLE EFFECT
    ══════════════════════════════════════ */
    var rippleStyle = document.createElement('style');
    rippleStyle.textContent = '@keyframes rippleEffect { to { transform: scale(4); opacity: 0; } }';
    document.head.appendChild(rippleStyle);

    function attachRipple(selector) {
        document.addEventListener('click', function(e) {
            var btn = e.target.closest(selector);
            if (!btn) return;
            
            var ripple = document.createElement('span');
            var rect = btn.getBoundingClientRect();
            var size = Math.max(rect.width, rect.height);
            
            ripple.style.cssText = 
                'position: absolute;' +
                'width: ' + size + 'px;' +
                'height: ' + size + 'px;' +
                'left: ' + (e.clientX - rect.left - size / 2) + 'px;' +
                'top: ' + (e.clientY - rect.top - size / 2) + 'px;' +
                'background: rgba(255,255,255,0.4);' +
                'border-radius: 50%;' +
                'transform: scale(0);' +
                'animation: rippleEffect 0.6s ease-out;' +
                'pointer-events: none;' +
                'z-index: 99;';
            
            btn.style.position = 'relative';
            btn.style.overflow = 'hidden';
            btn.appendChild(ripple);
            
            setTimeout(function() { ripple.remove(); }, 650);
        });
    }

    attachRipple('.service-cta-btn, .card-book-btn, .notice-btn, .view-all-btn, .btn, .btn-create-account, .signin-btn');

    /* ══════════════════════════════════════
       PRICE COUNTER ANIMATION
    ══════════════════════════════════════ */
    function animatePrice(element) {
        var targetText = element.textContent.replace(/[₱,]/g, '').trim();
        if (isNaN(parseInt(targetText)) || targetText.toLowerCase() === 'free') return;
        
        var target = parseInt(targetText);
        var duration = 1500;
        var step = target / (duration / 16);
        var current = 0;
        
        var timer = setInterval(function() {
            current += step;
            if (current >= target) {
                element.textContent = '₱' + target.toLocaleString();
                clearInterval(timer);
            } else {
                element.textContent = '₱' + Math.floor(current).toLocaleString();
            }
        }, 16);
    }

    var priceObserver = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
            if (entry.isIntersecting) {
                var priceElement = entry.target.querySelector('.price-amount');
                if (priceElement && !priceElement.classList.contains('animated')) {
                    priceElement.classList.add('animated');
                    animatePrice(priceElement);
                }
                priceObserver.unobserve(entry.target);
            }
        });
    }, { threshold: 0.5 });

    document.querySelectorAll('.service-card').forEach(function(card) {
        priceObserver.observe(card);
    });

    /* ══════════════════════════════════════
       SCROLL REVEAL FOR SERVICE CARDS
    ══════════════════════════════════════ */
    var serviceObserver = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry, index) {
            if (entry.isIntersecting) {
                setTimeout(function() {
                    entry.target.style.opacity = '1';
                    entry.target.style.transform = 'translateY(0)';
                }, index * 100);
                serviceObserver.unobserve(entry.target);
            }
        });
    }, { threshold: 0.1, rootMargin: '-50px' });

    document.querySelectorAll('.service-card').forEach(function(card, i) {
        card.style.opacity = '0';
        card.style.transform = 'translateY(40px)';
        card.style.transition = 'opacity 0.6s ease ' + (i * 0.1) + 's, transform 0.6s ease ' + (i * 0.1) + 's, box-shadow 0.4s ease';
        serviceObserver.observe(card);
    });
});
</script>