        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 18px;
    }
    .perk-item {
        display: flex;
        align-items: flex-start;
        gap: 16px;
        transition: transform 0.3s ease;
    }
    .perk-item:hover {
        transform: translateX(8px);
    }
    .perk-icon-wrap {
