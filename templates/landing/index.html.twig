    .contact-container {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 50px;
        max-width: 1200px;
        margin: 0 auto;
        text-align: left;
        position: relative;
        z-index: 1;
    }
    .contact-info {
        padding: 20px 0;
    }
    .contact-info-header h3 {
        font-size: 26px;
        margin-bottom: 12px;
        color: var(--text-dark);
    }
    .contact-info-header p {
        color: var(--text-light);
        font-size: 15px;
        line-height: 1.7;
        margin-bottom: 30px;
    }
    .contact-details {
        display: flex;
        flex-direction: column;
        gap: 20px;
        margin-bottom: 30px;
    }
    .contact-item {
        display: flex;
        align-items: flex-start;
        gap: 16px;
        padding: 15px;
        border-radius: 16px;
        transition: all 0.3s ease;
    }
    .contact-item:hover {
        background: rgba(194, 74, 22, 0.04);
        transform: translateX(8px);
    }
    .icon-box {
        width: 50px;
        height: 50px;
        flex-shrink: 0;
        background: linear-gradient(
            135deg,
            rgba(194, 74, 22, 0.1),
            rgba(212, 168, 83, 0.12)
        );
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s ease;
    }
    .contact-item:hover .icon-box {
        background: var(--gradient-primary);
    }
    .icon-box i {
        color: var(--primary-color);
        font-size: 20px;
        transition: color 0.3s ease;
    }
    .contact-item:hover .icon-box i {
        color: var(--white);
    }
    .contact-item-content h4 {
        font-size: 14px;
        font-weight: 700;
        color: var(--text-dark);
        margin-bottom: 4px;
        font-family: "Roboto", sans-serif;
        letter-spacing: 0.5px;
        text-transform: uppercase;
    }
    .contact-item-content p,
    .contact-item-content a {
        color: var(--text-light);
        font-size: 14px;
        line-height: 1.6;
        text-decoration: none;
        display: block;
        transition: color 0.3s;
    }
    .contact-item-content a:hover {
        color: var(--primary-color);
    }
    .contact-social h4 {
        font-size: 14px;
        font-weight: 700;
        color: var(--text-dark);
        margin-bottom: 14px;
        font-family: "Roboto", sans-serif;
        letter-spacing: 0.5px;
        text-transform: uppercase;
    }
    .contact-social-icons {
        display: flex;
        gap: 12px;
    }
    .contact-social-icons a {
        width: 46px;
        height: 46px;
        border-radius: 50%;
        background: linear-gradient(
            135deg,
            rgba(194, 74, 22, 0.08),
            rgba(212, 168, 83, 0.08)
        );
        color: var(--primary-color);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
        transition: all 0.3s ease;
        text-decoration: none;
        position: relative;
    }
    .contact-social-icons a::before {
        content: "";
        position: absolute;
        inset: 0;
        background: var(--gradient-primary);
        border-radius: 50%;
        opacity: 0;
        transition: opacity 0.3s ease;
        z-index: -1;
    }
    .contact-social-icons a:hover::before {
        opacity: 1;
    }
    .contact-social-icons a:hover {
        color: var(--white);
        transform: translateY(-3px) scale(1.1);
    }
    .contact-map h3 {
        font-size: 22px;
        color: var(--text-dark);
        margin-bottom: 20px;
    }
    .map-wrapper {
        position: relative;
        border-radius: var(--border-radius-card);
        overflow: hidden;
        box-shadow: var(--shadow-medium);
    }
    .map-wrapper iframe {
        width: 100%;
        height: 380px;
        border: none;
        display: block;
    }
    .map-overlay-card {
        position: absolute;
        bottom: 20px;
        left: 20px;
        right: 20px;
        background: rgba(252, 251, 247, 0.97);
        backdrop-filter: blur(10px);
        border-radius: 16px;
        padding: 20px 24px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.12);
        border: 1px solid rgba(194, 74, 22, 0.1);
    }
    .map-overlay-card h4 {
        font-size: 16px;
        color: var(--primary-color);
        margin-bottom: 6px;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .map-overlay-card p {
        font-size: 13px;
        color: var(--text-light);
        margin-bottom: 12px;
    }
    .directions-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: var(--gradient-primary);
        color: var(--white);
        padding: 10px 22px;
        border-radius: 50px;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.3s ease;
        box-shadow: 0 4px 15px rgba(194, 74, 22, 0.3);
    }
    .directions-btn:hover {
        transform: translateY(-2px) scale(1.02);
        box-shadow: 0 6px 20px rgba(194, 74, 22, 0.4);
    }

    /* ============================================
       CTA
    ============================================ */
    .cta {
        background:
            linear-gradient(
                135deg,
                rgba(44, 44, 44, 0.85) 0%,
                rgba(194, 74, 22, 0.8) 100%
            ),
            url('{{ asset("Images/ground.jpeg") }}') center/cover no-repeat
                fixed;
        padding: 120px 20px;
        text-align: center;
        color: var(--white);
        position: relative;
        overflow: hidden;
    }
    .cta::before {
        content: "";
        position: absolute;
        inset: 0;
        background: url('{{ asset("Images/B1.png") }}') repeat;
        background-size: 80px auto;
        opacity: 0.05;
    }
    .cta::after {
        content: "";
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 600px;
        height: 600px;
        background: radial-gradient(
            circle,
            rgba(212, 168, 83, 0.15) 0%,
            transparent 70%
        );
        border-radius: 50%;
        animation: pulse 5s ease-in-out infinite;
    }
    .cta-content {
        position: relative;
        z-index: 1;
        max-width: 800px;
        margin: 0 auto;
    }
    .cta h2 {
        font-size: 44px;
        margin-bottom: 20px;
        color: var(--white);
        line-height: 1.3;
    }
    .cta p {
        font-size: 18px;
        margin-bottom: 40px;
        color: rgba(255, 255, 255, 0.9);
        line-height: 1.7;
    }
    .cta a {
        display: inline-block;
        background: var(--white);
        color: var(--primary-color);
        padding: 18px 50px;
        border-radius: 50px;
        text-decoration: none;
        font-size: 17px;
        font-weight: 600;
        transition: all 0.4s ease;
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.2);
        position: relative;
        overflow: hidden;
    }
    .cta a::before {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(
            90deg,
            transparent,
            rgba(212, 168, 83, 0.3),
            transparent
        );
        background-size: 200% 100%;
        animation: shimmer 3s infinite;
    }
    .cta a:hover {
        background: var(--accent-gold);
        color: var(--white);
        transform: translateY(-3px) scale(1.05);
        box-shadow: 0 12px 40px rgba(0, 0, 0, 0.3);
    }

    /* ============================================
       FOOTER
    ============================================ */
    footer {
        position: relative;
        background: linear-gradient(
            135deg,
            var(--primary-dark) 0%,
            var(--primary-color) 40%,
            #d4703a 70%,
            var(--primary-light) 100%
        );
        color: var(--white);
        padding: 80px 20px 40px;
        overflow: hidden;
    }
    footer::before {
        content: "";
        position: absolute;
        inset: 0;
        background: url('{{ asset("Images/B1.png") }}') repeat;
        background-size: 80px auto;
        opacity: 0.08;
        z-index: 0;
    }
    footer::after {
        content: "";
        position: absolute;
        top: -100px;
        right: -100px;
        width: 400px;
        height: 400px;
        background: radial-gradient(
            circle,
            rgba(212, 168, 83, 0.15) 0%,
            transparent 60%
        );
        border-radius: 50%;
        pointer-events: none;
        animation: float 12s ease-in-out infinite;
    }
    .footer-content {
        position: relative;
        z-index: 1;
        max-width: 1200px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 40px;
        text-align: left;
    }
    .footer-section h4 {
        color: var(--white);
        font-size: 20px;
        margin-bottom: 25px;
        position: relative;
        padding-bottom: 12px;
    }
    .footer-section h4::after {
        content: "";
        position: absolute;
        bottom: 0;
        left: 0;
        width: 40px;
        height: 2px;
        background: linear-gradient(135deg, var(--accent-gold), #fff8f0);
        border-radius: 2px;
    }
    .footer-section p,
    .footer-section a {
        color: rgba(255, 255, 255, 0.9);
        font-size: 15px;
        line-height: 1.8;
        text-decoration: none;
        transition: all 0.3s ease;
    }
    .footer-section a:hover {
        color: var(--accent-gold);
        padding-left: 5px;
    }
    .footer-section ul {
        list-style: none;
        padding: 0;
    }
    .footer-section ul li {
        margin-bottom: 12px;
    }
    .footer-section ul li a {
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .footer-section ul li a i {
        color: var(--accent-gold);
        width: 20px;
        transition: transform 0.3s ease;
    }
    .footer-section ul li a:hover i {
        transform: translateX(5px);
    }
    .footer-section .contact-item {
        display: flex;
        align-items: flex-start;
        gap: 15px;
        margin-bottom: 15px;
    }
    .footer-section .contact-item i {
        color: var(--accent-gold);
        font-size: 18px;
        margin-top: 3px;
    }
    .social-icons {
        display: flex;
        gap: 15px;
        margin-top: 20px;
    }
    .social-icons a {
        width: 48px;
        height: 48px;
        background: rgba(255, 255, 255, 0.15);
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--white);
        font-size: 18px;
        transition: all 0.3s ease;
        position: relative;
    }
    .social-icons a::before {
        content: "";
        position: absolute;
        inset: 0;
        background: var(--white);
        border-radius: 50%;
        opacity: 0;
        transition: opacity 0.3s ease;
        z-index: -1;
    }
    .social-icons a:hover::before {
        opacity: 1;
    }
    .social-icons a:hover {
        transform: translateY(-5px) scale(1.1);
        color: var(--primary-color);
        border-color: var(--white);
    }
    .footer-bottom {
        position: relative;
        z-index: 1;
        text-align: center;
        padding-top: 40px;
        margin-top: 40px;
        border-top: 1px solid rgba(255, 255, 255, 0.2);
    }
    .footer-bottom p {
        color: rgba(255, 255, 255, 0.8);
        font-size: 14px;
    }

    /* ============================================
       AUTH MODALS
    ============================================ */
    .modal {
        display: none;
        position: fixed;
        z-index: 2000;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.7);
        backdrop-filter: blur(8px);
        justify-content: center;
        align-items: center;
        opacity: 0;
        transition: opacity 0.4s ease;
    }
    .modal.show {
        display: flex;
        opacity: 1;
    }
    .modal-content {
        background: var(--white);
        padding: 50px 40px;
        border-radius: var(--border-radius-lg);
        width: 90%;
        max-width: 450px;
        text-align: center;
        position: relative;
        box-shadow: 0 25px 80px rgba(0, 0, 0, 0.3);
        animation: modalSlideIn 0.4s ease;
        overflow: hidden;
    }
    .modal-content::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 5px;
        background: var(--gradient-primary);
    }
    @keyframes modalSlideIn {
        from {
            transform: translateY(-50px) scale(0.9);
            opacity: 0;
        }
        to {
            transform: translateY(0) scale(1);
            opacity: 1;
        }
    }
    .modal-content .modal-logo {
        width: 70px;
        height: 70px;
        margin: 0 auto 25px;
        filter: drop-shadow(0 4px 10px rgba(194, 74, 22, 0.2));
    }
    .modal-content h2 {
        margin-bottom: 10px;
        font-size: 30px;
    }
    .modal-content .modal-subtitle {
        color: var(--text-light);
        font-size: 15px;
        margin-bottom: 30px;
    }
    .modal-perks-hint {
        background: linear-gradient(
            135deg,
            rgba(194, 74, 22, 0.05),
            rgba(212, 168, 83, 0.07)
        );
        border: 1px solid rgba(194, 74, 22, 0.12);
        border-radius: 14px;
        padding: 16px 18px;
        margin-bottom: 24px;
        display: flex;
        align-items: center;
        gap: 14px;
        text-align: left;
    }
    .modal-perks-hint i {
        color: var(--accent-gold);
        font-size: 22px;
        flex-shrink: 0;
    }
    .modal-perks-hint p {
        font-size: 13px;
        color: var(--text-light);
        line-height: 1.5;
        margin: 0;
    }
    .modal-perks-hint p strong {
        color: var(--primary-color);
    }
    .modal-content form {
        display: flex;
        flex-direction: column;
        gap: 18px;
        position: relative;
        z-index: 1;
    }
    .input-group {
        position: relative;
    }
    .input-group i {
        position: absolute;
        left: 18px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--text-light);
        font-size: 16px;
        transition: color 0.3s ease;
    }
    .modal-content input {
        width: 100%;
        padding: 16px 18px 16px 50px;
        border-radius: 14px;
        border: 2px solid #eee;
        font-size: 15px;
        transition: all 0.3s ease;
        background: #fafafa;
    }
    .modal-content input:focus {
        border-color: var(--primary-color);
        background: var(--white);
        box-shadow: 0 0 0 4px rgba(194, 74, 22, 0.1);
        outline: none;
    }
    .input-group:focus-within i {
        color: var(--primary-color);
    }
    .modal-content button {
        width: 100%;
        padding: 16px;
        background: var(--gradient-primary);
        color: var(--white);
        border: none;
        border-radius: 14px;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        box-shadow: 0 4px 15px rgba(194, 74, 22, 0.3);
        margin-top: 10px;
    }
    .modal-content button:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 25px rgba(194, 74, 22, 0.4);
    }
    .modal-close {
        position: absolute;
        top: 20px;
        right: 25px;
        font-size: 28px;
        cursor: pointer;
        color: #ccc;
        transition: all 0.3s ease;
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        z-index: 2;
    }
    .modal-close:hover {
        color: var(--primary-color);
        background: rgba(194, 74, 22, 0.1);
        transform: rotate(90deg);
    }
    .modal-content .switch {
        margin-top: 25px;
        font-size: 14px;
        color: var(--text-light);
        position: relative;
        z-index: 1;
    }
    .modal-content .switch a {
        color: var(--primary-color);
        font-weight: 600;
        cursor: pointer;
        text-decoration: none;
    }
    .divider {
        display: flex;
        align-items: center;
        margin: 25px 0;
        color: var(--text-light);
        font-size: 13px;
        position: relative;
        z-index: 1;
    }
    .divider::before,
    .divider::after {
        content: "";
        flex: 1;
        height: 1px;
        background: linear-gradient(90deg, transparent, #eee, transparent);
    }
    .divider span {
        padding: 0 15px;
    }
    .social-login {
        display: flex;
        gap: 15px;
        justify-content: center;
        position: relative;
        z-index: 1;
    }
    .social-login a {
        width: 54px;
        height: 54px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        transition: all 0.3s ease;
        text-decoration: none;
    }
    .social-login .google {
        background: #f5f5f5;
        color: #db4437;
    }
    .social-login .facebook {
        background: #f5f5f5;
        color: #4267b2;
    }
    .social-login a:hover {
        transform: translateY(-3px) scale(1.05);
        box-shadow: 0 5px 20px rgba(0, 0, 0, 0.12);
    }

    /* ============================================
       RESPONSIVE
    ============================================ */
    @media (max-width: 1024px) {
        .navbar {
            padding: 15px 30px;
        }
        .hero h1 {
            font-size: 44px;
        }
        .section-header h2 {
            font-size: 36px;
        }
        .member-exclusive-inner {
            grid-template-columns: 1fr;
        }
        .contact-container {
            grid-template-columns: 1fr;
        }
        .service-modal-header {
            padding: 40px 30px 25px;
        }
        .service-modal-body {
            padding: 30px;
        }
    }

    @media (max-width: 768px) {
        .navbar {
            padding: 12px 20px;
        }
        .navbar .logo {
            font-size: 20px;
        }
        .navbar .logo img {
            height: 45px;
        }
        .menu-toggle {
            display: flex;
        }
        .navbar nav {
            position: fixed;
            top: 0;
            right: -100%;
            width: 280px;
            height: 100vh;
            background: var(--white);
            box-shadow: -5px 0 30px rgba(0, 0, 0, 0.1);
            transition: right 0.4s ease;
            padding: 80px 30px 30px;
        }
        .navbar nav.active {
            right: 0;
        }
        .navbar ul {
            flex-direction: column;
            gap: 5px;
            align-items: stretch;
        }
        .navbar ul li a {
            padding: 15px 20px;
            border-radius: 10px;
            font-size: 16px;
        }
        .navbar ul li .signin-btn {
            margin: 20px 0 0 0;
            text-align: center;
        }
        .hero {
            padding: 100px 20px 60px;
        }
        .hero h1 {
            font-size: 36px;
        }
        .hero-buttons {
            flex-direction: column;
            gap: 15px;
        }
        .hero .btn {
            width: 100%;
            max-width: 280px;
        }
        .hero-trust {
            gap: 12px;
        }
        .trust-badge {
            font-size: 13px;
            padding: 8px 14px;
        }
        .hero-decor {
            display: none;
        }
        .perks-inner {
            flex-direction: column;
            align-items: flex-start;
            gap: 16px;
        }
        .perks-divider {
            display: none;
        }
        .perks-cta {
            margin-left: 0;
        }
        section {
            padding: 70px 20px;
        }
        .about {
            padding-bottom: 110px;
        }
        .experiences {
            padding-bottom: 110px;
        }
        .services {
            padding-bottom: 110px;
        }
        .member-exclusive {
            padding-bottom: 170px;
        }
        .contact {
            padding-bottom: 120px;
        }
        .section-header h2 {
            font-size: 32px;
        }
        .cta h2 {
            font-size: 32px;
        }
        .footer-content {
            text-align: center;
        }
        .footer-section h4::after {
            left: 50%;
            transform: translateX(-50%);
        }
        .social-icons {
            justify-content: center;
        }
        .modal-content {
            padding: 40px 25px;
            margin: 20px;
        }
        .member-left,
        .member-right {
            padding: 40px 30px;
        }
        .contact-item:hover {
            transform: none;
        }
        .services .corner-decor {
            display: none;
        }
        .service-modal-content {
            width: 98%;
        }
        .service-modal-header {
            padding: 35px 25px 20px;
        }
        .service-modal-header h2 {
            font-size: 24px;
        }
        .service-modal-body {
            padding: 25px 20px 30px;
        }
        .sample-services-grid {
            grid-template-columns: 1fr;
        }
        .service-modal-notice {
            flex-direction: column;
            text-align: center;
            gap: 12px;
        }
        .service-modal-notice .notice-btn {
            margin-left: 0;
        }
        .sharewall-stats {
            gap: 15px;
        }
        .stat-item {
            padding: 15px 20px;
            min-width: 100px;
        }
        .stat-item .stat-number {
            font-size: 28px;
        }
        .review-feed {
            grid-template-columns: 1fr;
        }
        .review-actions {
            flex-wrap: wrap;
            gap: 8px;
        }
        .perks-strip::after,
        .about::after,
        .experiences::after,
        .services::after,
        .member-exclusive::after {
