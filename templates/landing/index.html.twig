        font-size: 12px;
        font-weight: 700;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        margin-bottom: 28px;
    }
    .service-modal-body .sample-label i {
        color: var(--accent-gold);
    }
    .sample-services-grid {
        display: grid;
