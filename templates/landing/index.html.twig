        margin-bottom: 16px;
    }
    .member-left h2 em {
        color: var(--accent-gold);
        font-style: italic;
    }
    .member-left p {
        color: rgba(255, 255, 255, 0.85);
        font-size: 15px;
        line-height: 1.7;
        margin-bottom: 32px;
    }
    .member-actions {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }
    .btn-create-account {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        background: var(--white);
        color: var(--primary-color);
        padding: 16px 36px;
        border-radius: 50px;
        font-size: 15px;
        font-weight: 700;
        cursor: pointer;
        border: none;
        transition: all 0.3s ease;
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.15);
        text-decoration: none;
        position: relative;
        overflow: hidden;
    }
    .btn-create-account:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
        background: var(--accent-cream);
    }
    .btn-signin-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        color: rgba(255, 255, 255, 0.8);
        font-size: 14px;
        cursor: pointer;
        transition: color 0.3s ease;
        background: none;
        border: none;
        text-decoration: none;
    }
    .btn-signin-link:hover {
        color: var(--accent-gold);
    }
    .btn-signin-link i {
        font-size: 12px;
        transition: transform 0.3s ease;
    }
    .btn-signin-link:hover i {
        transform: translateX(5px);
    }
    .member-right {
        padding: 60px 50px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        background: linear-gradient(
            180deg,
            var(--white) 0%,
            var(--accent-cream) 100%
        );
    }
    .member-right h3 {
        font-size: 22px;
        color: var(--text-dark);
        margin-bottom: 8px;
    }
    .member-right > p {
        color: var(--text-light);
        font-size: 14px;
        margin-bottom: 32px;
    }
