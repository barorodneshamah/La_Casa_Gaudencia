        gap: 24px;
    }
    .sample-service-card {
        background: var(--white);
        border-radius: 18px;
        border: 1px solid rgba(0, 0, 0, 0.08);
        overflow: hidden;
        transition: all 0.4s ease;
        box-shadow: 0 2px 12px rgba(0, 0, 0, 0.06);
    }
    .sample-service-card:hover {
