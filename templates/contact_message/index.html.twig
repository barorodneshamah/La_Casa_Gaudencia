    </div>
</div>

<!-- TOPBAR -->
<div class="topbar">
    <div class="topbar-left">Contact Messages</div>
    <div class="topbar-right">
        <div class="datetime-display">
            <div class="time" id="currentTime">00:00 AM</div>
            <div class="date" id="currentDate">Loading...</div>
        </div>
    </div>
</div>

<!-- MAIN CONTENT -->
<div class="main-content">

    <!-- PAGE HEADER -->
    <div class="page-header">
        <h2 class="section-title">
            <i class="fas fa-envelope"></i> Contact Messages
        </h2>
    </div>

    <!-- FLASH MESSAGES -->
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }}">
                <i class="fas fa-{{ label == 'success' ? 'check-circle' : (label == 'warning' ? 'exclamation-triangle' : 'times-circle') }}"></i>
                {{ message }}
                <button type="button" class="btn-close" onclick="this.parentElement.remove()">×</button>
            </div>
        {% endfor %}
    {% endfor %}

    <!-- FILTER TABS -->
    <div class="filter-tabs">
        <a href="{{ path('app_contact_message_index') }}" class="filter-tab {{ currentStatus == 'all' ? 'active' : '' }}">
            <i class="fas fa-list"></i> All
            <span class="count">{{ stats.total }}</span>
        </a>
        <a href="{{ path('app_contact_message_index', {status: 'unread'}) }}" class="filter-tab {{ currentStatus == 'unread' ? 'active' : '' }}">
            <i class="fas fa-envelope"></i> Unread
            <span class="count">{{ stats.unread }}</span>
        </a>
        <a href="{{ path('app_contact_message_index', {status: 'read'}) }}" class="filter-tab {{ currentStatus == 'read' ? 'active' : '' }}">
            <i class="fas fa-envelope-open"></i> Read
            <span class="count">{{ stats.read }}</span>
        </a>
        <a href="{{ path('app_contact_message_index', {status: 'replied'}) }}" class="filter-tab {{ currentStatus == 'replied' ? 'active' : '' }}">
            <i class="fas fa-reply"></i> Replied
            <span class="count">{{ stats.replied }}</span>
        </a>
        <a href="{{ path('app_contact_message_index', {status: 'archived'}) }}" class="filter-tab {{ currentStatus == 'archived' ? 'active' : '' }}">
            <i class="fas fa-archive"></i> Archived
            <span class="count">{{ stats.archived }}</span>
        </a>
    </div>

    <!-- TABLE CONTAINER -->
    <div class="table-container">

        <!-- TABLE HEADER INFO -->
        <div class="table-header-info">
            <div class="info-left">
                <div class="info-icon">
                    <i class="fas fa-inbox"></i>
                </div>
                <div class="info-text">
                    <h3>{{ currentStatus|capitalize }} Messages</h3>
                    <p>View and respond to guest inquiries</p>
                </div>
            </div>
            <div class="info-stats">
                <div class="stat-item">
                    <div class="stat-number">{{ messages|length }}</div>
                    <div class="stat-label">Total</div>
                </div>
                {% if stats.unread > 0 %}
                <div class="stat-item">
                    <div class="stat-number" style="color: #ef6c00;">{{ stats.unread }}</div>
                    <div class="stat-label">Unread</div>
                </div>
                {% endif %}
            </div>
        </div>

        <!-- DATATABLE WRAPPER -->
        <div class="datatable-wrapper">
            {% if messages|length > 0 %}
            <table id="messagesTable" class="display" style="width:100%">
                <thead>
                    <tr>
                        <th>Sender</th>
                        <th>Subject</th>
                        <th>Message</th>
                        <th>Status</th>
                        <th>Date</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for msg in messages %}
                    <tr class="{{ msg.status == 'unread' ? 'row-unread' : '' }}">

                        <!-- SENDER -->
                        <td>
                            <div class="sender-info">
                                <div class="sender-avatar">
                                    {{ msg.fullName|first|upper }}
                                </div>
                                <div class="sender-details">
                                    <div class="name">{{ msg.fullName }}</div>
                                    <div class="email">{{ msg.email }}</div>
                                </div>
                            </div>
                        </td>

                        <!-- SUBJECT -->
                        <td>
                            <span class="subject-cell">{{ msg.subject }}</span>
                        </td>

                        <!-- MESSAGE PREVIEW -->
                        <td>
                            <span class="message-preview">
                                {{ msg.message|slice(0, 70) }}{% if msg.message|length > 70 %}…{% endif %}
                            </span>
                        </td>

                        <!-- STATUS -->
                        <td>
                            {% set statusLower = msg.status|lower %}
                            <span class="status-badge {{ statusLower }}">
                                <i class="fas fa-{{ statusLower == 'unread' ? 'circle' : (statusLower == 'read' ? 'envelope-open' : (statusLower == 'replied' ? 'reply' : 'archive')) }}" style="{{ statusLower == 'unread' ? 'font-size:7px' : '' }}"></i>
                                {{ msg.status|upper }}
                            </span>
                        </td>

                        <!-- DATE -->
                        <td>
                            <div class="date-cell">
                                <span class="date">{{ msg.createdAt|date('M d, Y') }}</span>
                                <span class="time">{{ msg.createdAt|date('h:i A') }}</span>
                            </div>
                        </td>

                        <!-- ACTIONS -->
                        <td>
                            <div class="action-buttons">
                                <a href="{{ path('app_contact_message_show', {id: msg.id}) }}"
                                   class="btn-action btn-view"
                                   title="View Message">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <form method="post"
                                      action="{{ path('app_contact_message_delete', {id: msg.id}) }}"
                                      style="display:inline"
                                      onsubmit="return confirm('Delete this message?')">
                                    <button type="submit" class="btn-action btn-delete" title="Delete">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
            {% else %}
            <!-- EMPTY STATE -->
            <div class="empty-state">
                <i class="fas fa-inbox"></i>
                <h4>No Messages Found</h4>
                <p>There are no messages matching your filter criteria.</p>
            </div>
            {% endif %}
        </div>
    </div>

</div>

{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src="/jquery/jquery-3.7.1.min.js"></script>
<script src="/datatables/datatables.min.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
    function updateDateTime() {
        const now = new Date();
        const timeEl = document.getElementById('currentTime');
        const dateEl = document.getElementById('currentDate');
        if (timeEl && dateEl) {
            timeEl.textContent = now.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', hour12: true });
            dateEl.textContent = now.toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric' });
        }
    }
    updateDateTime();
    setInterval(updateDateTime, 1000);
});

$(document).ready(function() {
    $('#messagesTable').DataTable({
        columnDefs: [
            { "defaultContent": "-", "targets": "_all" },
            { "orderable": false, "targets": [5] }
        ],
        order: [[4, 'desc']],
        pageLength: 10,
        lengthMenu: [[10, 25, 50, -1], [10, 25, 50, "All"]],
        language: {
            search: "_INPUT_",
            searchPlaceholder: "Search messages...",
            lengthMenu: "Show _MENU_ messages",
            info: "Showing &nbsp;<b>_START_</b>&nbsp; to &nbsp;<b>_END_</b>&nbsp; of &nbsp;<b>_TOTAL_</b>&nbsp; messages",
            infoEmpty: "No messages available",
            paginate: {
                next: '<i class="fas fa-chevron-right"></i>',
                previous: '<i class="fas fa-chevron-left"></i>'
            }
        },
        dom: '<"datatable-top-controls"<"dt-length"l><"dt-search"f>>rt<"datatable-bottom-controls"<"dt-info"i><"dt-pagination"p>>',
        drawCallback: function() {
            $(this.api().table().body()).find('tr').each(function(index) {
                $(this).css({ 'opacity': '0', 'transform': 'translateY(15px)' })
                    .delay(30 * index)
                    .animate({ 'opacity': '1' }, 200)
                    .css('transform', 'translateY(0)');
            });
        }
    });
});
</script>
{% endblock %}
