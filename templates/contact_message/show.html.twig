    <div class="sidebar-logout">
        <a href="{{ path('app_logout') }}" class="logout-btn">Log Out</a>
    </div>
</div>

<!-- TOPBAR -->
<div class="topbar">
    <div class="topbar-left">Message Details</div>
    <div class="topbar-right">
        <div class="datetime-display">
            <div class="time" id="currentTime">00:00 AM</div>
            <div class="date" id="currentDate">Loading...</div>
        </div>
    </div>
</div>

<!-- MAIN CONTENT -->
<div class="main-content">
    <a href="{{ path('app_contact_message_index') }}" class="back-link">
        <i class="fas fa-arrow-left"></i> Back to Messages
    </a>

    <!-- FLASH MESSAGES -->
    {% for label, messages in app.flashes %}
        {% for msg in messages %}
            <div class="alert alert-{{ label }}">
                <i class="fas fa-{{ label == 'success' ? 'check-circle' : 'exclamation-circle' }}"></i>
                {{ msg }}
                <button type="button" class="btn-close" onclick="this.parentElement.remove()">×</button>
            </div>
        {% endfor %}
    {% endfor %}

    <div class="view-grid">

        <!-- LEFT COLUMN -->
        <div class="main-column">

            <!-- Original Message Card -->
            <div class="main-card">
                <div class="card-header">
                    <div class="header-top">
                        <div class="sender-info">
                            <div class="sender-avatar">{{ message.fullName|slice(0,1)|upper }}</div>
                            <div class="sender-details">
                                <h2>{{ message.fullName }}</h2>
                                <div class="sender-contact">
                                    <span><i class="fas fa-envelope"></i> {{ message.email }}</span>
                                    {% if message.phone %}
                                    <span><i class="fas fa-phone"></i> {{ message.phone }}</span>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                        <span class="status-badge status-{{ message.status }}">{{ message.status }}</span>
                    </div>
                    <div class="meta-row">
                        <div class="meta-item">
                            <i class="fas fa-calendar"></i>
                            {{ message.createdAt|date('F d, Y — h:i A') }}
                        </div>
                        {% if message.readAt %}
                        <div class="meta-item">
                            <i class="fas fa-eye"></i>
                            Read: {{ message.readAt|date('M d, h:i A') }}
                        </div>
                        {% endif %}
                        {% if message.ipAddress %}
                        <div class="meta-item">
                            <i class="fas fa-globe"></i>
                            IP: {{ message.ipAddress }}
                        </div>
                        {% endif %}
                    </div>
                </div>

                <div class="card-body">
                    <p class="subject-line">Subject: {{ message.subject }}</p>
                    <div class="message-content">{{ message.message }}</div>
                </div>

                <div class="card-actions">
                    {% if message.phone %}
                    <a href="tel:{{ message.phone }}" class="btn-action btn-call">
                        <i class="fas fa-phone"></i> Call
                    </a>
                    {% endif %}
                    <form method="post" action="{{ path('app_contact_message_delete', {id: message.id}) }}"
                          onsubmit="return confirm('Delete this message permanently?')" style="display:inline">
                        <button type="submit" class="btn-action btn-del">
                            <i class="fas fa-trash"></i> Delete
                        </button>
                    </form>
                </div>
            </div>

            <!-- Reply Box -->
            <div class="reply-box">
                <div class="reply-box-header">
                    <i class="fas fa-reply-all"></i>
                    Reply Thread
                    {% if message.replies|length > 0 %}
                        <span class="reply-count">{{ message.replies|length }} repl{{ message.replies|length > 1 ? 'ies' : 'y' }}</span>
                    {% endif %}
                </div>

                <!-- Existing Replies -->
                {% if message.replies|length > 0 %}
                    <div class="reply-thread">
                        {% for reply in message.replies %}
                        <div class="reply-item">
                            <div class="reply-meta">
                                <span class="reply-author">
                                    <i class="fas fa-user-shield"></i>
                                    {% if reply.repliedBy is not null %}
                                        {{ reply.repliedBy.firstName ?? reply.repliedBy.email }}
                                    {% else %}
                                        Staff
                                    {% endif %}
                                </span>
                                <span class="reply-date">
                                    <i class="fas fa-clock"></i>
                                    {{ reply.createdAt|date('M d, Y — h:i A') }}
                                </span>
                            </div>
                            <div class="reply-text">{{ reply.replyMessage }}</div>
                        </div>
                        {% endfor %}
                    </div>
                {% else %}
                    <p class="no-replies">
                        <i class="fas fa-comment-slash"></i>
                        No replies yet. Be the first to respond.
                    </p>
                {% endif %}

                <!-- New Reply Form -->
                <form method="post" action="{{ path('app_contact_message_reply', {id: message.id}) }}" class="reply-form">
                    <label for="reply_message">
                        <i class="fas fa-pen"></i> Write a Reply
                    </label>
                    <textarea
                        id="reply_message"
                        name="reply_message"
                        class="reply-textarea"
                        placeholder="Type your reply here... It will be saved to the database and sent via email to {{ message.email }}"
                        required
                    ></textarea>
                    <div class="reply-form-footer">
                        <span class="reply-hint">
                            <i class="fas fa-paper-plane"></i>
                            Will be emailed to <strong>{{ message.email }}</strong>
                        </span>
                        <button type="submit" class="btn-send-reply">
                            <i class="fas fa-paper-plane"></i> Send Reply
                        </button>
                    </div>
                </form>
            </div>

        </div>

        <!-- RIGHT SIDEBAR -->
        <div class="sidebar-panel">

            <!-- Update Status -->
            <div class="side-card">
                <h3><i class="fas fa-tasks"></i> Update Status</h3>
                <form method="post" action="{{ path('app_contact_message_status', {id: message.id}) }}">
                    <div class="status-options">
                        <label class="status-option {{ message.status == 'unread' ? 'selected' : '' }}">
                            <input type="radio" name="status" value="unread" {{ message.status == 'unread' ? 'checked' : '' }}>
                            <span class="status-dot unread"></span>
                            <span>Unread</span>
                        </label>
                        <label class="status-option {{ message.status == 'read' ? 'selected' : '' }}">
                            <input type="radio" name="status" value="read" {{ message.status == 'read' ? 'checked' : '' }}>
                            <span class="status-dot read"></span>
                            <span>Read</span>
                        </label>
                        <label class="status-option {{ message.status == 'replied' ? 'selected' : '' }}">
                            <input type="radio" name="status" value="replied" {{ message.status == 'replied' ? 'checked' : '' }}>
                            <span class="status-dot replied"></span>
                            <span>Replied</span>
                        </label>
                        <label class="status-option {{ message.status == 'archived' ? 'selected' : '' }}">
                            <input type="radio" name="status" value="archived" {{ message.status == 'archived' ? 'checked' : '' }}>
                            <span class="status-dot archived"></span>
                            <span>Archived</span>
                        </label>
                    </div>
                    <button type="submit" class="btn-save">
                        <i class="fas fa-check"></i> Save Status
                    </button>
                </form>
            </div>

            <!-- Notes -->
            <div class="side-card">
                <h3><i class="fas fa-sticky-note"></i> Notes</h3>
                <form method="post" action="{{ path('app_contact_message_notes', {id: message.id}) }}">
                    <textarea name="notes" class="notes-textarea" placeholder="Add internal notes about this message...">{{ message.notes }}</textarea>
                    <button type="submit" class="btn-note">
                        <i class="fas fa-save"></i> Save Notes
                    </button>
                </form>
            </div>

            <!-- Details -->
            <div class="side-card">
                <h3><i class="fas fa-info-circle"></i> Details</h3>
                <div class="info-list">
                    <div class="info-item">
                        <span class="info-label">Message ID</span>
                        <span class="info-value">#{{ message.id }}</span>
                    </div>
                    <div class="info-item">
                        <span class="info-label">Received</span>
                        <span class="info-value">{{ message.createdAt|date('M d, Y') }}</span>
                    </div>
                    <div class="info-item">
                        <span class="info-label">Time</span>
                        <span class="info-value">{{ message.createdAt|date('h:i A') }}</span>
                    </div>
                    <div class="info-item">
                        <span class="info-label">Subject</span>
                        <span class="info-value">{{ message.subject }}</span>
                    </div>
                    <div class="info-item">
                        <span class="info-label">Replies</span>
                        <span class="info-value">{{ message.replies|length }}</span>
                    </div>
                    {% if message.ipAddress %}
                    <div class="info-item">
                        <span class="info-label">IP Address</span>
                        <span class="info-value">{{ message.ipAddress }}</span>
                    </div>
                    {% endif %}
                </div>
            </div>

        </div>

    </div>
</div>

{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
document.addEventListener('DOMContentLoaded', function() {
    // DateTime Update
    function updateDateTime() {
        const now = new Date();
        const timeEl = document.getElementById('currentTime');
        const dateEl = document.getElementById('currentDate');
        if (timeEl && dateEl) {
            timeEl.textContent = now.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', hour12: true });
            dateEl.textContent = now.toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric' });
        }
    }
    updateDateTime();
    setInterval(updateDateTime, 1000);

    // Status Radio Selection
    document.querySelectorAll('.status-option input').forEach(radio => {
        radio.addEventListener('change', function() {
            document.querySelectorAll('.status-option').forEach(opt => opt.classList.remove('selected'));
            this.closest('.status-option').classList.add('selected');
        });
    });
});
</script>
{% endblock %}