        <li>
            <a href="{{ path('app_payment_dashboard') }}">
                <svg viewBox="0 0 24 24"><path d="M2 6h20v2H2V6zm0 4h20v8H2v-8zm0 10h20v2H2v-2z"/></svg>
                Payments
            </a>
