{% extends 'base.html.twig' %}

{% block title %}Book a Service - La Casa Gaudencia{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<style>
:root { --brand: #c24a16; --brand-light: #e85d04; }
* { margin: 0; padding: 0; box-sizing: border-box; }
body { font-family: 'Poppins', sans-serif; background: #fdf8f4; color: #2f2f2f; min-height: 100vh; }

.topnav { background: #fff; border-bottom: 3px solid var(--brand); padding: 0 32px; display: flex; align-items: center; justify-content: space-between; height: 64px; position: sticky; top: 0; z-index: 100; box-shadow: 0 2px 12px rgba(194,74,22,.1); }
.topnav-logo { font-family: 'Playfair Display', serif; font-size: 1.3rem; font-weight: 700; color: var(--brand); text-decoration: none; }
.topnav-links { display: flex; align-items: center; gap: 8px; }
.nav-link { padding: 8px 16px; border-radius: 8px; text-decoration: none; font-size: .9rem; font-weight: 500; color: #555; transition: all .2s; }
.nav-link:hover, .nav-link.active { background: #fef0e8; color: var(--brand); }
.nav-avatar { width: 36px; height: 36px; border-radius: 50%; background: var(--brand); color: #fff; display: flex; align-items: center; justify-content: center; font-weight: 700; }
.nav-user { display: flex; align-items: center; gap: 8px; font-size: .9rem; font-weight: 500; color: #555; }

.page { max-width: 820px; margin: 0 auto; padding: 36px 24px 60px; }
.page-title { font-family: 'Playfair Display', serif; font-size: 1.8rem; margin-bottom: 6px; }
.page-subtitle { color: #888; font-size: .9rem; margin-bottom: 28px; }
.back-link { display: inline-flex; align-items: center; gap: 6px; color: #888; text-decoration: none; font-size: .9rem; margin-bottom: 20px; }
.back-link:hover { color: var(--brand); }

/* SECTION TABS */
.service-tabs { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 28px; }
.tab-btn { padding: 10px 18px; border-radius: 10px; border: 2px solid #e5e5e5; background: #fff; font-size: .88rem; font-weight: 600; cursor: pointer; transition: all .2s; color: #555; display: flex; align-items: center; gap: 6px; }
.tab-btn:hover { border-color: var(--brand); color: var(--brand); }
.tab-btn.selected { border-color: var(--brand); background: #fef0e8; color: var(--brand); }

/* SECTION PANEL */
.section-panel { background: #fff; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,.06); margin-bottom: 20px; overflow: hidden; }
.section-header { padding: 18px 24px; border-bottom: 1px solid #f5f5f5; display: flex; align-items: center; justify-content: space-between; cursor: pointer; user-select: none; }
.section-header h3 { font-size: 1rem; font-weight: 600; display: flex; align-items: center; gap: 10px; }
.section-header .toggle-icon { color: #aaa; transition: transform .25s; }
.section-body { padding: 24px; }
.section-body.collapsed { display: none; }

/* SERVICE CARDS */
.service-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 14px; margin-bottom: 16px; }
.service-card { border: 2px solid #e5e5e5; border-radius: 12px; overflow: hidden; cursor: pointer; transition: all .2s; background: #fff; }
.service-card:hover { border-color: var(--brand); transform: translateY(-2px); box-shadow: 0 6px 20px rgba(194,74,22,.12); }
.service-card.selected { border-color: var(--brand); background: #fef8f5; box-shadow: 0 4px 16px rgba(194,74,22,.15); }
.service-card img { width: 100%; height: 110px; object-fit: cover; }
.service-card-body { padding: 12px; }
.service-card-name { font-weight: 600; font-size: .88rem; margin-bottom: 4px; }
.service-card-price { color: var(--brand); font-weight: 700; font-size: .9rem; }
.service-card-detail { color: #888; font-size: .78rem; margin-top: 2px; }
.service-card-check { display: none; }
.service-card.selected .service-card-check { display: inline-block; color: var(--brand); margin-left: 4px; }

/* DATE / INPUT FIELDS */
.fields-row { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 14px; margin-top: 14px; }
.field { display: flex; flex-direction: column; gap: 5px; }
.field label { font-size: .82rem; font-weight: 600; color: #555; }
.field input, .field select, .field textarea { padding: 10px 14px; border: 2px solid #e5e5e5; border-radius: 10px; font-size: .9rem; font-family: 'Poppins', sans-serif; transition: border-color .2s; width: 100%; }
.field input:focus, .field select:focus, .field textarea:focus { outline: none; border-color: var(--brand); }
.field textarea { resize: vertical; min-height: 80px; }

/* FOOD ITEMS */
.food-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 12px; }
.food-item { border: 2px solid #e5e5e5; border-radius: 12px; padding: 14px; display: flex; align-items: center; gap: 12px; transition: border-color .2s; }
.food-item:has(input[type=checkbox]:checked) { border-color: var(--brand); background: #fef8f5; }
.food-img { width: 54px; height: 54px; border-radius: 8px; object-fit: cover; flex-shrink: 0; background: #f0f0f0; }
.food-info { flex: 1; min-width: 0; }
.food-name { font-weight: 600; font-size: .88rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.food-price { color: var(--brand); font-weight: 700; font-size: .85rem; }
.food-qty-wrap { display: flex; align-items: center; gap: 6px; margin-top: 6px; }
.food-qty-wrap input[type=number] { width: 56px; padding: 4px 8px; border: 2px solid #e0e0e0; border-radius: 6px; font-size: .85rem; text-align: center; }
.food-qty-wrap input[type=checkbox] { width: 18px; height: 18px; accent-color: var(--brand); cursor: pointer; }
.food-qty-wrap label { font-size: .8rem; color: #888; }

/* SUMMARY */
.summary-box { background: #fff; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,.06); padding: 24px; margin-top: 8px; border-top: 4px solid var(--brand); }
.summary-row { display: flex; justify-content: space-between; font-size: .9rem; padding: 6px 0; color: #555; }
.summary-total { display: flex; justify-content: space-between; font-size: 1.2rem; font-weight: 700; padding: 14px 0 0; border-top: 2px solid #f0f0f0; margin-top: 8px; }
.summary-total span:last-child { color: var(--brand); }

.btn-submit { width: 100%; background: var(--brand); color: #fff; border: none; padding: 16px; border-radius: 12px; font-size: 1.05rem; font-weight: 700; cursor: pointer; margin-top: 20px; transition: background .2s; display: flex; align-items: center; justify-content: center; gap: 10px; }
.btn-submit:hover { background: var(--brand-light); }
.btn-submit:disabled { background: #ccc; cursor: not-allowed; }

.no-items { color: #aaa; font-size: .9rem; text-align: center; padding: 20px; }
</style>
{% endblock %}

{% block body %}
<nav class="topnav">
    <a href="{{ path('app_landing') }}" class="topnav-logo">La Casa Gaudencia</a>
    <div class="topnav-links">
        <a href="{{ path('app_landing') }}" class="nav-link"><i class="fas fa-home"></i> Home</a>
        <a href="{{ path('guest_reservation_index') }}" class="nav-link"><i class="fas fa-calendar-alt"></i> My Reservations</a>
        <a href="{{ path('guest_reservation_book') }}" class="nav-link active"><i class="fas fa-plus"></i> Book Now</a>
    </div>
    <div class="nav-user">
        <div class="nav-avatar">{{ app.user.fullName|first|upper }}</div>
        <span>{{ app.user.fullName }}</span>
        <a href="{{ path('app_logout') }}" class="nav-link" style="color:#c0392b"><i class="fas fa-sign-out-alt"></i></a>
    </div>
</nav>

<div class="page">
    <a href="{{ path('guest_reservation_index') }}" class="back-link"><i class="fas fa-arrow-left"></i> My Reservations</a>
    <h1 class="page-title">Book a Service</h1>
    <p class="page-subtitle">Select the services you'd like. You can combine a room, tour, package, and food in one reservation.</p>

    <form method="post" action="{{ path('guest_reservation_book') }}" id="bookForm">

        {# ===== ROOM ===== #}
        <div class="section-panel">
            <div class="section-header" onclick="toggleSection(this)">
                <h3><i class="fas fa-bed" style="color:var(--brand)"></i> Room</h3>
                <i class="fas fa-chevron-down toggle-icon"></i>
            </div>
            <div class="section-body collapsed" id="sec-room">
                {% if rooms is empty %}
                    <p class="no-items">No rooms available at the moment.</p>
                {% else %}
                    <div class="service-grid">
                        {% for room in rooms %}
                        <div class="service-card" onclick="selectService('room', {{ room.id }}, {{ room.pricePerNight }}, '{{ room.roomType }}')" id="room-card-{{ room.id }}">
                            {% if room.mainImage %}
                                <img src="{{ asset('uploads/rooms/' ~ room.mainImage) }}" alt="{{ room.roomType }}">
                            {% else %}
                                <div style="height:110px;background:#f5f5f5;display:flex;align-items:center;justify-content:center;color:#ccc"><i class="fas fa-bed fa-2x"></i></div>
                            {% endif %}
                            <div class="service-card-body">
                                <div class="service-card-name">{{ room.roomType }} <span class="service-card-check"><i class="fas fa-check-circle"></i></span></div>
                                <div class="service-card-price">₱{{ room.pricePerNight|number_format(2) }}/night</div>
                                <div class="service-card-detail">Up to {{ room.capacity }} guests · Room #{{ room.roomNumber }}</div>
                            </div>
                        </div>
                        {% endfor %}
                    </div>
                    <input type="hidden" name="room_id" id="room_id" value="">
                    <div class="fields-row" id="room-dates" style="display:none">
                        <div class="field">
                            <label>Check-in Date</label>
                            <input type="date" name="check_in" id="check_in" min="{{ 'now'|date('Y-m-d') }}">
                        </div>
                        <div class="field">
                            <label>Check-out Date</label>
                            <input type="date" name="check_out" id="check_out" min="{{ 'now'|date('Y-m-d') }}">
                        </div>
                    </div>
                {% endif %}
            </div>
        </div>

        {# ===== TOUR ===== #}
        <div class="section-panel">
            <div class="section-header" onclick="toggleSection(this)">
                <h3><i class="fas fa-map-marked-alt" style="color:var(--brand)"></i> Tour</h3>
                <i class="fas fa-chevron-down toggle-icon"></i>
            </div>
            <div class="section-body collapsed" id="sec-tour">
                {% if tours is empty %}
                    <p class="no-items">No tours available at the moment.</p>
                {% else %}
                    <div class="service-grid">
                        {% for tour in tours %}
                        <div class="service-card" onclick="selectService('tour', {{ tour.id }}, {{ tour.price }}, '{{ tour.name }}')" id="tour-card-{{ tour.id }}">
                            {% if tour.mainImage %}
                                <img src="{{ asset('uploads/tours/' ~ tour.mainImage) }}" alt="{{ tour.name }}">
                            {% else %}
                                <div style="height:110px;background:#f5f5f5;display:flex;align-items:center;justify-content:center;color:#ccc"><i class="fas fa-map fa-2x"></i></div>
                            {% endif %}
                            <div class="service-card-body">
                                <div class="service-card-name">{{ tour.name }} <span class="service-card-check"><i class="fas fa-check-circle"></i></span></div>
                                <div class="service-card-price">₱{{ tour.price|number_format(2) }}/person</div>
                                <div class="service-card-detail">{{ tour.duration ?? '' }}</div>
                            </div>
                        </div>
                        {% endfor %}
                    </div>
                    <input type="hidden" name="tour_id" id="tour_id" value="">
                    <div class="fields-row" id="tour-fields" style="display:none">
                        <div class="field">
                            <label>Tour Date</label>
                            <input type="date" name="tour_date" id="tour_date" min="{{ 'now'|date('Y-m-d') }}">
                        </div>
                        <div class="field">
                            <label>Participants</label>
                            <input type="number" name="participants" id="participants" value="1" min="1" max="20">
                        </div>
                    </div>
                {% endif %}
            </div>
        </div>

        {# ===== PACKAGE ===== #}
        <div class="section-panel">
            <div class="section-header" onclick="toggleSection(this)">
                <h3><i class="fas fa-box-open" style="color:var(--brand)"></i> Package</h3>
                <i class="fas fa-chevron-down toggle-icon"></i>
            </div>
            <div class="section-body collapsed" id="sec-package">
                {% if packages is empty %}
                    <p class="no-items">No packages available at the moment.</p>
                {% else %}
                    <div class="service-grid">
                        {% for pkg in packages %}
                        <div class="service-card" onclick="selectService('package', {{ pkg.id }}, {{ pkg.packagePrice }}, '{{ pkg.name }}')" id="package-card-{{ pkg.id }}">
                            {% if pkg.mainImage %}
                                <img src="{{ asset('uploads/packages/' ~ pkg.mainImage) }}" alt="{{ pkg.name }}">
                            {% else %}
                                <div style="height:110px;background:#f5f5f5;display:flex;align-items:center;justify-content:center;color:#ccc"><i class="fas fa-box fa-2x"></i></div>
                            {% endif %}
                            <div class="service-card-body">
                                <div class="service-card-name">{{ pkg.name }} <span class="service-card-check"><i class="fas fa-check-circle"></i></span></div>
                                <div class="service-card-price">₱{{ pkg.packagePrice|number_format(2) }}</div>
                                <div class="service-card-detail">{{ pkg.description|slice(0, 60) }}{% if pkg.description|length > 60 %}…{% endif %}</div>
                            </div>
                        </div>
                        {% endfor %}
                    </div>
                    <input type="hidden" name="package_id" id="package_id" value="">
                {% endif %}
            </div>
        </div>

        {# ===== FOOD ===== #}
        <div class="section-panel">
            <div class="section-header" onclick="toggleSection(this)">
                <h3><i class="fas fa-utensils" style="color:var(--brand)"></i> Food &amp; Dining</h3>
                <i class="fas fa-chevron-down toggle-icon"></i>
            </div>
            <div class="section-body collapsed" id="sec-food">
                {% if foods is empty %}
                    <p class="no-items">No food items available at the moment.</p>
                {% else %}
                    <div class="food-grid">
                        {% for food in foods %}
                        <div class="food-item">
                            {% if food.mainImage %}
                                <img src="{{ asset('uploads/foods/' ~ food.mainImage) }}" alt="{{ food.name }}" class="food-img">
                            {% else %}
                                <div class="food-img" style="display:flex;align-items:center;justify-content:center;color:#ccc"><i class="fas fa-utensils"></i></div>
                            {% endif %}
                            <div class="food-info">
                                <div class="food-name">{{ food.name }}</div>
                                <div class="food-price">₱{{ food.price|number_format(2) }}</div>
                                <div class="food-qty-wrap">
                                    <input type="checkbox" name="food_ids[]" value="{{ food.id }}" id="food-{{ food.id }}" onchange="updateFoodSummary()">
                                    <label for="food-{{ food.id }}">Add</label>
                                    <input type="number" name="food_qtys[]" id="qty-{{ food.id }}" value="1" min="1" max="20"
                                           data-price="{{ food.price }}" data-food-id="{{ food.id }}"
                                           style="display:none" oninput="updateFoodSummary()">
                                </div>
                            </div>
                        </div>
                        {% endfor %}
                    </div>
                {% endif %}
            </div>
        </div>

        {# ===== CONTACT ===== #}
        <div class="section-panel">
            <div class="section-header" onclick="toggleSection(this)" style="cursor:default">
                <h3><i class="fas fa-user" style="color:var(--brand)"></i> Contact &amp; Details</h3>
            </div>
            <div class="section-body" id="sec-contact">
                <div class="fields-row">
                    <div class="field">
                        <label>Phone Number *</label>
                        <input type="tel" name="phone" placeholder="+63 9XX XXX XXXX" required>
                    </div>
                    <div class="field">
                        <label>Number of Guests *</label>
                        <input type="number" name="guests" value="1" min="1" max="50" required>
                    </div>
                </div>
                <div class="field" style="margin-top:14px">
                    <label>Special Requests</label>
                    <textarea name="requests" placeholder="Any special requirements, dietary needs, accessibility needs..."></textarea>
                </div>
            </div>
        </div>

        {# ===== SUMMARY ===== #}
        <div class="summary-box">
            <div style="font-weight:700;font-size:1rem;margin-bottom:12px"><i class="fas fa-receipt" style="color:var(--brand)"></i> Order Summary</div>
            <div id="summary-lines">
                <p style="color:#aaa;font-size:.88rem">Select services above to see a summary.</p>
            </div>
            <div class="summary-total">
                <span>Estimated Total</span>
                <span id="summary-total">₱0.00</span>
            </div>
            <button type="submit" class="btn-submit" id="submitBtn">
                <i class="fas fa-concierge-bell"></i> Submit Reservation
            </button>
        </div>

    </form>
</div>

{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
const prices = {};
const selected = { room: null, tour: null, package: null };
let tourParticipants = 1;
let roomNights = 0;

function toggleSection(header) {
    const body = header.nextElementSibling;
    const icon = header.querySelector('.toggle-icon');
    const collapsed = body.classList.toggle('collapsed');
    icon.style.transform = collapsed ? '' : 'rotate(180deg)';
}

function selectService(type, id, price, name) {
    if (selected[type] === id) {
        // deselect
        document.getElementById(type + '-card-' + id).classList.remove('selected');
        selected[type] = null;
        prices[type] = 0;
        document.getElementById(type + '_id').value = '';
        if (type === 'room') document.getElementById('room-dates').style.display = 'none';
        if (type === 'tour') document.getElementById('tour-fields').style.display = 'none';
    } else {
        // deselect previous
        if (selected[type]) {
            document.getElementById(type + '-card-' + selected[type])?.classList.remove('selected');
        }
        selected[type] = id;
        prices[type + '_base'] = parseFloat(price);
        document.getElementById(type + '_id').value = id;
        document.getElementById(type + '-card-' + id).classList.add('selected');
        if (type === 'room') {
            document.getElementById('room-dates').style.display = 'grid';
            calcRoomPrice();
        }
        if (type === 'tour') {
            document.getElementById('tour-fields').style.display = 'grid';
            calcTourPrice();
        }
        if (type === 'package') {
            prices['package'] = parseFloat(price);
        }
    }
    updateSummary();
}

function calcRoomPrice() {
    const ci = document.getElementById('check_in').value;
    const co = document.getElementById('check_out').value;
    if (ci && co) {
        const nights = Math.max(1, (new Date(co) - new Date(ci)) / 86400000);
        roomNights = nights;
        prices['room'] = (prices['room_base'] || 0) * nights;
    } else {
        prices['room'] = prices['room_base'] || 0;
    }
    updateSummary();
}

function calcTourPrice() {
    const p = parseInt(document.getElementById('participants')?.value) || 1;
    tourParticipants = p;
    prices['tour'] = (prices['tour_base'] || 0) * p;
    updateSummary();
}

function updateFoodSummary() {
    let total = 0;
    document.querySelectorAll('input[name="food_ids[]"]:checked').forEach(cb => {
        const foodId = cb.value;
        const qtyInput = document.getElementById('qty-' + foodId);
        qtyInput.style.display = 'inline-block';
        const qty = parseInt(qtyInput.value) || 1;
        const price = parseFloat(qtyInput.dataset.price) || 0;
        total += price * qty;
    });
    document.querySelectorAll('input[name="food_ids[]"]:not(:checked)').forEach(cb => {
        const qtyInput = document.getElementById('qty-' + cb.value);
        if (qtyInput) qtyInput.style.display = 'none';
    });
    prices['food'] = total;
    updateSummary();
}

function updateSummary() {
    const lines = document.getElementById('summary-lines');
    let html = '';
    let grandTotal = 0;

    if (selected.room) {
        const p = prices['room'] || prices['room_base'] || 0;
        const nights = roomNights || 1;
        html += `<div class="summary-row"><span><i class="fas fa-bed"></i> Room (${nights} night${nights>1?'s':''})</span><span>₱${p.toFixed(2)}</span></div>`;
        grandTotal += p;
    }
    if (selected.tour) {
        const p = prices['tour'] || prices['tour_base'] || 0;
        html += `<div class="summary-row"><span><i class="fas fa-map-marked-alt"></i> Tour × ${tourParticipants}</span><span>₱${p.toFixed(2)}</span></div>`;
        grandTotal += p;
    }
    if (selected.package) {
        const p = prices['package'] || 0;
        html += `<div class="summary-row"><span><i class="fas fa-box-open"></i> Package</span><span>₱${p.toFixed(2)}</span></div>`;
        grandTotal += p;
    }
    if ((prices['food'] || 0) > 0) {
        html += `<div class="summary-row"><span><i class="fas fa-utensils"></i> Food items</span><span>₱${(prices['food']).toFixed(2)}</span></div>`;
        grandTotal += prices['food'];
    }

    lines.innerHTML = html || '<p style="color:#aaa;font-size:.88rem">Select services above.</p>';
    document.getElementById('summary-total').textContent = '₱' + grandTotal.toFixed(2);
}

// Recalculate when dates or participants change
document.getElementById('check_in')?.addEventListener('change', calcRoomPrice);
document.getElementById('check_out')?.addEventListener('change', calcRoomPrice);
document.getElementById('participants')?.addEventListener('input', calcTourPrice);

// Expand contact section by default
document.getElementById('sec-contact').classList.remove('collapsed');
</script>
{% endblock %}
