{% extends 'base.html.twig' %}

{% block title %}Edit Spa | La Casa Gaudencia{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&family=Roboto:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<style>
:root {
    --brand-primary: #c24a16;
    --brand-cream: #fcfbf7;
    --brand-text: #2f2f2f;
    --brand-text-muted: #888888;
    --font-heading: 'Playfair Display', serif;
    --font-body: 'Roboto', sans-serif;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: var(--font-body);
    color: var(--brand-text);
    background-image:
        linear-gradient(rgba(255,252,236,.78), rgba(242,236,208,.78)),
        url('{{ asset("images/ground.jpeg") }}');
    background-repeat: no-repeat;
    background-position: center;
    background-size: cover;
    background-attachment: fixed;
}

.sidebar-accent {
    position: fixed;
    top: 0;
    left: 0;
    width: 8px;
    height: 100vh;
    background: var(--brand-primary);
    border-radius: 0 6px 6px 0;
    box-shadow: 2px 0 8px rgba(0,0,0,.15);
    z-index: 30;
}

.sidebar {
    position: fixed;
    top: 0;
    left: 8px;
    width: 260px;
    height: 100vh;
    background: #fff;
    box-shadow: 0 8px 28px rgba(0,0,0,.08);
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 28px;
    border-radius: 0 12px 12px 0;
    z-index: 20;
}

.brand {
    text-align: center;
    margin-bottom: 30px;
}

.brand img {
    width: 75px;
    height: 75px;
    margin-bottom: 8px;
    filter: drop-shadow(0 3px 6px rgba(0,0,0,.15));
}

.brand h1 {
    font-family: var(--font-heading);
    color: var(--brand-primary);
    font-size: 22px;
    margin: 0;
    font-weight: 600;
}

.brand small {
    color: #777;
    font-size: 12px;
    letter-spacing: .75px;
    font-weight: 500;
}

.sidebar-separator {
    width: 75%;
    height: 1.5px;
    background: linear-gradient(to right, transparent, #d1d1d1, transparent);
    margin: 10px 0 15px;
}

.sidebar ul {
    list-style: none;
    width: 100%;
    padding: 0;
}

.sidebar ul li a {
    display: flex;
    gap: 14px;
    align-items: center;
    padding: 14px 35px;
    font-size: 15px;
    font-weight: 500;
    color: #2f2f2f;
    text-decoration: none;
    transition: .25s;
}

.sidebar ul li svg {
    width: 20px;
    height: 20px;
    fill: #888;
    transition: .25s;
}

.sidebar ul li a:hover,
.sidebar ul li.active a {
    background: var(--brand-primary);
    color: #fff;
    margin-left: -12px;
    border-radius: 0 30px 30px 0;
    padding-left: 48px;
    box-shadow: 0 4px 12px rgba(194,74,22,.25);
}

.sidebar ul li a:hover svg,
.sidebar ul li.active a svg {
    fill: #fff !important;
}

.sidebar-logout {
    width: 100%;
    padding: 20px 30px;
    margin-top: auto;
    display: flex;
    justify-content: center;
    border-top: 1px solid #eee;
}

.logout-btn {
    display: flex;
    justify-content: center;
    width: 80%;
    padding: 14px 24px;
    background: linear-gradient(135deg, #c24a16, #e85d04);
    color: #fff;
    text-decoration: none;
    border-radius: 12px;
    font-size: 15px;
    font-weight: 600;
    box-shadow: 0 4px 15px rgba(194,74,22,.3);
}

@keyframes topbarShift {
    0% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
}

.topbar {
    margin-left: 268px;
    height: 70px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 35px;
    color: white;
    position: sticky;
    top: 0;
    z-index: 10;
    background: linear-gradient(120deg, #c24a16 0%, #e85d04 45%, #c24a16 100%);
    background-size: 200% 200%;
    animation: topbarShift 10s infinite;
}

.topbar-left {
    font-family: var(--font-heading);
    font-size: 24px;
    font-weight: 600;
}

.datetime-display {
    text-align: right;
    padding: 6px 14px;
    background: rgba(255,255,255,.15);
    border-radius: 8px;
}

.datetime-display .time {
    font-size: 14px;
    font-weight: 600;
}

.datetime-display .date {
    font-size: 10px;
    color: rgba(255,255,255,.8);
}

.main-content {
    margin-left: 268px;
    padding: 32px;
    min-height: calc(100vh - 70px);
}

.page-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 28px;
    gap: 16px;
    flex-wrap: wrap;
}

.section-title {
    font-family: var(--font-heading);
    font-size: 26px;
    color: var(--brand-primary);
    font-weight: 600;
}

.header-buttons {
    display: flex;
    gap: 12px;
}

.btn-back,
.btn-view-link {
    padding: 11px 22px;
    border: 2px solid var(--brand-primary);
    color: var(--brand-primary);
    background: #fff;
    border-radius: 8px;
    font-weight: 600;
    font-size: 14px;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
}

.btn-view-link {
    border-color: #1565c0;
    color: #1565c0;
}

.btn-back:hover {
    background: var(--brand-primary);
    color: #fff;
}

.btn-view-link:hover {
    background: #1565c0;
    color: #fff;
}

.spa-info-card {
    background: linear-gradient(135deg, #fff5f0, #fff8f5);
    border: 2px solid rgba(194,74,22,.15);
    border-radius: 12px;
    padding: 20px 24px;
    margin-bottom: 24px;
    display: flex;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
}

.spa-icon {
    width: 60px;
    height: 60px;
    background: linear-gradient(135deg, #c24a16, #e85d04);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    font-size: 24px;
    box-shadow: 0 4px 12px rgba(194,74,22,.3);
}

.spa-details {
    flex: 1;
}

.spa-details h3 {
    margin: 0 0 6px;
    font-family: var(--font-heading);
    font-size: 20px;
}

.spa-meta {
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
}

.spa-meta span {
    display: flex;
    gap: 6px;
    align-items: center;
    font-size: 13px;
    color: var(--brand-text-muted);
}

.spa-meta i {
    color: var(--brand-primary);
}

.status-badge {
    padding: 8px 16px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
}

.status-badge.available {
    background: #e8f5e9;
    color: #2e7d32;
    border: 1px solid #a5d6a7;
}

.status-badge.unavailable {
    background: #ffebee;
    color: #c62828;
    border: 1px solid #ef9a9a;
}

.form-container {
    background: #fff;
    border-radius: 14px;
    box-shadow: 0 4px 20px rgba(0,0,0,.06);
    overflow: hidden;
}

.form-header {
    background: #faf9f5;
    padding: 24px 28px;
    border-bottom: 1px solid rgba(0,0,0,.06);
    display: flex;
    align-items: center;
    gap: 18px;
}

.header-icon {
    width: 52px;
    height: 52px;
    background: var(--brand-primary);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    font-size: 22px;
}

.header-text h3 {
    font-family: var(--font-heading);
    font-size: 19px;
}

.header-text p {
    font-size: 13px;
    color: var(--brand-text-muted);
}

.form-body {
    padding: 32px;
}

.form-section {
    margin-bottom: 36px;
}

.section-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 22px;
    padding-bottom: 14px;
    border-bottom: 2px solid rgba(194,74,22,.1);
}

.section-header i {
    width: 34px;
    height: 34px;
    background: rgba(194,74,22,.08);
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--brand-primary);
}

.section-header h4 {
    font-family: var(--font-heading);
    font-size: 16px;
}

.form-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
}

.form-grid.single {
    grid-template-columns: 1fr;
}

.form-group {
    display: flex;
    flex-direction: column;
}

.form-group label {
    font-size: 13px;
    font-weight: 600;
    margin-bottom: 8px;
    display: flex;
    align-items: center;
    gap: 6px;
}

.required {
    color: var(--brand-primary);
}

.form-group label i {
    color: var(--brand-text-muted);
}

.form-group input,
.form-group select,
.form-group textarea {
    width: 100%;
    padding: 13px 16px;
    border: 2px solid #e5e5e5;
    border-radius: 8px;
    font-family: var(--font-body);
    font-size: 14px;
    background: var(--brand-cream);
}

.form-group input:focus,
.form-group select:focus,
.form-group textarea:focus {
    outline: none;
    border-color: var(--brand-primary);
    background: #fff;
    box-shadow: 0 0 0 4px rgba(194,74,22,.08);
}

.form-group textarea {
    resize: vertical;
    min-height: 100px;
}

.help-text {
    font-size: 11px;
    color: var(--brand-text-muted);
    margin-top: 6px;
    display: flex;
    align-items: center;
    gap: 5px;
}

.help-text i {
    color: var(--brand-primary);
}

.image-upload-area {
    border: 2px dashed #d0d0d0;
    border-radius: 10px;
    padding: 28px;
    text-align: center;
    background: #faf9f5;
    cursor: pointer;
    position: relative;
    transition: .25s;
}

.image-upload-area:hover {
    border-color: var(--brand-primary);
    background: rgba(194,74,22,.03);
}

.upload-icon {
    width: 64px;
    height: 64px;
    background: var(--brand-primary);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 14px;
    color: #fff;
    font-size: 26px;
}

.upload-text h5 {
    font-family: var(--font-heading);
    font-size: 15px;
    margin-bottom: 6px;
}

.upload-text p {
    font-size: 12px;
    color: var(--brand-text-muted);
}

.upload-text span {
    color: var(--brand-primary);
    font-weight: 500;
}

.file-info {
    font-size: 10px;
    margin-top: 8px;
    color: #aaa;
}

.image-preview-container {
    margin-top: 16px;
}

.image-preview-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
    gap: 12px;
}

.image-preview-item {
    position: relative;
    border-radius: 8px;
    overflow: hidden;
    aspect-ratio: 4/3;
    background: #f0f0f0;
    box-shadow: 0 2px 8px rgba(0,0,0,.1);
}

.image-preview-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.image-badge {
    position: absolute;
    top: 8px;
    left: 8px;
    padding: 4px 8px;
    border-radius: 8px;
    font-size: 11px;
    font-weight: 700;
    color: #fff;
    background: rgba(0,0,0,.6);
    z-index: 10;
    text-transform: uppercase;
}

.current-badge {
    background: var(--brand-primary);
}

.btn-delete-image {
    position: absolute;
    top: 6px;
    right: 6px;
    width: 28px;
    height: 28px;
    background: rgba(220,53,69,.9);
    border: 2px solid #fff;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
}

.btn-delete-image i {
    color: #fff;
    font-size: 12px;
}

.image-upload-area.dragover {
    border-color: var(--brand-primary);
    background: rgba(194,74,22,.03);
}

.image-upload-area .file-input {
    position: absolute;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
    opacity: 0;
    cursor: pointer;
}

.btn-delete-image:hover,
.remove-btn:hover {
    background: #c82333;
    transform: scale(1.15);
    box-shadow: 0 4px 12px rgba(220,53,69,.5);
}

.remove-btn {
    position: absolute;
    top: 6px;
    right: 6px;
    width: 28px;
    height: 28px;
    background: rgba(220,53,69,.9);
    border: 2px solid #fff;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 15;
    transition: all .2s ease;
    padding: 0;
    box-shadow: 0 2px 8px rgba(0,0,0,.3);
}

.remove-btn i {
    color: #fff;
    font-size: 12px;
}

.image-badge.new-badge {
    background: rgba(0,0,0,.6);
}

.main-image-badge {
    position: absolute;
    bottom: 6px;
    left: 6px;
    background: var(--brand-primary);
    color: #fff;
    padding: 3px 10px;
    border-radius: 12px;
    font-size: 10px;
    font-weight: 600;
    text-transform: uppercase;
}

.gallery-badge,
.gallery-number {
    position: absolute;
    bottom: 6px;
    left: 6px;
    background: rgba(0,0,0,.6);
    color: #fff;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 10px;
    font-weight: 600;
}

.form-actions {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 36px;
    padding-top: 24px;
    border-top: 2px solid rgba(0,0,0,.05);
}

.btn-cancel,
.btn-submit {
    padding: 13px 26px;
    border-radius: 8px;
    font-weight: 600;
    font-size: 14px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    cursor: pointer;
}

.btn-cancel {
    border: 2px solid #ddd;
    color: #666;
    background: #fff;
}

.btn-submit {
    background: var(--brand-primary);
    color: #fff;
    border: none;
    box-shadow: 0 4px 12px rgba(194,74,22,.25);
}

.flash-message {
    padding: 14px 20px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 20px;
    font-size: 14px;
}

.flash-message.success {
    background: #e8f5e9;
    border: 1px solid #a5d6a7;
    color: #2e7d32;
}

.flash-message.error {
    background: #ffebee;
    border: 1px solid #ef9a9a;
    color: #c62828;
}

@media (max-width: 992px) {
    .form-grid {
        grid-template-columns: 1fr;
    }

    .datetime-display {
        display: none;
    }
}

@media (max-width: 768px) {
    .sidebar,
    .sidebar-accent {
        display: none;
    }

    .topbar,
    .main-content {
        margin-left: 0;
    }

    .main-content {
        padding: 20px;
    }

    .page-header,
    .spa-info-card {
        flex-direction: column;
        align-items: flex-start;
    }
}


/* ===== DELETE SERVICE BUTTON / ROOM-LIKE FORM ACTIONS ===== */
.form-actions {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 14px;
    margin-top: 36px;
    padding-top: 24px;
    border-top: 2px solid rgba(0, 0, 0, 0.05);
    flex-wrap: wrap;
}

.form-actions-left,
.form-actions-right {
    display: flex;
    gap: 12px;
}

.btn-delete {
    padding: 13px 26px;
    border: 2px solid #dc3545;
    color: #dc3545;
    background: white;
    border-radius: 8px;
    font-weight: 600;
    font-size: 14px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    transition: all 0.25s ease;
}

.btn-delete:hover {
    background: #dc3545;
    color: white;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(220, 53, 69, 0.3);
}

.delete-modal-overlay {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.5);
    z-index: 1000;
    justify-content: center;
    align-items: center;
}

.delete-modal-overlay.show {
    display: flex;
}

.delete-modal {
    background: white;
    border-radius: 16px;
    padding: 32px;
    max-width: 420px;
    width: 90%;
    text-align: center;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
}

.delete-modal .modal-icon {
    width: 70px;
    height: 70px;
    background: linear-gradient(135deg, #ffebee 0%, #ffcdd2 100%);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 20px;
    color: #c62828;
    font-size: 32px;
}

.delete-modal h3 {
    margin: 0 0 12px;
    font-family: var(--font-heading);
    font-size: 22px;
    color: var(--brand-text);
}

.delete-modal p {
    margin: 0 0 24px;
    color: var(--brand-text-muted);
    font-size: 14px;
    line-height: 1.6;
}

.delete-modal .modal-actions {
    display: flex;
    gap: 12px;
    justify-content: center;
}

.delete-modal .btn-modal-cancel {
    padding: 12px 24px;
    border: 2px solid #ddd;
    color: #666;
    background: white;
    border-radius: 8px;
    font-weight: 600;
    font-size: 14px;
    cursor: pointer;
    transition: all 0.25s ease;
}

.delete-modal .btn-modal-cancel:hover {
    border-color: #999;
    color: #333;
}

.delete-modal .btn-modal-delete {
    padding: 12px 24px;
    background: #dc3545;
    color: white;
    border: none;
    border-radius: 8px;
    font-weight: 600;
    font-size: 14px;
    cursor: pointer;
    transition: all 0.25s ease;
}

.delete-modal .btn-modal-delete:hover {
    background: #c82333;
}

@media (max-width: 992px) {
    .form-actions {
        flex-direction: column;
    }
    .form-actions-left,
    .form-actions-right {
        width: 100%;
        justify-content: center;
    }
}

</style>
{% endblock %}

{% block body %}

<div class="sidebar-accent"></div>

<div class="sidebar">
    <div class="brand">
        <img src="/images/WEB.png" alt="Logo">
        <h1>La Casa Gaudencia</h1>
        <small>
            {% if 'ROLE_ADMIN' in app.user.roles %}
                Admin Panel
            {% elseif 'ROLE_STAFF' in app.user.roles %}
                Staff Panel
            {% endif %}
        </small>
    </div>

    <div class="sidebar-separator"></div>

    <ul>
        {% if is_granted('ROLE_ADMIN') %}
            <li><a href="{{ path('app_admin_dashboard') }}"><svg viewBox="0 0 24 24"><path d="M3 13h8V3H3v10zm0 8h8v-6H3v6zm10 0h8v-10h-8v10zm0-18v6h8V3h-8z"/></svg>Dashboard</a></li>
            <li><a href="{{ path('app_user_index') }}"><svg viewBox="0 0 24 24"><path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5s-3 1.34-3 3 1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.67 0-8 1.34-8 4v3h16v-3c0-2.66-5.33-4-8-4zm8 0c-.29 0-.62.02-.97.05C17.48 13.23 20 14.5 20 16v3h4v-3c0-2.66-5.33-4-8-4z"/></svg>User Management</a></li>
            <li class="active"><a href="{{ path('app_admin_services') }}"><svg viewBox="0 0 24 24"><path d="M4 6h16v2H4V6zm0 4h10v2H4v-2zm0 4h16v2H4v-2zm0 4h10v2H4v-2z"/></svg>Services</a></li>
            <li><a href="{{ path('reservation_index') }}"><svg viewBox="0 0 24 24"><path d="M20 6h-2V4h-2v2H8V4H6v2H4a2 2 0 00-2 2v12a2 2 0 002 2h16a2 2 0 002-2V8a2 2 0 00-2-2zm0 14H4V10h16v10z"/></svg>Reservations</a></li>
            <li><a href="{{ path('app_payment_dashboard') }}"><svg viewBox="0 0 24 24"><path d="M2 6h20v2H2V6zm0 4h20v8H2v-8zm0 10h20v2H2v-2z"/></svg>Payments</a></li>
            <li><a href="{{ path('app_contact_message_index') }}"><svg viewBox="0 0 24 24"><path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>Messages</a></li>
            <li><a href="{{ path('app_activity_log_index') }}"><svg viewBox="0 0 24 24"><path d="M13 3a9 9 0 0 0-9 9H1l3.89 3.89.07.14L9 12H6c0-3.87 3.13-7 7-7s7 3.13 7 7-3.13 7-7 7c-1.93 0-3.68-.79-4.94-2.06l-1.42 1.42A8.954 8.954 0 0 0 13 21a9 9 0 0 0 0-18zm-1 5v5l4.28 2.54.72-1.21-3.5-2.08V8H12z"/></svg>Activity Logs</a></li>
        <li>
            <a href="{{ path('admin_share_wall_index') }}">
