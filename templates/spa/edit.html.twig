    </ul>

    <div class="sidebar-logout">
        <a href="{{ path('app_logout') }}" class="logout-btn">Log Out</a>
    </div>
</div>

<div class="topbar">
    <div class="topbar-left">Spa Management</div>
    <div class="topbar-right">
        <div class="datetime-display">
            <div class="time" id="currentTime">00:00 AM</div>
            <div class="date" id="currentDate">Loading...</div>
        </div>
    </div>
</div>

<div class="main-content">

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="flash-message {{ label == 'success' ? 'success' : 'error' }}">
                <i class="fas fa-{{ label == 'success' ? 'check-circle' : 'exclamation-circle' }}"></i>
                {{ message }}
            </div>
        {% endfor %}
    {% endfor %}

    <div class="page-header">
        <h2 class="section-title">Edit Spa Service</h2>

        <div class="header-buttons">
            <a href="{{ path('app_spa_index') }}" class="btn-back">
                <i class="fas fa-arrow-left"></i>
                Back to Spa
            </a>

            <a href="{{ path('app_spa_show', {id: spa.id}) }}" class="btn-view-link">
                <i class="fas fa-eye"></i>
                View
            </a>
        </div>
    </div>

    <div class="spa-info-card">
        <div class="spa-icon">
            <i class="fas fa-spa"></i>
        </div>

        <div class="spa-details">
            <h3>{{ spa.name }}</h3>
            <div class="spa-meta">
                <span><i class="fas fa-layer-group"></i> {{ spa.category ?? 'No category' }}</span>
                <span><i class="fas fa-clock"></i> {{ spa.duration ?? 'No duration' }}</span>
                <span><i class="fas fa-users"></i> {{ spa.capacity ?? '0' }} person(s)</span>
                <span><i class="fas fa-peso-sign"></i> ₱{{ spa.price|number_format(2) }}</span>
            </div>
        </div>

        {% set statusClass = spa.status|lower == 'available' ? 'available' : 'unavailable' %}
        <span class="status-badge {{ statusClass }}">{{ spa.status }}</span>
    </div>

    <div class="form-container">
        <div class="form-header">
            <div class="header-icon">
                <i class="fas fa-spa"></i>
            </div>

            <div class="header-text">
                <h3>Update Spa Information</h3>
                <p>Modify the spa service details below</p>
            </div>
        </div>

        <div class="form-body">
            {{ form_start(form, {'attr': {'class': 'spa-form', 'enctype': 'multipart/form-data', 'id': 'spaForm'}}) }}

            <div class="form-section">
                <div class="section-header">
                    <i class="fas fa-info-circle"></i>
                    <h4>Basic Information</h4>
                </div>

                <div class="form-grid">
                    <div class="form-group">
                        <label><i class="fas fa-tag"></i> Service Name <span class="required">*</span></label>
                        {{ form_widget(form.name, {'attr': {'placeholder': 'Service name'}}) }}
                        {{ form_errors(form.name) }}
                    </div>

                    <div class="form-group">
                        <label><i class="fas fa-peso-sign"></i> Price <span class="required">*</span></label>
                        {{ form_widget(form.price, {'attr': {'placeholder': '0.00'}}) }}
                        {{ form_errors(form.price) }}
                    </div>

                    <div class="form-group">
                        <label><i class="fas fa-clock"></i> Duration</label>
                        {{ form_widget(form.duration, {'attr': {'placeholder': 'e.g., 60 minutes'}}) }}
                        {{ form_errors(form.duration) }}
                    </div>

                    <div class="form-group">
                        <label><i class="fas fa-layer-group"></i> Category</label>
                        {{ form_widget(form.category) }}
                        {{ form_errors(form.category) }}
                    </div>

                    <div class="form-group">
                        <label><i class="fas fa-users"></i> Capacity</label>
                        {{ form_widget(form.capacity, {'attr': {'placeholder': 'Max persons'}}) }}
                        {{ form_errors(form.capacity) }}
                    </div>

                    <div class="form-group">
                        <label><i class="fas fa-toggle-on"></i> Status <span class="required">*</span></label>
                        {{ form_widget(form.status) }}
                        {{ form_errors(form.status) }}
                    </div>
                </div>
            </div>

            <div class="form-section">
                <div class="section-header">
                    <i class="fas fa-align-left"></i>
                    <h4>Description</h4>
                </div>

                <div class="form-grid single">
                    <div class="form-group">
                        <label><i class="fas fa-file-alt"></i> Service Description</label>
                        {{ form_widget(form.description, {'attr': {'placeholder': 'Describe the spa service...', 'rows': 4}}) }}
                        {{ form_errors(form.description) }}
                        <span class="help-text"><i class="fas fa-lightbulb"></i> Short description for guests</span>
                    </div>
                </div>
            </div>

            <div class="form-section">
                <div class="section-header">
                    <i class="fas fa-images"></i>
                    <h4>Spa Images</h4>
                </div>

                <div class="form-grid">
                    <div class="form-group">
                        <label><i class="fas fa-image"></i> Main Spa Image</label>

                        <div class="image-upload-area" id="mainUploadArea">
                            {{ form_widget(form.mainImageFile, {'attr': {'class': 'file-input', 'id': 'mainImageInput', 'accept': 'image/*'}}) }}

                            <div class="upload-icon">
                                <i class="fas fa-cloud-upload-alt"></i>
                            </div>

                            <div class="upload-text">
                                <h5>{{ spa.mainImage ? 'Replace Main Image' : 'Upload Main Image' }}</h5>
                                <p>Drag & drop or <span>browse</span></p>
                                <p class="file-info">JPEG, PNG or WebP (Max 5MB)</p>
                            </div>
                        </div>

                        {{ form_errors(form.mainImageFile) }}

                        <div class="image-preview-container">
                            <div class="image-preview-grid" id="currentMainImageGrid">
                                {% if spa.mainImage %}
                                    <div class="image-preview-item" id="currentMainImage">
                                        <img src="{{ asset('uploads/spas/' ~ spa.mainImage) }}" alt="Current main image">
                                        <span class="image-badge current-badge">Current</span>

                                        <button type="button"
                                                class="btn-delete-image"
                                                title="Delete main image"
                                                data-action="{{ path('app_spa_delete_image', {'id': spa.id, 'type': 'main', 'index': 0}) }}"
                                                data-token="{{ csrf_token('delete-image' ~ spa.id) }}">
                                            <i class="fas fa-times"></i>
                                        </button>
                                    </div>
                                {% endif %}
                            </div>

                            <div class="image-preview-grid" id="mainImagePreview"></div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label><i class="fas fa-photo-video"></i> Gallery Images</label>

                        <div class="image-upload-area" id="galleryUploadArea">
                            {{ form_widget(form.galleryImageFiles, {'attr': {'class': 'file-input', 'id': 'galleryImagesInput', 'accept': 'image/*', 'multiple': true}}) }}

                            <div class="upload-icon">
                                <i class="fas fa-images"></i>
                            </div>

                            <div class="upload-text">
                                <h5>Upload Gallery Images</h5>
                                <p>Drag & drop or <span>browse</span></p>
                                <p class="file-info">Multiple files allowed</p>
                            </div>
                        </div>

                        {{ form_errors(form.galleryImageFiles) }}

                        <div class="image-preview-container">
                            <div class="image-preview-grid" id="currentGalleryImagesGrid">
                                {% for image in spa.galleryImages|default([]) %}
                                    <div class="image-preview-item" data-gallery-index="{{ loop.index0 }}">
                                        <img src="{{ asset('uploads/spas/' ~ image) }}" alt="Gallery image {{ loop.index }}">
                                        <span class="gallery-number">{{ loop.index }}</span>
                                        <span class="image-badge current-badge">Current</span>

                                        <button type="button"
                                                class="btn-delete-image"
                                                title="Delete gallery image"
                                                data-action="{{ path('app_spa_delete_image', {'id': spa.id, 'type': 'gallery', 'index': loop.index0}) }}"
                                                data-token="{{ csrf_token('delete-image' ~ spa.id) }}">
                                            <i class="fas fa-times"></i>
                                        </button>
                                    </div>
                                {% else %}
                                    {# no existing gallery images #}
                                {% endfor %}
                            </div>

                            <div class="image-preview-grid" id="galleryImagesPreview"></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="form-actions">
                <div class="form-actions-left">
                    <button type="button" class="btn-delete" id="deleteSpaBtn">
                        <i class="fas fa-trash-alt"></i> Delete Spa Service
                    </button>
                </div>

                <div class="form-actions-right">
                    <a href="{{ path('app_spa_index') }}" class="btn-cancel">
                        <i class="fas fa-times"></i>
                        Cancel
                    </a>

                    <button type="submit" class="btn-submit">
                        <i class="fas fa-save"></i>
                        Update Spa
                    </button>
                </div>
            </div>

            {{ form_end(form) }}
        </div>
    </div>
</div>


<!-- DELETE CONFIRMATION MODAL -->
<div class="delete-modal-overlay" id="deleteModal">
    <div class="delete-modal">
        <div class="modal-icon">
            <i class="fas fa-exclamation-triangle"></i>
        </div>
        <h3>Delete {{ spa.name }}?</h3>
        <p>Are you sure you want to delete this spa service? This action cannot be undone and all associated data will be permanently removed.</p>
        <div class="modal-actions">
            <button type="button" class="btn-modal-cancel" id="cancelDeleteBtn">Cancel</button>
            <form method="post" action="{{ path('app_spa_delete', {'id': spa.id}) }}" style="display: inline;">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ spa.id) }}">
                <button type="submit" class="btn-modal-delete">
                    <i class="fas fa-trash-alt"></i> Yes, Delete
                </button>
            </form>
        </div>
    </div>
</div>

{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
document.addEventListener('DOMContentLoaded', function() {
    function findFileInput(id, uploadArea) {
        let el = document.getElementById(id);

        if (el && el.tagName && el.tagName.toLowerCase() === 'input' && el.type === 'file') {
            return el;
        }

        if (uploadArea) {
            el = uploadArea.querySelector('input[type="file"]');
            if (el) return el;
        }

        return document.querySelector('input[type="file"]');
    }

    function updateDateTime() {
        const now = new Date();
        const timeEl = document.getElementById('currentTime');
        const dateEl = document.getElementById('currentDate');

        if (timeEl && dateEl) {
            timeEl.textContent = now.toLocaleTimeString('en-US', {
                hour: '2-digit',
                minute: '2-digit',
                hour12: true
            });

            dateEl.textContent = now.toLocaleDateString('en-US', {
                weekday: 'short',
                month: 'short',
                day: 'numeric',
                year: 'numeric'
            });
        }
    }

    updateDateTime();
    setInterval(updateDateTime, 1000);


    // ===== DELETE MODAL =====
    const deleteBtn = document.getElementById('deleteSpaBtn');
    const deleteModal = document.getElementById('deleteModal');
    const cancelDeleteBtn = document.getElementById('cancelDeleteBtn');

    if (deleteBtn && deleteModal) {
        deleteBtn.addEventListener('click', function() {
            deleteModal.classList.add('show');
        });

        if (cancelDeleteBtn) {
            cancelDeleteBtn.addEventListener('click', function() {
                deleteModal.classList.remove('show');
            });
        }

        deleteModal.addEventListener('click', function(e) {
            if (e.target === deleteModal) {
                deleteModal.classList.remove('show');
            }
        });
    }

    class ImageUploader {
        constructor(inputId, previewId, uploadAreaId, isMultiple = false) {
            this.uploadArea = document.getElementById(uploadAreaId);
            this.preview = document.getElementById(previewId);
            this.inputId = inputId;
            this.isMultiple = isMultiple;
            this.files = [];
            this.input = findFileInput(inputId, this.uploadArea);

            if (!this.uploadArea || !this.preview || !this.input) {
                console.warn('Image uploader missing element:', { inputId, previewId, uploadAreaId });
                return;
            }

            if (!this.uploadArea.contains(this.input)) {
                this.input.style.position = 'absolute';
                this.input.style.top = '0';
                this.input.style.left = '0';
                this.input.style.width = '100%';
                this.input.style.height = '100%';
                this.input.style.opacity = '0';
                this.input.style.cursor = 'pointer';
                this.uploadArea.insertBefore(this.input, this.uploadArea.firstChild);
            }

            this.init();
        }

        init() {
            this.input.addEventListener('change', (e) => {
                this.handleFiles(e.target.files);
            });

            this.uploadArea.addEventListener('dragover', (e) => {
                e.preventDefault();
                this.uploadArea.classList.add('dragover');
            });

            this.uploadArea.addEventListener('dragleave', () => {
                this.uploadArea.classList.remove('dragover');
            });

            this.uploadArea.addEventListener('drop', (e) => {
                e.preventDefault();
                this.uploadArea.classList.remove('dragover');
                this.handleFiles(e.dataTransfer.files);
            });
        }

        handleFiles(fileList) {
            const newFiles = Array.from(fileList).filter(file => {
                if (!file.type.startsWith('image/')) {
                    alert(`${file.name} is not an image`);
                    return false;
                }

                if (file.size > 5 * 1024 * 1024) {
                    alert(`${file.name} is too large (max 5MB)`);
                    return false;
                }

                return true;
            });

            this.files = this.isMultiple ? [...this.files, ...newFiles] : newFiles.slice(0, 1);

            this.renderPreview();
            this.updateInput();
        }

        renderPreview() {
            this.preview.innerHTML = '';

            this.files.forEach((file, index) => {
                const reader = new FileReader();

                reader.onload = (e) => {
                    const item = document.createElement('div');
                    item.className = 'image-preview-item';
                    item.innerHTML = `
                        <img src="${e.target.result}" alt="${file.name}">
                        ${!this.isMultiple ? '<span class="main-image-badge">Main</span>' : `<span class="gallery-badge">${index + 1}</span>`}
                        <span class="image-badge new-badge">New</span>
                        <button type="button" class="remove-btn" title="Remove"><i class="fas fa-times"></i></button>
                    `;

                    item.querySelector('.remove-btn').addEventListener('click', () => {
                        this.files.splice(index, 1);
                        this.renderPreview();
                        this.updateInput();
                    });

                    this.preview.appendChild(item);
                };

                reader.readAsDataURL(file);
            });
        }

        updateInput() {
            const dt = new DataTransfer();
            this.files.forEach(file => dt.items.add(file));
            this.input.files = dt.files;
        }
    }

    new ImageUploader('mainImageInput', 'mainImagePreview', 'mainUploadArea', false);
    new ImageUploader('galleryImagesInput', 'galleryImagesPreview', 'galleryUploadArea', true);

    document.querySelectorAll('.btn-delete-image').forEach(btn => {
        btn.addEventListener('click', async (e) => {
            e.preventDefault();
            e.stopPropagation();

            if (!confirm('Are you sure you want to delete this image?')) return;

            const action = btn.dataset.action;
            const token = btn.dataset.token;
            const imageItem = btn.closest('.image-preview-item');

            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
            btn.disabled = true;

            try {
                const res = await fetch(action, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: new URLSearchParams({ _token: token })
                });

                if (res.ok) {
                    imageItem.style.transition = 'all .3s ease';
                    imageItem.style.opacity = '0';
                    imageItem.style.transform = 'scale(.8)';

                    setTimeout(() => imageItem.remove(), 300);
                } else {
                    alert('Failed to delete image. Please try again.');
                    btn.innerHTML = '<i class="fas fa-times"></i>';
                    btn.disabled = false;
                }
            } catch (err) {
                console.error('Delete error', err);
                alert('Failed to delete image. Please check your connection.');
                btn.innerHTML = '<i class="fas fa-times"></i>';
                btn.disabled = false;
            }
        });
    });
});
</script>
{% endblock %}
