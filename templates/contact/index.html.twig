{% extends 'base.html.twig' %}

{% block title %}Contact Us — La Casa Gaudencia{% endblock %}

{% block body %}
<style>
@import url("https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Lato:wght@300;400;500;600;700&family=Roboto:wght@300;400;500;600&display=swap");

:root{
    --primary-color:#c24a16;
    --primary-dark:#a93e10;
    --primary-light:#e85d2a;
    --accent-gold:#d4a853;
    --accent-cream:#fff8f5;
    --text-dark:#2c2c2c;
    --text-light:#666;
    --white:#ffffff;
    --bg-pattern:#fcfbf7;
    --shadow-soft:0 4px 20px rgba(0,0,0,.08);
    --shadow-medium:0 8px 30px rgba(0,0,0,.12);
    --shadow-strong:0 12px 40px rgba(0,0,0,.18);
    --shadow-glow:0 0 40px rgba(194,74,22,.15);
    --gradient-primary:linear-gradient(135deg,#c24a16 0%,#e85d2a 50%,#d4a853 100%);
    --gradient-gold:linear-gradient(135deg,#d4a853 0%,#f0c97a 50%,#d4a853 100%);
    --border-radius-card:20px;
    --border-radius-lg:30px;
    --bg-peach:#fff5f0;
    --bg-cream:#fffbf7;
    --bg-light-gold:#fef9f3;
    --bg-pale-orange:#fff3eb;
    --bg-ivory:#fefdfb;
}

*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{font-family:"Lato",sans-serif;background:var(--bg-pattern);color:var(--text-dark);line-height:1.6;overflow-x:hidden}

@keyframes float{0%,100%{transform:translateY(0) rotate(0deg)}50%{transform:translateY(-20px) rotate(5deg)}}
@keyframes pulse{0%,100%{transform:scale(1);opacity:.5}50%{transform:scale(1.1);opacity:.8}}
@keyframes fadeInUp{from{opacity:0;transform:translateY(30px)}to{opacity:1;transform:translateY(0)}}
@keyframes modalSlideIn{from{transform:translateY(-50px) scale(.9);opacity:0}to{transform:translateY(0) scale(1);opacity:1}}

.wave-divider{position:absolute;bottom:-2px;left:0;width:100%;overflow:hidden;line-height:0;z-index:10}
.wave-divider svg{position:relative;display:block;width:100%;height:50px}
.wave-divider path{fill:none;stroke-width:2.5;stroke-linecap:round;stroke-dasharray:8,12}

h1,h2,h3,h4{font-family:"Playfair Display",serif;color:var(--primary-color);font-weight:600}
p,li,input,button,textarea,select{font-family:"Roboto",sans-serif}

.navbar{position:fixed;top:0;left:0;right:0;display:flex;justify-content:space-between;align-items:center;background:rgba(252,251,247,.95);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);padding:15px 60px;box-shadow:0 2px 20px rgba(0,0,0,.08);z-index:1000;transition:all .3s ease}
.navbar.scrolled{padding:10px 60px;background:rgba(252,251,247,.98);box-shadow:0 4px 30px rgba(0,0,0,.12)}
.navbar::before{content:"";position:absolute;inset:0;background:url('{{ asset("Images/B1.png") }}') repeat-x center;background-size:120px auto;opacity:.08;z-index:0;pointer-events:none}
.navbar .logo{position:relative;z-index:1;display:flex;align-items:center;gap:12px;font-family:"Playfair Display",serif;font-size:24px;font-weight:700;color:var(--primary-color);text-decoration:none;transition:transform .3s ease}
.navbar .logo:hover{transform:scale(1.02)}
.navbar .logo img{height:55px;width:auto;filter:drop-shadow(0 2px 4px rgba(0,0,0,.1))}
.navbar .logo span{background:var(--gradient-primary);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.navbar nav{position:relative;z-index:1}
.navbar ul{list-style:none;display:flex;align-items:center;gap:10px;margin:0;padding:0}
.navbar ul li{display:flex;align-items:center}
.navbar ul li a{display:inline-block;text-decoration:none;color:var(--text-dark);font-weight:500;font-size:15px;padding:10px 18px;border-radius:8px;position:relative;transition:all .3s ease}
.navbar ul li a:not(.signin-btn):hover{color:var(--primary-color);background:rgba(194,74,22,.08)}
.navbar ul li a:not(.signin-btn)::after{content:"";position:absolute;left:50%;bottom:5px;width:0;height:2px;background:var(--gradient-primary);border-radius:2px;transition:all .3s ease;transform:translateX(-50%)}
.navbar ul li a:not(.signin-btn):hover::after{width:60%}
.navbar ul li .signin-btn{background:var(--gradient-primary);color:var(--white)!important;padding:12px 28px;border-radius:50px;font-weight:600;font-size:14px;letter-spacing:.5px;transition:all .3s ease;box-shadow:0 4px 15px rgba(194,74,22,.3);border:none;margin-left:10px}
.navbar ul li .signin-btn:hover{transform:translateY(-2px);box-shadow:0 6px 25px rgba(194,74,22,.4)}
.navbar ul li .signin-btn::after{display:none}
.menu-toggle{display:none;flex-direction:column;gap:5px;cursor:pointer;z-index:1001;padding:10px}
.menu-toggle span{width:28px;height:3px;background:var(--primary-color);border-radius:3px;transition:all .3s ease}
.menu-toggle.active span:nth-child(1){transform:rotate(45deg) translate(6px,6px)}
.menu-toggle.active span:nth-child(2){opacity:0}
.menu-toggle.active span:nth-child(3){transform:rotate(-45deg) translate(6px,-6px)}
.navbar ul li a.nav-active{color:var(--primary-color);background:rgba(194,74,22,.08)}
.navbar ul li a.nav-active::after{width:60%}

footer{position:relative;background:linear-gradient(135deg,var(--primary-dark) 0%,var(--primary-color) 40%,#d4703a 70%,var(--primary-light) 100%);color:var(--white);padding:80px 20px 40px;overflow:hidden}
footer::before{content:"";position:absolute;inset:0;background:url('{{ asset("Images/B1.png") }}') repeat;background-size:80px auto;opacity:.08;z-index:0}
footer::after{content:"";position:absolute;top:-100px;right:-100px;width:400px;height:400px;background:radial-gradient(circle,rgba(212,168,83,.15) 0%,transparent 60%);border-radius:50%;pointer-events:none;animation:float 12s ease-in-out infinite}
.footer-content{position:relative;z-index:1;max-width:1200px;margin:0 auto;display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:40px;text-align:left}
.footer-section h4{color:var(--white);font-size:20px;margin-bottom:25px;position:relative;padding-bottom:12px}
.footer-section h4::after{content:"";position:absolute;bottom:0;left:0;width:40px;height:2px;background:linear-gradient(135deg,var(--accent-gold),#fff8f0);border-radius:2px}
.footer-section p,.footer-section a{color:rgba(255,255,255,.9);font-size:15px;line-height:1.8;text-decoration:none;transition:all .3s ease}
.footer-section a:hover{color:var(--accent-gold);padding-left:5px}
.footer-section ul{list-style:none;padding:0}
.footer-section ul li{margin-bottom:12px}
.footer-section ul li a{display:flex;align-items:center;gap:10px}
.footer-section ul li a i{color:var(--accent-gold);width:20px;transition:transform .3s ease}
.footer-section ul li a:hover i{transform:translateX(5px)}
.footer-section .contact-item{display:flex;align-items:flex-start;gap:15px;margin-bottom:15px}
.footer-section .contact-item i{color:var(--accent-gold);font-size:18px;margin-top:3px}
.social-icons{display:flex;gap:15px;margin-top:20px}
.social-icons a{width:48px;height:48px;background:rgba(255,255,255,.15);border:1px solid rgba(255,255,255,.2);border-radius:50%;display:flex;align-items:center;justify-content:center;color:var(--white);font-size:18px;transition:all .3s ease;position:relative}
.social-icons a::before{content:"";position:absolute;inset:0;background:var(--white);border-radius:50%;opacity:0;transition:opacity .3s ease;z-index:-1}
.social-icons a:hover::before{opacity:1}
.social-icons a:hover{transform:translateY(-5px) scale(1.1);color:var(--primary-color);border-color:var(--white)}
.footer-bottom{position:relative;z-index:1;text-align:center;padding-top:40px;margin-top:40px;border-top:1px solid rgba(255,255,255,.2)}
.footer-bottom p{color:rgba(255,255,255,.8);font-size:14px}

.page-hero{min-height:50vh;background:linear-gradient(135deg,rgba(44,44,44,.75),rgba(194,74,22,.5)),url('{{ asset("Images/ground.jpeg") }}') center/cover no-repeat fixed;display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center;color:var(--white);padding:160px 40px 100px;position:relative}
.page-hero .breadcrumb{display:flex;align-items:center;gap:8px;font-size:14px;margin-bottom:20px;color:rgba(255,255,255,.7)}
.page-hero .breadcrumb a{color:var(--accent-gold);text-decoration:none;transition:color .3s}
.page-hero .breadcrumb a:hover{color:var(--white)}
.page-hero h1{font-size:52px;font-weight:700;color:var(--white);margin-bottom:15px;animation:fadeInUp .8s ease}
.page-hero h1 span{color:var(--accent-gold);font-style:italic}
.page-hero p{font-size:18px;max-width:600px;color:rgba(255,255,255,.9);animation:fadeInUp .8s ease .2s backwards}

.section-pad{padding:100px 20px 120px;position:relative}
.section-header{text-align:center;margin-bottom:60px}
.section-header .subtitle{font-size:14px;letter-spacing:3px;text-transform:uppercase;color:var(--accent-gold);font-weight:600;margin-bottom:18px;display:inline-flex;align-items:center;gap:15px}
.section-header .subtitle::before,.section-header .subtitle::after{content:"";width:30px;height:1px;background:var(--gradient-gold)}
.section-header h2{font-size:42px;margin:0}
.section-header .section-desc{max-width:600px;margin:20px auto 0;color:var(--text-light);font-size:15px;line-height:1.8}

.contact-main{background:var(--bg-peach)}
.contact-grid{max-width:1200px;margin:0 auto;display:grid;grid-template-columns:1fr 1.3fr;gap:50px;text-align:left}

.contact-info-col{padding:20px 0}
.contact-info-col h3{font-size:26px;color:var(--text-dark);margin-bottom:12px}
.contact-info-col>p{color:var(--text-light);font-size:15px;line-height:1.7;margin-bottom:30px}
.c-detail-list{display:flex;flex-direction:column;gap:20px;margin-bottom:35px}
.c-detail{display:flex;align-items:flex-start;gap:16px;padding:16px;border-radius:16px;transition:all .3s}
.c-detail:hover{background:rgba(194,74,22,.04);transform:translateX(8px)}
.c-icon{width:50px;height:50px;flex-shrink:0;background:linear-gradient(135deg,rgba(194,74,22,.1),rgba(212,168,83,.12));border-radius:14px;display:flex;align-items:center;justify-content:center;transition:all .3s}
.c-detail:hover .c-icon{background:var(--gradient-primary)}
.c-icon i{color:var(--primary-color);font-size:20px;transition:color .3s}
.c-detail:hover .c-icon i{color:var(--white)}
.c-detail-text h4{font-size:14px;font-weight:700;color:var(--text-dark);margin-bottom:4px;font-family:"Roboto",sans-serif;letter-spacing:.5px;text-transform:uppercase}
.c-detail-text p,.c-detail-text a{color:var(--text-light);font-size:14px;line-height:1.6;text-decoration:none;display:block;transition:color .3s}
.c-detail-text a:hover{color:var(--primary-color)}
.c-social h4{font-size:14px;font-weight:700;color:var(--text-dark);margin-bottom:14px;text-transform:uppercase;letter-spacing:.5px}
.c-social-icons{display:flex;gap:12px}
.c-social-icons a{width:46px;height:46px;border-radius:50%;background:linear-gradient(135deg,rgba(194,74,22,.08),rgba(212,168,83,.08));color:var(--primary-color);display:flex;align-items:center;justify-content:center;font-size:18px;transition:all .3s;text-decoration:none;position:relative}
.c-social-icons a:hover{color:var(--white);transform:translateY(-3px) scale(1.1);background:var(--gradient-primary);box-shadow:0 5px 15px rgba(194,74,22,.3)}

.contact-form-col{background:var(--white);border-radius:var(--border-radius-lg);box-shadow:var(--shadow-medium);overflow:hidden;border:1px solid rgba(194,74,22,.08)}
.form-header{background:linear-gradient(135deg,var(--primary-dark),var(--primary-color) 60%,#d4703a);padding:35px 40px;color:var(--white);position:relative;overflow:hidden}
.form-header::before{content:"";position:absolute;inset:0;background:url('{{ asset("Images/B1.png") }}') repeat;background-size:70px auto;opacity:.06}
.form-header>*{position:relative;z-index:1}
.form-header h3{font-size:24px;color:var(--white);margin-bottom:6px}
.form-header p{color:rgba(255,255,255,.85);font-size:14px}
.form-body{padding:40px}

/* ── SYMFONY FORM STYLES ── */
.contact-form{display:flex;flex-direction:column;gap:22px}
.form-row{display:grid;grid-template-columns:1fr 1fr;gap:20px}
.form-group{display:flex;flex-direction:column;gap:6px}
.form-group label{font-size:13px;font-weight:600;color:var(--text-dark);text-transform:uppercase;letter-spacing:.5px}
.form-group label .required{color:#e74c3c;margin-left:2px}

/* Target all Symfony-rendered inputs, selects, textareas */
.contact-form input,
.contact-form textarea,
.contact-form select{
    padding:14px 18px;
    border-radius:12px;
    border:2px solid #eee;
    font-size:14px;
    transition:all .3s;
    background:#fafafa;
    font-family:"Roboto",sans-serif;
    color:var(--text-dark);
    width:100%;
}
.contact-form input:focus,
.contact-form textarea:focus,
.contact-form select:focus{
    border-color:var(--primary-color);
    background:var(--white);
    box-shadow:0 0 0 4px rgba(194,74,22,.1);
    outline:none;
}
.contact-form textarea{min-height:140px;resize:vertical}

/* Symfony error messages */
.contact-form .invalid-feedback,
.contact-form ul.list-unstyled li{
    color:#e74c3c;
    font-size:12px;
    margin-top:4px;
    display:block;
}
.contact-form ul.list-unstyled{
    list-style:none;
    padding:0;
    margin:4px 0 0 0;
}

.form-submit{display:flex;align-items:center;gap:14px;margin-top:10px}
.btn-submit{display:inline-flex;align-items:center;justify-content:center;gap:10px;background:var(--gradient-primary);color:var(--white);padding:16px 40px;border-radius:50px;font-size:16px;font-weight:600;border:none;cursor:pointer;transition:all .4s;box-shadow:0 6px 25px rgba(194,74,22,.3);position:relative;overflow:hidden}
.btn-submit:hover{transform:translateY(-2px);box-shadow:0 10px 35px rgba(194,74,22,.4)}
.form-hint{font-size:12px;color:var(--text-light)}

/* Flash success alert */
.flash-success{
    display:flex;align-items:flex-start;gap:16px;
    background:linear-gradient(135deg,#d4edda,#c3e6cb);
    border:1px solid #b8dacc;
    border-radius:16px;
    padding:24px 28px;
    margin-bottom:24px;
    animation:fadeInUp .5s ease;
}
.flash-success .fs-icon{
    width:48px;height:48px;flex-shrink:0;
    background:linear-gradient(135deg,#28a745,#20c997);
    border-radius:50%;display:flex;align-items:center;justify-content:center;
}
.flash-success .fs-icon i{color:var(--white);font-size:20px}
.flash-success .fs-text h4{color:#155724;font-size:16px;margin-bottom:4px}
.flash-success .fs-text p{color:#1e7e34;font-size:14px;margin:0}

.map-section{background:var(--bg-cream)}
.map-container{max-width:1100px;margin:0 auto}
.map-wrap{position:relative;border-radius:var(--border-radius-lg);overflow:hidden;box-shadow:var(--shadow-medium)}
.map-wrap iframe{width:100%;height:420px;border:none;display:block}
.map-card{position:absolute;bottom:25px;left:25px;right:25px;max-width:400px;background:rgba(252,251,247,.97);backdrop-filter:blur(10px);border-radius:16px;padding:22px 28px;box-shadow:0 4px 20px rgba(0,0,0,.12);border:1px solid rgba(194,74,22,.1)}
.map-card h4{font-size:16px;color:var(--primary-color);margin-bottom:6px;display:flex;align-items:center;gap:8px}
.map-card p{font-size:13px;color:var(--text-light);margin-bottom:14px}
.map-card .dir-btn{display:inline-flex;align-items:center;gap:8px;background:var(--gradient-primary);color:var(--white);padding:10px 22px;border-radius:50px;font-size:13px;font-weight:600;text-decoration:none;transition:all .3s;box-shadow:0 4px 15px rgba(194,74,22,.3)}
.map-card .dir-btn:hover{transform:translateY(-2px);box-shadow:0 6px 20px rgba(194,74,22,.4)}

.faq-section{background:var(--bg-light-gold)}
.faq-list{max-width:800px;margin:0 auto;display:flex;flex-direction:column;gap:14px}
.faq-item{background:var(--white);border-radius:16px;border:1px solid rgba(194,74,22,.08);overflow:hidden;box-shadow:0 2px 10px rgba(0,0,0,.04);transition:all .3s}
.faq-item:hover{box-shadow:var(--shadow-soft)}
.faq-question{display:flex;justify-content:space-between;align-items:center;padding:20px 28px;cursor:pointer;font-size:16px;font-weight:600;color:var(--text-dark);transition:all .3s;gap:16px}
.faq-question:hover{color:var(--primary-color)}
.faq-question i{font-size:14px;color:var(--primary-color);transition:transform .3s;flex-shrink:0}
.faq-item.open .faq-question i{transform:rotate(180deg)}
.faq-answer{max-height:0;overflow:hidden;transition:max-height .4s ease,padding .3s}
.faq-item.open .faq-answer{max-height:300px;padding:0 28px 20px}
.faq-answer p{font-size:14px;color:var(--text-light);line-height:1.7}

.cta-banner{background:linear-gradient(135deg,rgba(44,44,44,.85),rgba(194,74,22,.8)),url('{{ asset("Images/ground.jpeg") }}') center/cover no-repeat fixed;padding:100px 20px;text-align:center;color:var(--white);position:relative;overflow:hidden}
.cta-banner::after{content:"";position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:500px;height:500px;background:radial-gradient(circle,rgba(212,168,83,.15),transparent 70%);border-radius:50%;animation:pulse 5s ease-in-out infinite}
.cta-banner .cta-inner{position:relative;z-index:1;max-width:700px;margin:0 auto}
.cta-banner h2{font-size:40px;color:var(--white);margin-bottom:15px}
.cta-banner p{font-size:17px;color:rgba(255,255,255,.9);margin-bottom:35px}
.cta-banner .btn-cta{display:inline-flex;align-items:center;gap:10px;background:var(--white);color:var(--primary-color);padding:16px 44px;border-radius:50px;font-size:16px;font-weight:700;text-decoration:none;transition:all .4s;box-shadow:0 8px 30px rgba(0,0,0,.2)}
.cta-banner .btn-cta:hover{background:var(--accent-gold);color:var(--white);transform:translateY(-3px) scale(1.05)}

@media(max-width:1024px){
    .navbar{padding:15px 30px}
    .navbar.scrolled{padding:10px 30px}
    .contact-grid{grid-template-columns:1fr}
    .page-hero h1{font-size:40px}
}
@media(max-width:768px){
    .navbar{padding:12px 20px}
    .navbar.scrolled{padding:8px 20px}
    .navbar .logo{font-size:20px}
    .navbar .logo img{height:45px}
    .menu-toggle{display:flex}
    .navbar nav{position:fixed;top:0;right:-100%;width:280px;height:100vh;background:var(--white);box-shadow:-5px 0 30px rgba(0,0,0,.1);transition:right .4s ease;padding:80px 30px 30px;z-index:999}
    .navbar nav.active{right:0}
    .navbar ul{flex-direction:column;gap:5px;align-items:stretch}
    .navbar ul li a{padding:15px 20px;border-radius:10px;font-size:16px}
    .navbar ul li .signin-btn{margin:20px 0 0 0;text-align:center}
    .page-hero{padding:140px 20px 80px}
    .page-hero h1{font-size:32px}
    .section-pad{padding:70px 20px 90px}
    .section-header h2{font-size:32px}
    .form-row{grid-template-columns:1fr}
    .form-header,.form-body{padding:25px}
    .cta-banner h2{font-size:30px}
    .footer-content{text-align:center}
    .footer-section h4::after{left:50%;transform:translateX(-50%)}
    .social-icons{justify-content:center}
    .map-card{position:relative;bottom:auto;left:auto;right:auto;max-width:100%;margin-top:-20px;border-radius:0 0 16px 16px}
}
@media(max-width:480px){
    .page-hero h1{font-size:26px}
}
</style>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"/>

{# ══════════════════════════════════════════════════════════════════════════════
   NAVBAR
══════════════════════════════════════════════════════════════════════════════ #}
<header class="navbar" id="navbar">
    <a href="{{ path('app_landing') }}" class="logo">
        <img src="{{ asset('Images/WEB.png') }}" alt="Logo"/>
        <span>La Casa Gaudencia</span>
    </a>
    <div class="menu-toggle" id="menuToggle"><span></span><span></span><span></span></div>
    <nav id="navMenu">
        <ul>
            <li><a href="{{ path('app_landing') }}#Home">Home</a></li>
            <li><a href="{{ path('app_about') }}">About Us</a></li>
            <li><a href="{{ path('app_landing') }}#experiences">Share Wall</a></li>
            <li><a href="{{ path('app_landing') }}#services">Services</a></li>
            <li><a href="{{ path('app_landing') }}#member">Member Benefits</a></li>
            <li><a href="{{ path('app_contact') }}" class="nav-active">Contact Us</a></li>
            <li><a href="{{ path('app_login') }}" class="signin-btn">Sign In</a></li>
        </ul>
    </nav>
</header>

{# ══════════════════════════════════════════════════════════════════════════════
   PAGE HERO
══════════════════════════════════════════════════════════════════════════════ #}
<section class="page-hero">
    <div class="breadcrumb">
        <a href="{{ path('app_landing') }}"><i class="fas fa-home"></i> Home</a>
        <i class="fas fa-chevron-right"></i>
        <span>Contact Us</span>
    </div>
    <h1>Get In <span>Touch</span></h1>
    <p>We'd love to hear from you. Send us a message and we'll respond as soon as possible.</p>
</section>

{# ══════════════════════════════════════════════════════════════════════════════
   CONTACT MAIN
══════════════════════════════════════════════════════════════════════════════ #}
<section class="section-pad contact-main">
    <div class="contact-grid">

        {# ── Left: Info ── #}
        <div class="contact-info-col">
