<script>
document.addEventListener('DOMContentLoaded', function() {
    var navbar     = document.getElementById('navbar'),
        menuToggle = document.getElementById('menuToggle'),
        navMenu    = document.getElementById('navMenu');

    window.addEventListener('scroll', function() {
        navbar.classList.toggle('scrolled', window.scrollY > 50);
    });

    menuToggle.addEventListener('click', function() {
        navMenu.classList.toggle('active');
        menuToggle.classList.toggle('active');
    });

    document.querySelectorAll('.navbar ul li a').forEach(function(l) {
        l.addEventListener('click', function() {
            navMenu.classList.remove('active');
            menuToggle.classList.remove('active');
        });
    });

    /* ── FAQ accordion ── */
    document.querySelectorAll('.faq-question').forEach(function(q) {
        q.addEventListener('click', function() {
            var item    = this.parentElement;
            var wasOpen = item.classList.contains('open');
            document.querySelectorAll('.faq-item').forEach(function(i) { i.classList.remove('open'); });
            if (!wasOpen) item.classList.add('open');
        });
    });

    /* ── Scroll animations ── */
    var observer = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry, i) {
            if (entry.isIntersecting) {
                setTimeout(function() {
                    entry.target.style.opacity = '1';
                    entry.target.style.transform = 'translateY(0)';
                }, i * 80);
            }
        });
    }, { threshold: .1, rootMargin: '0px 0px -50px 0px' });

    document.querySelectorAll('.c-detail, .faq-item, .contact-form-col, .map-wrap').forEach(function(el, i) {
        el.style.opacity = '0';
        el.style.transform = 'translateY(30px)';
        el.style.transition = 'opacity .6s ease ' + (i * .08) + 's, transform .6s ease ' + (i * .08) + 's';
        observer.observe(el);
    });

    /* ── Other subject toggle ── */
    var subjectSel   = document.getElementById('contact_message_subject');
    var otherGroup   = document.getElementById('otherSubjectGroup');
    var otherInput   = otherGroup ? otherGroup.querySelector('input') : null;
    function toggleOther() {
        if (!subjectSel || !otherGroup) return;
        var isOther = subjectSel.value === 'Other';
        otherGroup.style.display = isOther ? 'flex' : 'none';
        otherGroup.style.flexDirection = 'column';
        if (otherInput) otherInput.required = isOther;
    }
    if (subjectSel) {
        subjectSel.addEventListener('change', toggleOther);
        toggleOther(); // restore state on back/validation error
    }

    /* ── Submit button loading state ── */
    var form = document.getElementById('contactForm');
    if (form) {
        form.addEventListener('submit', function() {
            var btn = document.getElementById('submitBtn');
            if (btn) {
                btn.disabled = true;
                btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Sending...';
            }
        });
    }
});
</script>
