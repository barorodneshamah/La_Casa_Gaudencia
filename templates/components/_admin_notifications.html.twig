{# Admin/Staff notification bell – injected into .topbar-right on every page #}
{% if app.user and is_granted('ROLE_STAFF') %}

<style>
.notif-bell-btn {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    background: rgba(255,255,255,0.15);
    border: none;
    border-radius: 12px;
    color: white;
    font-size: 18px;
    cursor: pointer;
    transition: background .25s;
    margin-right: 8px;
}
.notif-bell-btn:hover { background: rgba(255,255,255,0.28); }
.notif-bell-badge {
    position: absolute;
    top: 4px; right: 4px;
    min-width: 17px; height: 17px;
    background: #ef4444;
    border-radius: 999px;
    border: 2px solid transparent;
    display: flex; align-items: center; justify-content: center;
    font-size: 9px; font-weight: 800; color: #fff;
    padding: 0 3px;
    line-height: 1;
}
#notifGlobalDropdown {
    display: none;
    position: fixed;
    top: 70px;
    right: 20px;
    width: 320px;
    background: white;
    border-radius: 14px;
    box-shadow: 0 8px 32px rgba(0,0,0,.18);
    z-index: 9000;
    overflow: hidden;
}
#notifGlobalToastContainer {
    position: fixed;
    top: 80px;
    right: 24px;
    z-index: 9999;
    display: flex;
    flex-direction: column;
    gap: 10px;
    pointer-events: none;
}
#notifGlobalToastContainer > * { pointer-events: auto; }
</style>

<!-- Booking Bell Wrapper (JS injects into .topbar-right) -->
<div id="notifGlobalBellWrap" style="position:relative;display:none;">
    <button class="notif-bell-btn" id="notifGlobalBellBtn" title="Booking Alerts" onclick="toggleGlobalNotifDropdown()">
        <i class="fas fa-calendar-check"></i>
        <span class="notif-bell-badge" id="notifGlobalBadge" style="display:none;">0</span>
    </button>
</div>

<!-- Notification Dropdown (appended to body, positioned fixed) -->
<div id="notifGlobalDropdown">
    <div style="padding:14px 18px;background:#c24a16;color:white;font-weight:700;font-size:14px;display:flex;justify-content:space-between;align-items:center;">
        <span><i class="fas fa-calendar-check"></i> Booking Alerts</span>
        <button onclick="clearGlobalNotifBadge()" style="background:rgba(255,255,255,.2);border:none;color:white;border-radius:6px;padding:3px 8px;font-size:12px;cursor:pointer;">Clear</button>
    </div>
    <div id="notifGlobalList" style="max-height:300px;overflow-y:auto;padding:8px 0;">
        <div style="padding:20px;text-align:center;color:#aaa;font-size:13px;">No new alerts</div>
    </div>
</div>

<!-- Toast Container -->
<div id="notifGlobalToastContainer"></div>

<script>
(function() {
    // Move bell into .topbar-right on DOMContentLoaded
    function mountBell() {
        const topbarRight = document.querySelector('.topbar-right');
        const wrap = document.getElementById('notifGlobalBellWrap');
        if (!topbarRight || !wrap) return;

        // Avoid double-mount if already a child of topbar-right
        if (topbarRight.contains(wrap)) { wrap.style.display = ''; return; }

        // Insert before the first child (datetime-display)
        topbarRight.insertBefore(wrap, topbarRight.firstChild);
        wrap.style.display = '';
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', mountBell);
    } else {
        mountBell();
    }

    // ── Polling ────────────────────────────────────────────────────────────
    let lastChecked = Math.floor(Date.now() / 1000) - 300;
    let storedNotifs = [];

    function showNotifToast(msg, detail, url, type) {
        const icon  = type === 'reservation' ? 'fa-calendar-check' : 'fa-money-bill-wave';
        const color = type === 'reservation' ? '#7b1fa2' : '#2e7d32';
        const t = document.createElement('div');
        t.style.cssText = `background:white;border-radius:12px;box-shadow:0 4px 24px rgba(0,0,0,.18);
            padding:14px 18px;min-width:280px;max-width:340px;border-left:4px solid ${color};
            display:flex;gap:12px;align-items:flex-start;cursor:pointer;transition:opacity .5s;`;
        t.innerHTML = `<i class="fas ${icon}" style="color:${color};margin-top:2px;font-size:18px;"></i>
            <div><div style="font-weight:700;font-size:14px;color:#222;">${msg}</div>
            <div style="font-size:12px;color:#777;margin-top:3px;">${detail}</div></div>`;
        t.onclick = () => { window.location.href = url; };
        document.getElementById('notifGlobalToastContainer').prepend(t);
        setTimeout(() => { t.style.opacity = '0'; }, 5000);
        setTimeout(() => t.remove(), 5500);
    }

    function renderGlobalDropdown(notifs) {
        const list = document.getElementById('notifGlobalList');
        if (!list) return;
        if (!notifs.length) {
            list.innerHTML = '<div style="padding:20px;text-align:center;color:#aaa;font-size:13px;">No new alerts</div>';
            return;
        }
        list.innerHTML = notifs.map(n => {
            const icon  = n.type === 'reservation' ? 'fa-calendar-check' : 'fa-money-bill-wave';
            const color = n.type === 'reservation' ? '#7b1fa2' : '#2e7d32';
            return `<a href="${n.url}" style="display:flex;gap:12px;padding:12px 18px;text-decoration:none;color:inherit;border-bottom:1px solid #f5f5f5;">
                <i class="fas ${icon}" style="color:${color};margin-top:2px;"></i>
                <div><div style="font-weight:600;font-size:13px;">${n.message}</div>
                <div style="font-size:11px;color:#999;">${n.detail} · ${n.time}</div></div></a>`;
        }).join('');
    }

    function updateGlobalBadge(count) {
        const badge = document.getElementById('notifGlobalBadge');
        if (!badge) return;
        if (count > 0) {
            badge.textContent = count > 9 ? '9+' : count;
            badge.style.display = '';
        } else {
            badge.style.display = 'none';
        }
    }

    async function pollAdminNotifs() {
        try {
            const res = await fetch(`/admin/notifications/pending?since=${lastChecked}`, { credentials: 'same-origin' });
            if (!res.ok) return;
            const data = await res.json();
            if (data.count > 0) {
                data.notifications.forEach(n => showNotifToast(n.message, n.detail, n.url, n.type));
                storedNotifs = [...data.notifications, ...storedNotifs].slice(0, 20);
                renderGlobalDropdown(storedNotifs);
                updateGlobalBadge(storedNotifs.length);
            }
            lastChecked = data.checkedAt;
        } catch(e) {}
    }

    window.toggleGlobalNotifDropdown = function() {
        const d = document.getElementById('notifGlobalDropdown');
        if (!d) return;
        d.style.display = d.style.display === 'none' ? 'block' : 'none';
        renderGlobalDropdown(storedNotifs);
    };

    window.clearGlobalNotifBadge = function() {
        storedNotifs = [];
        updateGlobalBadge(0);
        renderGlobalDropdown([]);
    };

    document.addEventListener('click', function(e) {
        const wrap = document.getElementById('notifGlobalBellWrap');
        const drop = document.getElementById('notifGlobalDropdown');
        if (drop && wrap && !wrap.contains(e.target) && !drop.contains(e.target)) {
            drop.style.display = 'none';
        }
    });

    pollAdminNotifs();
    setInterval(pollAdminNotifs, 30000);
})();
</script>

{% endif %}
