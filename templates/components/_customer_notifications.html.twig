{# Customer notification bell – only rendered for logged-in customers (not staff/admin) #}
{% if app.user and is_granted('ROLE_USER') and not is_granted('ROLE_STAFF') %}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<style>
.cust-notif-btn {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    background: #fef0e8;
    border: none;
    border-radius: 10px;
    color: #c24a16;
    font-size: 16px;
    cursor: pointer;
    transition: background .2s;
    margin-right: 4px;
}
.cust-notif-btn:hover { background: #fde0cc; }
.cust-notif-badge {
    position: absolute;
    top: 3px; right: 3px;
    min-width: 16px; height: 16px;
    background: #ef4444;
    border-radius: 999px;
    display: flex; align-items: center; justify-content: center;
    font-size: 9px; font-weight: 800; color: #fff;
    padding: 0 3px;
    line-height: 1;
}
/* Floating fallback */
.cust-notif-floating {
    position: fixed;
    bottom: 24px;
    right: 24px;
    width: 52px;
    height: 52px;
    background: #c24a16;
    border: none;
    border-radius: 50%;
    color: white;
    font-size: 20px;
    cursor: pointer;
    box-shadow: 0 4px 16px rgba(194,74,22,.4);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 8999;
    transition: transform .2s;
}
.cust-notif-floating:hover { transform: scale(1.1); }
.cust-notif-floating .cust-notif-badge {
    border: 2px solid #c24a16;
}
#custNotifDropdown {
    display: none;
    position: fixed;
    top: 68px;
    right: 20px;
    width: 320px;
    background: white;
    border-radius: 14px;
    box-shadow: 0 8px 32px rgba(0,0,0,.18);
    z-index: 9000;
    overflow: hidden;
}
#custNotifDropdown.from-float {
    top: auto;
    bottom: 88px;
    right: 20px;
}
#custNotifToastContainer {
    position: fixed;
    top: 80px;
    right: 24px;
    z-index: 9999;
    display: flex;
    flex-direction: column;
    gap: 10px;
    pointer-events: none;
}
#custNotifToastContainer > * { pointer-events: auto; }
</style>

<div id="custNotifBellWrap" style="position:relative;display:none;">
    <button class="cust-notif-btn" id="custNotifBellBtn" title="My Notifications" onclick="toggleCustNotifDropdown()">
        <i class="fas fa-bell"></i>
        <span class="cust-notif-badge" id="custNotifBadge" style="display:none;">0</span>
    </button>
</div>

<div id="custNotifDropdown">
    <div style="padding:14px 18px;background:#c24a16;color:white;font-weight:700;font-size:14px;display:flex;justify-content:space-between;align-items:center;">
        <span><i class="fas fa-bell"></i> My Updates</span>
        <button onclick="clearCustNotifBadge()" style="background:rgba(255,255,255,.2);border:none;color:white;border-radius:6px;padding:3px 8px;font-size:12px;cursor:pointer;">Clear</button>
    </div>
    <div id="custNotifList" style="max-height:320px;overflow-y:auto;padding:8px 0;">
        <div style="padding:20px;text-align:center;color:#aaa;font-size:13px;">No new updates</div>
    </div>
</div>

<div id="custNotifToastContainer"></div>

<script>
(function() {
    const STATUS_COLORS = {
        CONFIRMED: '#2e7d32',
        APPROVED:  '#2e7d32',
        CANCELLED: '#c62828',
        REJECTED:  '#c62828',
        VOID:      '#c62828',
        REFUNDED:  '#1565c0',
        PENDING:   '#e65100',
        COMPLETED: '#1565c0',
    };

    function mountCustBell() {
        const nav  = document.querySelector('.topnav-links');
        const wrap = document.getElementById('custNotifBellWrap');
        if (!wrap) return;

        if (nav) {
            if (nav.contains(wrap)) { wrap.style.display = ''; return; }
            nav.insertBefore(wrap, nav.firstChild);
            wrap.style.display = '';
        } else {
            // Floating fallback for pages without .topnav-links
            const btn = document.createElement('button');
            btn.className = 'cust-notif-floating';
            btn.id = 'custFloatBtn';
            btn.title = 'My Notifications';
            btn.onclick = toggleCustNotifDropdown;
            btn.innerHTML = '<i class="fas fa-bell"></i><span class="cust-notif-badge" id="custNotifBadge" style="display:none;">0</span>';
            document.body.appendChild(btn);
            document.getElementById('custNotifDropdown').classList.add('from-float');
        }
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', mountCustBell);
    } else {
        mountCustBell();
    }

    const LS_KEY_TS   = 'custNotifLastChecked';
    const LS_KEY_LIST = 'custNotifStored';
    const LS_KEY_SEEN = 'custNotifSeenIds';
    let lastChecked   = parseInt(localStorage.getItem(LS_KEY_TS) || '0', 10) || Math.floor(Date.now() / 1000);
    let stored        = JSON.parse(localStorage.getItem(LS_KEY_LIST) || '[]');
    // seenIds prevents the same update from re-toasting on repeat polls
    let seenIds       = new Set(JSON.parse(localStorage.getItem(LS_KEY_SEEN) || '[]'));

    function saveSeen() {
        let arr = [...seenIds];
        if (arr.length > 300) arr = arr.slice(arr.length - 300);
        seenIds = new Set(arr);
        localStorage.setItem(LS_KEY_SEEN, JSON.stringify(arr));
    }

    function showCustToast(msg, detail, url, status) {
        const color = STATUS_COLORS[status] || '#c24a16';
        const icon  = status === 'APPROVED' || status === 'CONFIRMED' ? 'fa-check-circle'
                    : status === 'REJECTED' || status === 'CANCELLED' ? 'fa-times-circle'
                    : 'fa-bell';
        const t = document.createElement('div');
        t.style.cssText = `background:white;border-radius:12px;box-shadow:0 4px 24px rgba(0,0,0,.18);
            padding:14px 18px;min-width:270px;max-width:320px;border-left:4px solid ${color};
            display:flex;gap:12px;align-items:flex-start;cursor:pointer;transition:opacity .5s;`;
        t.innerHTML = `<i class="fas ${icon}" style="color:${color};margin-top:2px;font-size:16px;flex-shrink:0;"></i>
            <div><div style="font-weight:700;font-size:13px;color:#222;">${msg}</div>
            <div style="font-size:12px;color:#777;margin-top:3px;">${detail}</div></div>`;
        t.onclick = () => { window.location.href = url; };
        document.getElementById('custNotifToastContainer').prepend(t);
        setTimeout(() => { t.style.opacity = '0'; }, 5000);
        setTimeout(() => t.remove(), 5500);
    }

    function renderCustDropdown(notifs) {
        const list = document.getElementById('custNotifList');
        if (!list) return;
        if (!notifs.length) {
            list.innerHTML = '<div style="padding:20px;text-align:center;color:#aaa;font-size:13px;">No new updates</div>';
            return;
        }
        // Unread items float to the top
        const sorted = [...notifs].sort((a, b) => (b.unread ? 1 : 0) - (a.unread ? 1 : 0));
        list.innerHTML = sorted.map(n => {
            const color    = STATUS_COLORS[n.status] || '#c24a16';
            const icon     = n.type === 'payment' ? 'fa-money-bill-wave' : 'fa-calendar-check';
            const rowBg    = n.unread ? `background:#fff8f6;border-left:3px solid ${color};` : '';
            const titleW   = n.unread ? '700' : '500';
            const dotHtml  = n.unread ? `<span style="display:inline-block;width:7px;height:7px;border-radius:50%;background:${color};margin-left:5px;vertical-align:middle;flex-shrink:0;"></span>` : '';
            return `<a href="${n.url}" style="display:flex;gap:12px;padding:12px 18px;text-decoration:none;color:inherit;border-bottom:1px solid #f5f5f5;align-items:flex-start;${rowBg}">
                <i class="fas ${icon}" style="color:${color};margin-top:3px;flex-shrink:0;"></i>
                <div style="flex:1;min-width:0;">
                    <div style="display:flex;align-items:center;gap:0;">
                        <span style="font-weight:${titleW};font-size:13px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${n.message}</span>${dotHtml}
                    </div>
                    <div style="font-size:11px;color:#999;margin-top:2px;">${n.detail} · ${n.time}</div>
                </div></a>`;
        }).join('');
    }

    function updateCustBadge(count) {
        document.querySelectorAll('#custNotifBadge').forEach(badge => {
            if (count > 0) {
                badge.textContent = count > 9 ? '9+' : count;
                badge.style.display = '';
            } else {
                badge.style.display = 'none';
            }
        });
    }

    async function pollCustNotifs() {
        try {
            const res = await fetch(`/customer/notifications/updates?since=${lastChecked}`, { credentials: 'same-origin' });
            if (!res.ok) return;
            const data = await res.json();

            // Filter to only notifications not yet shown as toasts
            const fresh = (data.notifications || []).filter(n => !seenIds.has(n.type + ':' + n.id));

            if (fresh.length > 0) {
                fresh.forEach(n => showCustToast(n.message, n.detail, n.url, n.status));
                fresh.forEach(n => seenIds.add(n.type + ':' + n.id));
                saveSeen();

                // Merge into dropdown list without duplicates, flagged as unread
                const existingKeys = new Set(stored.map(n => n.type + ':' + n.id));
                const toAdd = fresh
                    .filter(n => !existingKeys.has(n.type + ':' + n.id))
                    .map(n => ({ ...n, unread: true }));
                if (toAdd.length) {
                    stored = [...toAdd, ...stored].slice(0, 20);
                    localStorage.setItem(LS_KEY_LIST, JSON.stringify(stored));
                    renderCustDropdown(stored);
                    updateCustBadge(stored.length);
                }
            }

            lastChecked = data.checkedAt;
            localStorage.setItem(LS_KEY_TS, String(lastChecked));
        } catch(e) {}
    }

    window.toggleCustNotifDropdown = function() {
        const d = document.getElementById('custNotifDropdown');
        if (!d) return;
        if (d.style.display !== 'block') {
            d.style.display = 'block';
            // Mark all as read the moment the user opens the dropdown
            stored = stored.map(n => ({ ...n, unread: false }));
            localStorage.setItem(LS_KEY_LIST, JSON.stringify(stored));
            renderCustDropdown(stored);
        } else {
            d.style.display = 'none';
        }
    };

    window.clearCustNotifBadge = function() {
        stored = [];
        localStorage.setItem(LS_KEY_LIST, '[]');
        updateCustBadge(0);
        renderCustDropdown([]);
    };

    document.addEventListener('click', function(e) {
        const wrap = document.getElementById('custNotifBellWrap');
        const flt  = document.getElementById('custFloatBtn');
        const drop = document.getElementById('custNotifDropdown');
        const inside = (wrap && wrap.contains(e.target)) || (flt && flt.contains(e.target)) || (drop && drop.contains(e.target));
        if (drop && !inside) drop.style.display = 'none';
    });

    // Restore badge from previous session immediately (before first poll)
    if (stored.length) updateCustBadge(stored.length);

    pollCustNotifs();
    setInterval(pollCustNotifs, 8000);
})();
</script>

{% endif %}
