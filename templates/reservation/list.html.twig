        </li>

    {% endif %}

    </ul>

    <div class="sidebar-logout">
        <a href="{{ path('app_logout') }}" class="logout-btn">
            <i class="fas fa-sign-out-alt"></i>
            Logout
        </a>
    </div>
</div>

<!-- TOPBAR -->
<div class="topbar">
    <div class="topbar-left">
        <i class="fas fa-calendar-check"></i>
        {{ serviceLabel }}
    </div>
    <div class="topbar-right">
        <div class="datetime-display">
            <div class="time">{{ "now"|date("H:i") }}</div>
            <div class="date">{{ "now"|date("M d, Y") }}</div>
        </div>
        <button class="profile-btn" onclick="toggleProfileMenu()">
            <div class="profile-avatar">{{ app.user.firstName|slice(0,1) }}{{ app.user.lastName|slice(0,1) }}</div>
            <div class="profile-info">
                <div class="profile-name">{{ app.user.firstName }} {{ app.user.lastName }}</div>
                <div class="profile-role">
                    {% if 'ROLE_ADMIN' in app.user.roles %}
                        Administrator
                    {% elseif 'ROLE_STAFF' in app.user.roles %}
                        Staff
                    {% endif %}
                </div>
            </div>
        </button>
    </div>
</div>

<!-- MOBILE OVERLAY -->
<div class="mobile-overlay" onclick="closeSidebar()"></div>

<!-- MAIN CONTENT -->
<div class="main-content">
<div class="container-fluid">
    {# Header #}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <a href="{{ path('reservation_index') }}" class="text-decoration-none text-muted">
                <i class="fas fa-arrow-left me-1"></i> Back
            </a>
            <h1 class="mt-2 mb-0">{{ serviceLabel }}</h1>
        </div>
        <a href="{{ path('reservation_new') }}" class="btn btn-primary">
            <i class="fas fa-plus me-1"></i> New
        </a>
    </div>

    {# Filters #}
    <div class="card mb-4">
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-4">
                    <select name="status" class="form-select">
                        <option value="">All Status</option>
                        <option value="PENDING" {{ app.request.query.get('status') == 'PENDING' ? 'selected' }}>Pending</option>
                        <option value="CONFIRMED" {{ app.request.query.get('status') == 'CONFIRMED' ? 'selected' }}>Confirmed</option>
                        <option value="CANCELLED" {{ app.request.query.get('status') == 'CANCELLED' ? 'selected' }}>Cancelled</option>
                        <option value="COMPLETED" {{ app.request.query.get('status') == 'COMPLETED' ? 'selected' }}>Completed</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <select name="paymentStatus" class="form-select">
                        <option value="">All Payment Status</option>
                        <option value="UNPAID" {{ app.request.query.get('paymentStatus') == 'UNPAID' ? 'selected' }}>Unpaid</option>
                        <option value="PARTIAL" {{ app.request.query.get('paymentStatus') == 'PARTIAL' ? 'selected' }}>Partial</option>
                        <option value="PAID" {{ app.request.query.get('paymentStatus') == 'PAID' ? 'selected' }}>Paid</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <button type="submit" class="btn btn-secondary">
                        <i class="fas fa-filter me-1"></i> Filter
                    </button>
                    <a href="{{ path('reservation_by_service', {type: serviceType}) }}" class="btn btn-outline-secondary">
                        Clear
                    </a>
                </div>
            </form>
        </div>
    </div>

    {# Table #}
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Reservation #</th>
                        <th>Guest</th>
                        <th>Service</th>
                        <th>Date</th>
                        <th>Amount</th>
                        <th>Status</th>
                        <th>Payment</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    {% for reservation in reservations %}
                    <tr>
                        <td>
                            <a href="{{ path('reservation_show', {id: reservation.id}) }}" class="fw-bold text-decoration-none">
                                {{ reservation.reservationNumber }}
                            </a>
                        </td>
                        <td>
                            {{ reservation.guest.fullName ?? reservation.guest.email }}
                        </td>
                        <td>{{ reservation.serviceName ?? '-' }}</td>
                        <td>
                            {{ reservation.checkInDate|date('M d, Y') }}
                            {% if reservation.checkOutDate %}
                                <br><small class="text-muted">to {{ reservation.checkOutDate|date('M d, Y') }}</small>
                            {% endif %}
                        </td>
                        <td>
                            <strong>₱{{ reservation.totalAmount|number_format(2) }}</strong>
                            {% if reservation.balanceDue > 0 %}
                                <br><small class="text-danger">Due: ₱{{ reservation.balanceDue|number_format(2) }}</small>
                            {% endif %}
                        </td>
                        <td>
                            <span class="badge bg-{{ reservation.statusBadge }}">
                                {{ reservation.status }}
                            </span>
                        </td>
                        <td>
                            <span class="badge bg-{{ reservation.paymentBadge }}">
                                {{ reservation.paymentStatus }}
                            </span>
                        </td>
                        <td>
                            <div class="btn-group btn-group-sm">
                                <a href="{{ path('reservation_show', {id: reservation.id}) }}" 
                                   class="btn btn-outline-primary" title="View">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <a href="{{ path('reservation_edit', {id: reservation.id}) }}" 
                                   class="btn btn-outline-secondary" title="Edit">
                                    <i class="fas fa-edit"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">
                            <i class="fas fa-inbox fa-3x mb-3 d-block"></i>
                            No reservations found
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    {# Count #}
    <div class="mt-3 text-muted">
        Showing {{ reservations|length }} reservation(s)
    </div>
</div>
</div>

{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
document.addEventListener('DOMContentLoaded', function() {
    
    // ===== DATE TIME =====
    function updateDateTime() {
        const now = new Date();
        const timeEls = document.querySelectorAll('.time');
        const dateEls = document.querySelectorAll('.date');
        
        timeEls.forEach(el => {
            el.textContent = now.toLocaleTimeString('en-US', { 
                hour: '2-digit', 
                minute: '2-digit', 
                hour12: true 
            });
        });
        
        dateEls.forEach(el => {
            el.textContent = now.toLocaleDateString('en-US', { 
                month: 'short', 
                day: 'numeric', 
                year: 'numeric' 
            });
        });
    }
    
    // Initial call
    updateDateTime();
    
    // Update every minute
    setInterval(updateDateTime, 60000);
});

// ===== MENU TOGGLE =====
function toggleProfileMenu() {
    // Simple implementation - could be expanded
    console.log('Profile menu toggle');
}
</script>
{% endblock %}